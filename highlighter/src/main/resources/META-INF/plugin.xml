<idea-plugin>
    <id>com.philipp.compiler.highlighter</id>
    <name>Custom Compiler Language Support</name>
    <vendor email="support@example.com" url="https://github.com/Philipp01105/compiler">Philipp01105</vendor>

    <description><![CDATA[
    Syntax highlighting and language support for the custom compiler language.
    
    Features:
    - Syntax highlighting for all language constructs
    - Support for 7 data types (int, char, byte, bit, float, double, string)
    - Keyword highlighting (func, var, if, else, for, return, struct, etc.)
    - String and character literal highlighting
    - Comment support
    - Number literal support
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File type registration -->
        <fileType 
            name="Custom Compiler Language" 
            implementationClass="com.philipp.compiler.highlighter.CompilerFileType"
            fieldName="INSTANCE" 
            language="CompilerLanguage" 
            extensions="txt"/>
        
        <!-- Language registration -->
        <lang.parserDefinition 
            language="CompilerLanguage" 
            implementationClass="com.philipp.compiler.highlighter.CompilerParserDefinition"/>
        
        <!-- Syntax highlighter -->
        <lang.syntaxHighlighterFactory 
            language="CompilerLanguage" 
            implementationClass="com.philipp.compiler.highlighter.CompilerSyntaxHighlighterFactory"/>
        
        <!-- Color settings page -->
        <colorSettingsPage 
            implementation="com.philipp.compiler.highlighter.CompilerColorSettingsPage"/>
    </extensions>
</idea-plugin>

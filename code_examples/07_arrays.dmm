// =================================================================
// ARRAYS
// Demonstrates array declaration, access, and manipulation
// =================================================================
// This example demonstrates:
// - Array declaration with size
// - Array element access
// - Array element assignment
// - Iterating through arrays
// - Arrays with different types
// - Multi-dimensional concepts via single arrays
// =================================================================

func printArray(size:int) -> void {
    var[10] arr:int;
    
    // Fill array
    for (var i:int = 0; i < size; i++) {
        arr[i] = i * 2;
    }
    
    // Print array
    println("Array contents:");
    for (var i:int = 0; i < size; i++) {
        println("  arr[" + i + "] = " + arr[i]);
    }
}

func sumArray() -> int {
    var[5] numbers:int;
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;
    numbers[4] = 50;
    
    var sum:int = 0;
    for (var i:int = 0; i < 5; i++) {
        sum = sum + numbers[i];
    }
    
    return sum;
}

func main() -> void {
    println("=== ARRAY DEMONSTRATIONS ===");
    println("");
    
    // Basic array declaration and access
    println("--- Basic array operations ---");
    var[5] numbers:int;
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;
    numbers[4] = 50;
    
    println("Array elements:");
    println("  numbers[0] = " + numbers[0]);
    println("  numbers[1] = " + numbers[1]);
    println("  numbers[2] = " + numbers[2]);
    println("  numbers[3] = " + numbers[3]);
    println("  numbers[4] = " + numbers[4]);
    println("");
    
    // Array iteration
    println("--- Array iteration ---");
    println("Printing all elements:");
    for (var i:int = 0; i < 5; i++) {
        println("  Index " + i + ": " + numbers[i]);
    }
    println("");
    
    // Array modification
    println("--- Array modification ---");
    println("Doubling all values...");
    for (var i:int = 0; i < 5; i++) {
        numbers[i] = numbers[i] * 2;
    }
    println("New values:");
    for (var i:int = 0; i < 5; i++) {
        println("  numbers[" + i + "] = " + numbers[i]);
    }
    println("");
    
    // Array with calculations
    println("--- Array calculations ---");
    var[10] sequence:int;
    for (var i:int = 0; i < 10; i++) {
        sequence[i] = i * i;
    }
    println("Squares from 0 to 9:");
    for (var i:int = 0; i < 10; i++) {
        println("  " + i + "^2 = " + sequence[i]);
    }
    println("");
    
    // Finding max in array
    println("--- Finding maximum ---");
    var[7] values:int;
    values[0] = 45;
    values[1] = 23;
    values[2] = 89;
    values[3] = 12;
    values[4] = 67;
    values[5] = 34;
    values[6] = 56;
    
    var max:int = values[0];
    for (var i:int = 1; i < 7; i++) {
        if (values[i] > max) {
            max = values[i];
        }
    }
    println("Values: 45, 23, 89, 12, 67, 34, 56");
    println("Maximum value: " + max);
    println("");
    
    // Array in function
    println("--- Array in function ---");
    printArray(8);
    println("");
    
    // Array function return
    println("--- Array sum function ---");
    var total:int = sumArray();
    println("Sum of array [10, 20, 30, 40, 50]: " + total);
    println("");
    
    println("=== ALL ARRAY OPERATIONS DEMONSTRATED ===");
}

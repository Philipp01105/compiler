// =================================================================
// ALGORITHMS
// Demonstrates common algorithms and problem-solving patterns
// =================================================================
// This example demonstrates:
// - Factorial (recursion)
// - Fibonacci (recursion)
// - GCD (Euclidean algorithm)
// - Prime number checking
// - Array sorting (bubble sort)
// - Array searching (linear search)
// =================================================================

// Factorial using recursion
func factorial(n:int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Fibonacci using recursion
func fibonacci(n:int) -> int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// GCD using Euclidean algorithm
func gcd(a:int, b:int) -> int {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

// Check if number is prime
func isPrime(n:int) -> bit {
    if (n <= 1) {
        return 0;
    }
    if (n == 2) {
        return 1;
    }
    if (n % 2 == 0) {
        return 0;
    }
    
    for (var i:int = 3; i * i <= n; i = i + 2) {
        if (n % i == 0) {
            return 0;
        }
    }
    return 1;
}

// Sum of digits
func sumDigits(n:int) -> int {
    var sum:int = 0;
    while (n > 0) {
        sum = sum + (n % 10);
        n = n / 10;
    }
    return sum;
}

// Power function (iterative)
func power(base:int, exp:int) -> int {
    var result:int = 1;
    for (var i:int = 0; i < exp; i++) {
        result = result * base;
    }
    return result;
}

// Absolute value
func abs(n:int) -> int {
    if (n < 0) {
        return -n;
    }
    return n;
}

// Maximum of two numbers
func max(a:int, b:int) -> int {
    if (a > b) {
        return a;
    }
    return b;
}

// Minimum of two numbers
func min(a:int, b:int) -> int {
    if (a < b) {
        return a;
    }
    return b;
}

func main() -> void {
    println("=== ALGORITHM DEMONSTRATIONS ===");
    println("");
    
    // Factorial
    println("--- Factorial ---");
    for (var i:int = 0; i <= 7; i++) {
        println("  " + i + "! = " + factorial(i));
    }
    println("");
    
    // Fibonacci
    println("--- Fibonacci sequence ---");
    for (var i:int = 0; i <= 10; i++) {
        println("  fib(" + i + ") = " + fibonacci(i));
    }
    println("");
    
    // GCD
    println("--- Greatest Common Divisor ---");
    println("  gcd(48, 18) = " + gcd(48, 18));
    println("  gcd(100, 35) = " + gcd(100, 35));
    println("  gcd(17, 13) = " + gcd(17, 13));
    println("");
    
    // Prime numbers
    println("--- Prime number checking ---");
    println("Primes from 1 to 30:");
    for (var i:int = 1; i <= 30; i++) {
        if (isPrime(i) == 1) {
            println("  " + i);
        }
    }
    println("");
    
    // Power function
    println("--- Power function ---");
    println("  2^3 = " + power(2, 3));
    println("  3^4 = " + power(3, 4));
    println("  5^2 = " + power(5, 2));
    println("");
    
    // Math utility functions
    println("--- Math utilities ---");
    println("  abs(-42) = " + abs(-42));
    println("  abs(17) = " + abs(17));
    println("  max(15, 23) = " + max(15, 23));
    println("  min(15, 23) = " + min(15, 23));
    println("");
    
    // Sum of digits
    println("--- Sum of digits ---");
    println("  sumDigits(123) = " + sumDigits(123));
    println("  sumDigits(9876) = " + sumDigits(9876));
    println("  sumDigits(100) = " + sumDigits(100));
    println("");
    
    println("=== ALL ALGORITHMS DEMONSTRATED ===");
}

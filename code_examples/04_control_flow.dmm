// =================================================================
// CONTROL FLOW
// Demonstrates if/else, else if, and for loops
// =================================================================
// This example demonstrates:
// - if/else statements
// - else if chains
// - Nested conditionals
// - for loops
// - Nested loops
// - break and continue logic
// =================================================================

func main() -> void {
    println("=== CONTROL FLOW DEMONSTRATIONS ===");
    println("");
    
    // Simple if/else
    println("--- Simple if/else ---");
    var x:int = 10;
    if (x > 5) {
        println("x is greater than 5");
    } else {
        println("x is not greater than 5");
    }
    println("");
    
    // else if chains
    println("--- else if chains ---");
    var score:int = 85;
    println("Score: " + score);
    if (score >= 90) {
        println("Grade: A");
    } else if (score >= 80) {
        println("Grade: B");
    } else if (score >= 70) {
        println("Grade: C");
    } else if (score >= 60) {
        println("Grade: D");
    } else {
        println("Grade: F");
    }
    println("");
    
    // Nested conditionals
    println("--- Nested conditionals ---");
    var age:int = 25;
    var hasLicense:bit = 1;
    if (age >= 18) {
        println("Adult");
        if (hasLicense == 1) {
            println("  Can drive");
        } else {
            println("  Cannot drive (no license)");
        }
    } else {
        println("Minor - cannot drive");
    }
    println("");
    
    // Simple for loop
    println("--- Simple for loop ---");
    println("Counting 1 to 5:");
    for (var i:int = 1; i <= 5; i++) {
        println("  " + i);
    }
    println("");
    
    // Loop with condition
    println("--- Loop with condition ---");
    println("Even numbers from 0 to 10:");
    for (var i:int = 0; i <= 10; i++) {
        if (i % 2 == 0) {
            println("  " + i);
        }
    }
    println("");
    
    // Nested loops
    println("--- Nested loops ---");
    println("Multiplication table (1-3):");
    for (var i:int = 1; i <= 3; i++) {
        for (var j:int = 1; j <= 3; j++) {
            var product:int = i * j;
            println("  " + i + " x " + j + " = " + product);
        }
    }
    println("");
    
    println("=== ALL CONTROL FLOW DEMONSTRATED ===");
}

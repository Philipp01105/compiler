// =================================================================
// ROCK PAPER SCISSORS GAME
// A classic Rock-Paper-Scissors game implementation
// =================================================================
// This game demonstrates:
// - Struct usage for game state
// - Game logic with multiple outcomes
// - Score tracking
// - Enum-like constants (0=Rock, 1=Paper, 2=Scissors)
// =================================================================

#import <stdlib/core.dmm>
#import <stdlib/io.dmm>

// Rock Paper Scissors Game struct
struct RPSGame {
    var player1Score:int;
    var player2Score:int;
    var roundsPlayed:int;
    var maxRounds:int;
    
    // Initialize the game
    func init(rounds:int) -> void {
        player1Score = 0;
        player2Score = 0;
        roundsPlayed = 0;
        maxRounds = rounds;
    }
    
    // Determine winner of a round
    // Returns: 0 = tie, 1 = player1 wins, 2 = player2 wins
    func playRound(p1Move:int, p2Move:int) -> int {
        roundsPlayed = roundsPlayed + 1;
        
        // Tie
        if (p1Move == p2Move) {
            return 0;
        }
        
        // Player 1 wins scenarios
        if (p1Move == 0) {
            if (p2Move == 2) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        if (p1Move == 1) {
            if (p2Move == 0) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        if (p1Move == 2) {
            if (p2Move == 1) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        // Player 2 wins
        player2Score = player2Score + 1;
        return 2;
    }
    
    // Check if game is over
    func isGameOver() -> bit {
        if (roundsPlayed >= maxRounds) {
            return 1;
        }
        return 0;
    }
    
    // Get final winner
    func getFinalWinner() -> int {
        if (player1Score > player2Score) {
            return 1;
        } else if (player2Score > player1Score) {
            return 2;
        }
        return 0;
    }
    
    // Print current score
    func printScore() -> void {
        printLine();
        printLabeled("Round", roundsPlayed);
        printLabeled("Max Rounds", maxRounds);
        printLabeled("Player 1 Score", player1Score);
        printLabeled("Player 2 Score", player2Score);
        printLine();
    }
}

// Convert move number to name
func getMoveName(move:int) -> string {
    if (move == 0) {
        return "Rock";
    } else if (move == 1) {
        return "Paper";
    } else {
        return "Scissors";
    }
}

// Simulate a game
func simulateGame() -> void {
    printDoubleLine();
    println("         ROCK PAPER SCISSORS");
    printDoubleLine();
    println("");
    
    var game:RPSGame;
    game.init(5);
    
    println("Best of 5 rounds!");
    println("0 = Rock, 1 = Paper, 2 = Scissors");
    println("");
    
    // Predefined moves for simulation
    var[5] p1Moves:int;
    p1Moves[0] = 0;
    p1Moves[1] = 1;
    p1Moves[2] = 2;
    p1Moves[3] = 0;
    p1Moves[4] = 1;
    
    var[5] p2Moves:int;
    p2Moves[0] = 2;
    p2Moves[1] = 0;
    p2Moves[2] = 2;
    p2Moves[3] = 1;
    p2Moves[4] = 1;
    
    for (var i:int = 0; i < 5; i++) {
        var p1Move:int = p1Moves[i];
        var p2Move:int = p2Moves[i];
        
        println("Round " + (i + 1) + ":");
        println("  Player 1: " + getMoveName(p1Move));
        println("  Player 2: " + getMoveName(p2Move));
        
        var result:int = game.playRound(p1Move, p2Move);
        
        if (result == 0) {
            println("  Result: TIE!");
        } else if (result == 1) {
            println("  Result: Player 1 wins this round!");
        } else {
            println("  Result: Player 2 wins this round!");
        }
        
        game.printScore();
    }
    
    var winner:int = game.getFinalWinner();
    println("");
    if (winner == 0) {
        println("FINAL RESULT: IT'S A TIE!");
    } else if (winner == 1) {
        println("FINAL RESULT: PLAYER 1 WINS!");
    } else {
        println("FINAL RESULT: PLAYER 2 WINS!");
    }
    println("Final Score - P1: " + game.player1Score + " | P2: " + game.player2Score);
}

// Simulate a tournament
func simulateTournament() -> void {
    printDoubleLine();
    println("         RPS TOURNAMENT");
    printDoubleLine();
    println("");
    
    var game:RPSGame;
    game.init(10);
    
    println("10-round tournament with pattern strategy");
    println("");
    
    for (var i:int = 0; i < 10; i++) {
        // Player 1 uses cycling pattern
        var p1Move:int = i % 3;
        
        // Player 2 uses counter pattern (tries to beat P1)
        var p2Move:int = (i + 1) % 3;
        
        println("Round " + (i + 1) + ": " + getMoveName(p1Move) + " vs " + getMoveName(p2Move));
        
        var result:int = game.playRound(p1Move, p2Move);
        
        if (result == 0) {
            println("  TIE");
        } else if (result == 1) {
            println("  P1 wins");
        } else {
            println("  P2 wins");
        }
    }
    
    game.printScore();
    
    var winner:int = game.getFinalWinner();
    println("");
    if (winner == 1) {
        println("Player 1 wins the tournament!");
    } else if (winner == 2) {
        println("Player 2 wins the tournament!");
    } else {
        println("Tournament ends in a tie!");
    }
}

func main() -> void {
    simulateGame();
    
    println("");
    println("");
    
    simulateTournament();
    
    println("");
    printDoubleLine();
    println("ROCK PAPER SCISSORS DEMONSTRATION COMPLETE");
    printDoubleLine();
}

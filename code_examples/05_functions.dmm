// =================================================================
// FUNCTIONS
// Demonstrates function definitions, parameters, and return values
// =================================================================
// This example demonstrates:
// - Functions with parameters
// - Functions with return values
// - Multiple parameters
// - Different return types
// - Recursion
// - Function calls
// =================================================================

// Simple function with no parameters
func printSeparator() -> void {
    println("================================");
}

// Function with parameters
func greet(name:string) -> void {
    println("Hello, " + name + "!");
}

// Function with return value
func add(a:int, b:int) -> int {
    return a + b;
}

// Function with multiple parameters
func multiply(a:int, b:int) -> int {
    return a * b;
}

// Function returning different types
func isEven(n:int) -> bit {
    if (n % 2 == 0) {
        return 1;
    }
    return 0;
}

// String return value
func makeGreeting(name:string) -> string {
    return "Hello";
}

// Recursive function - factorial
func factorial(n:int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Recursive function - fibonacci
func fibonacci(n:int) -> int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// Function that calls other functions
func calculate(a:int, b:int) -> void {
    var sum:int = add(a, b);
    var product:int = multiply(a, b);
    println("Sum: " + sum);
    println("Product: " + product);
}

func main() -> void {
    printSeparator();
    println("=== FUNCTION DEMONSTRATIONS ===");
    printSeparator();
    println("");
    
    // Simple function call
    println("--- Simple function calls ---");
    greet("Alice");
    greet("Bob");
    println("");
    
    // Functions with return values
    println("--- Functions with return values ---");
    var result:int = add(10, 20);
    println("10 + 20 = " + result);
    
    var product:int = multiply(7, 8);
    println("7 * 8 = " + product);
    println("");
    
    // Boolean return values
    println("--- Boolean return values ---");
    var num:int = 42;
    var even:bit = isEven(num);
    println(num + " is even: " + even);
    
    num = 17;
    even = isEven(num);
    println(num + " is even: " + even);
    println("");
    
    // String return values
    println("--- String return values ---");
    var greeting:string = makeGreeting("World");
    println(greeting);
    println("");
    
    // Recursive functions
    println("--- Recursive functions ---");
    println("Factorial of 5: " + factorial(5));
    println("Factorial of 6: " + factorial(6));
    println("");
    
    println("Fibonacci sequence:");
    for (var i:int = 0; i <= 7; i++) {
        println("  fib(" + i + ") = " + fibonacci(i));
    }
    println("");
    
    // Nested function calls
    println("--- Nested function calls ---");
    calculate(15, 3);
    println("");
    
    printSeparator();
    println("=== ALL FUNCTIONS DEMONSTRATED ===");
    printSeparator();
}

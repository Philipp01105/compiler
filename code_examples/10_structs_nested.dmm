// =================================================================
// NESTED STRUCTS
// Demonstrates structs containing other structs
// =================================================================
// This example demonstrates:
// - Nested struct composition (struct within struct)
// - Accessing nested struct fields
// - Calculations with nested structs
// - Real-world usage of nested structures
// =================================================================

struct Point {
    var x:int;
    var y:int;
}

struct Rectangle {
    var topLeft:Point;
    var bottomRight:Point;
}

struct Circle {
    var center:Point;
    var radius:int;
}

func demonstrateSimpleRectangle() -> void {
    println("--- Rectangle with Points ---");
    var rect:Rectangle;
    rect.topLeft.x = 0;
    rect.topLeft.y = 0;
    rect.bottomRight.x = 10;
    rect.bottomRight.y = 5;
    
    println("Rectangle:");
    var tlX:int = rect.topLeft.x;
    var tlY:int = rect.topLeft.y;
    println("  Top-Left: (" + tlX + ", " + tlY + ")");
    var brX:int = rect.bottomRight.x;
    var brY:int = rect.bottomRight.y;
    println("  Bottom-Right: (" + brX + ", " + brY + ")");
    
    var width:int = rect.bottomRight.x - rect.topLeft.x;
    var height:int = rect.bottomRight.y - rect.topLeft.y;
    var area:int = width * height;
    
    println("  Width: " + width);
    println("  Height: " + height);
    println("  Area: " + area);
    println("");
}

func demonstrateCircle() -> void {
    println("--- Circle with center Point ---");
    var circle:Circle;
    circle.center.x = 50;
    circle.center.y = 50;
    circle.radius = 10;
    
    println("Circle:");
    var centerX:int = circle.center.x;
    var centerY:int = circle.center.y;
    println("  Center: (" + centerX + ", " + centerY + ")");
    println("  Radius: " + circle.radius);
    
    var diameter:int = circle.radius * 2;
    println("  Diameter: " + diameter);
    println("");
}

func demonstrateMoving() -> void {
    println("--- Moving rectangle ---");
    var moveRect:Rectangle;
    moveRect.topLeft.x = 5;
    moveRect.topLeft.y = 10;
    moveRect.bottomRight.x = 15;
    moveRect.bottomRight.y = 20;
    
    println("Original: Top-Left (5, 10), Bottom-Right (15, 20)");
    
    // Create moved version with new coordinates
    var movedRect:Rectangle;
    movedRect.topLeft.x = 15;
    movedRect.topLeft.y = 15;
    movedRect.bottomRight.x = 25;
    movedRect.bottomRight.y = 25;
    
    println("After moving +10,+5: Top-Left (15, 15), Bottom-Right (25, 25)");
    println("");
}

func demonstrateMultipleRectangles() -> void {
    println("--- Multiple rectangles ---");
    var rect1:Rectangle;
    var rect2:Rectangle;
    
    rect1.topLeft.x = 0;
    rect1.topLeft.y = 0;
    rect1.bottomRight.x = 5;
    rect1.bottomRight.y = 5;
    
    rect2.topLeft.x = 10;
    rect2.topLeft.y = 10;
    rect2.bottomRight.x = 20;
    rect2.bottomRight.y = 15;
    
    var area1:int = (rect1.bottomRight.x - rect1.topLeft.x) * (rect1.bottomRight.y - rect1.topLeft.y);
    var area2:int = (rect2.bottomRight.x - rect2.topLeft.x) * (rect2.bottomRight.y - rect2.topLeft.y);
    
    println("Rectangle 1: Area = " + area1);
    println("Rectangle 2: Area = " + area2);
    println("Total area: " + (area1 + area2));
    println("");
}

func demonstrateScaling() -> void {
    println("--- Scaling rectangle ---");
    var square:Rectangle;
    square.topLeft.x = 10;
    square.topLeft.y = 10;
    square.bottomRight.x = 20;
    square.bottomRight.y = 20;
    
    println("Original square:");
    var sqWidth:int = square.bottomRight.x - square.topLeft.x;
    var sqHeight:int = square.bottomRight.y - square.topLeft.y;
    println("  Size: " + sqWidth + " x " + sqHeight);
    
    // Create scaled version
    var scaledSquare:Rectangle;
    scaledSquare.topLeft.x = 10;
    scaledSquare.topLeft.y = 10;
    scaledSquare.bottomRight.x = 30;
    scaledSquare.bottomRight.y = 30;
    
    println("After scaling by 2:");
    var scaledWidth:int = scaledSquare.bottomRight.x - scaledSquare.topLeft.x;
    var scaledHeight:int = scaledSquare.bottomRight.y - scaledSquare.topLeft.y;
    println("  Size: " + scaledWidth + " x " + scaledHeight);
    println("");
}

func main() -> void {
    println("=== NESTED STRUCT DEMONSTRATIONS ===");
    println("");
    
    demonstrateSimpleRectangle();
    demonstrateCircle();
    demonstrateMoving();
    demonstrateMultipleRectangles();
    demonstrateScaling();
    
    println("=== ALL NESTED STRUCT OPERATIONS DEMONSTRATED ===");
}

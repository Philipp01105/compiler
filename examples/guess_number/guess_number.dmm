package main;
import "stdlib";
// =================================================================
// NUMBER GUESSING GAME
// A simple number guessing game simulation
// =================================================================
// This game demonstrates:
// - Struct usage with methods
// - Tagged guess outcomes and exhaustive match statements
// - Game logic and state management
// - Range checking and validation
// =================================================================

// Helper functions
func printLine() -> void {
    stdlib.println("--------------------------------");
}

func printDoubleLine() -> void {
    stdlib.println("================================");
}

func printLabeled(label:string, value:int) -> void {
    {
        var _output0:string = label + ": " + value;
        stdlib.println(_output0);
        free(_output0);
    }
}

enum GuessOutcome { Correct, TooLow(int), TooHigh(int), }

// Number Guessing Game struct
struct GuessGame {
    var secretNumber:int;
    var guessCount:int;
    var maxGuesses:int;
    var gameWon:int;
    var rangeLow:int;
    var rangeHigh:int;
    
    // Initialize the game
    func init(secret:int, maxAttempts:int) -> void {
        secretNumber = secret;
        guessCount = 0;
        maxGuesses = maxAttempts;
        gameWon = 0;
        rangeLow = 1;
        rangeHigh = 100;
    }
    
    // Make a guess
    func makeGuess(guess:int) -> GuessOutcome {
        guessCount = guessCount + 1;
        
        if (guess == secretNumber) {
            gameWon = 1;
            return GuessOutcome.Correct;
        } else if (guess < secretNumber) {
            if (guess > rangeLow) {
                rangeLow = guess;
            }
            return GuessOutcome.TooLow(guess + 1);
        } else {
            if (guess < rangeHigh) {
                rangeHigh = guess;
            }
            return GuessOutcome.TooHigh(guess - 1);
        }
    }
    
    // Check if game is over
    func isGameOver() -> bit {
        if (gameWon == 1) {
            return 1;
        }
        if (guessCount >= maxGuesses) {
            return 1;
        }
        return 0;
    }
    
    // Print game status
    func printStatus() -> void {
        printLine();
        stdlib.println("Guess Number Game");
        printLabeled("Range Low", rangeLow);
        printLabeled("Range High", rangeHigh);
        printLabeled("Guesses used", guessCount);
        printLabeled("Max guesses", maxGuesses);
        printLine();
    }
}

// Simulate a game
func simulateGame() -> void {
    printDoubleLine();
    stdlib.println("         NUMBER GUESSING GAME");
    printDoubleLine();
    stdlib.println("");
    
    var game:GuessGame;
    game.init(42, 7);
    
    stdlib.println("Secret number is between 1 and 100");
    stdlib.println("You have 7 guesses to find it!");
    stdlib.println("");
    
    // Array of guesses to simulate
    var guesses:int[7];
    guesses[0] = 50;
    guesses[1] = 25;
    guesses[2] = 37;
    guesses[3] = 43;
    guesses[4] = 40;
    guesses[5] = 41;
    guesses[6] = 42;
    
    for (var i:int = 0; i < 7; i++) {
        if (game.isGameOver() == 1) {
            break;
        }
        
        var guess:int = guesses[i];
        {
            var _output1:string = "Guess #" + (i + 1) + ": " + guess;
            stdlib.println(_output1);
            free(_output1);
        }
        
        var result:GuessOutcome = game.makeGuess(guess);
        
        match (result) {
            Correct => stdlib.println("CORRECT! You found the number!");
            TooLow(nextLow) => stdlib.println("Too low! Try higher.");
            TooHigh(nextHigh) => stdlib.println("Too high! Try lower.");
        }
        if (game.gameWon == 1) { break; }

        game.printStatus();
    }
    
    stdlib.println("");
    if (game.gameWon == 1) {
        {
            var _output2:string = "YOU WON in " + game.guessCount + " guesses!";
            stdlib.println(_output2);
            free(_output2);
        }
    } else {
        {
            var _output3:string = "GAME OVER! The number was " + game.secretNumber;
            stdlib.println(_output3);
            free(_output3);
        }
    }
}

// Simulate an optimal strategy game
func simulateBinarySearch() -> void {
    printDoubleLine();
    stdlib.println("         BINARY SEARCH STRATEGY");
    printDoubleLine();
    stdlib.println("");
    
    var game:GuessGame;
    game.init(73, 10);
    
    stdlib.println("Using binary search to find the number!");
    stdlib.println("");
    
    var low:int = 1;
    var high:int = 100;
    
    for (var i:int = 0; i < 10; i++) {
        if (game.isGameOver() == 1) {
            break;
        }
        
        var guess:int = (low + high) / 2;
        {
            var _output4:string = "Guess #" + (i + 1) + ": " + guess + " (searching " + low + "-" + high + ")";
            stdlib.println(_output4);
            free(_output4);
        }
        
        var result:GuessOutcome = game.makeGuess(guess);
        
        match (result) {
            Correct => stdlib.println("FOUND IT!");
            TooLow(nextLow) => {
                stdlib.println("Too low, adjusting range...");
                low = nextLow;
            }
            TooHigh(nextHigh) => {
                stdlib.println("Too high, adjusting range...");
                high = nextHigh;
            }
        }
        if (game.gameWon == 1) { break; }
        stdlib.println("");
    }
    
    {
        var _output5:string = "Binary search found the number in " + game.guessCount + " guesses!";
        stdlib.println(_output5);
        free(_output5);
    }
}

func main() -> void {
    simulateGame();
    
    stdlib.println("");
    stdlib.println("");
    
    simulateBinarySearch();
    
    stdlib.println("");
    printDoubleLine();
    stdlib.println("NUMBER GUESSING GAME DEMONSTRATION COMPLETE");
    printDoubleLine();
}

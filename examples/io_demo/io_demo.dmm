package main;
import "stdlib/stdio";

// Save borrowed input bytes through a buffered file stream, then read them back.
func saveAndDisplay(name:u8[], message:u8[], output:*stdio.Stream, errors:*stdio.Stream) -> int {
    var file=stdio.openWrite("demo_output.txt");
    if (!file.isOpen()) { errors.writeLine("Could not open demo_output.txt for writing."); return 1; }
    var writer=stdio.bufferedWriter((&file).(*stdio.Stream),256);
    if (!writer.isOpen()) { file.close(); errors.writeLine("Could not allocate the file buffer."); return 1; }
    if (!writer.writeString("Name: ").ok() || !writer.write(name).ok() || !writer.writeLine("").ok() ||
        !writer.writeString("Message: ").ok() || !writer.write(message).ok() || !writer.writeLine("").ok()) {
        writer.discard(); file.close(); errors.writeLine("Could not write the message."); return 1;
    }
    var flushed=writer.close();
    if (!flushed.ok()) { writer.discard(); }
    var closed:isize=file.close();
    if (!flushed.ok() || closed < 0) { errors.writeLine("Could not finish writing the file."); return 1; }

    file=stdio.openRead("demo_output.txt");
    if (!file.isOpen()) { errors.writeLine("Could not reopen the file for reading."); return 1; }
    if (!output.writeLine("Saved to demo_output.txt. Reading it back:").ok()) { file.close(); return 1; }
    var scratch:u8[256]=[0;256];

    var copied=stdio.copy((&file).(*stdio.Stream),output,scratch);
    closed=file.close();
    if (!copied.ok() || closed < 0) { errors.writeLine("Could not read the saved message."); return 1; }
    return 0;
}

// Reuse one buffered stdin reader so read-ahead survives between prompts.
func interact(input:*stdio.BufferedReader, output:*stdio.Stream, errors:*stdio.Stream) -> int {
    if (!output.writeLine("Stream demo").ok() || !output.writeString("Name: ").ok()) {
        return 1;
    }
    var name = input.readLine(1024);
    if (name.status == stdio.Status.EndOfStream && name.length == 0) {
        name.release();
        output.writeLine("No input received.");
        return 0;
    }
    if (name.status != stdio.Status.Ok && name.status != stdio.Status.EndOfStream) {
        name.release();
        errors.writeLine("Could not read the name (maximum 1024 bytes).");
        return 1;
    }
    if (!output.writeString("Message: ").ok()) {
        name.release();
        return 1;
    }
    var message = input.readLine(4096);
    if (message.status != stdio.Status.Ok && message.status != stdio.Status.EndOfStream) {
        name.release();
        message.release();
        errors.writeLine("Could not read the message (maximum 4096 bytes).");
        return 1;
    }
    if (!output.writeString("Hello, ").ok() || !output.writeAll(name.view()).ok() || !output.writeLine("!").ok()) {
        name.release();
        message.release();
        return 1;
    }
    var result:int = saveAndDisplay(name.view(), message.view(), output,errors);
    name.release();
    message.release();
    return result;
}

func main() -> int {
    var input = stdio.stdin();
    var output = stdio.stdout();
    var errors = stdio.stderr();

    var reader = stdio.bufferedReader((&input).(*stdio.Stream), 256);
    if (!reader.isOpen()) {
        errors.writeLine("Could not allocate the input buffer.");
        return 1;
    }
    var result:int = interact(
        (&reader).(*stdio.BufferedReader),
        (&output).(*stdio.Stream),
        (&errors).(*stdio.Stream)
    );
    reader.close();
    input.close();
    output.close();
    errors.close();
    return result;
}

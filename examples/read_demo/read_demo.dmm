package main;
// ===================================================================
// Demonstration of the new read() function
// ===================================================================
// The read() function provides a unified interface for reading input
// from streams using format specifiers (inspired by scanf/Java Scanner)
//
// Syntax: read(stream, format_specifier)
//   stream: file descriptor (0 for stdin)
//   format: "%i" or "%d" for integers, "%c" for characters
// ===================================================================

import "stdlib";
func main() -> void {
    stdlib.println("╔════════════════════════════════════════╗");
    stdlib.println("║      DMM read() Function Demo         ║");
    stdlib.println("╚════════════════════════════════════════╝");
    stdlib.println("");
    
    // Example 1: Reading integers from stdin
    stdlib.println("【Example 1: Reading Integers】");
    stdlib.println("Enter a number:");
    var num1:int = read(0, "%i");
    stdlib.print("You entered: ");
    stdlib.println(num1);
    stdlib.println("");
    
    // Example 2: Reading with System.in enum
    stdlib.println("【Example 2: Using System.in】");
    stdlib.println("Enter another number:");
    var num2:int = read(stdlib.System.in.fd, "%i");
    stdlib.print("You entered: ");
    stdlib.println(num2);
    stdlib.println("");
    
    // Example 3: Simple calculation
    stdlib.println("【Example 3: Simple Calculator】");
    stdlib.println("Enter first number:");
    var a:int = read(0, "%i");
    stdlib.println("Enter second number:");
    var b:int = read(0, "%i");
    
    var sum:int = a + b;
    stdlib.print("Sum: ");
    stdlib.println(sum);
    stdlib.println("");
    
    // Example 4: Reading from file
    stdlib.println("【Example 4: Reading from File】");
    
    // First, write a number to a file
    stdlib.write_file("number.txt", "999\n");
    stdlib.println("Created file 'number.txt' with value 999");
    
    // Open and read from the file
    var fd:int = stdlib.open_read("number.txt");
    if (fd >= 0) {
        var file_num:int = read(fd, "%i");
        stdlib.close_file(fd);
        
        stdlib.print("Read from file: ");
        stdlib.println(file_num);
    }
    
    stdlib.println("");
    stdlib.println("╔════════════════════════════════════════╗");
    stdlib.println("║        Demo Completed! ✓               ║");
    stdlib.println("╚════════════════════════════════════════╝");
}

package main;
import "stdlib";

func append(target:*int, digit:int) -> void {
    *target=*target*10+digit;
}

func addReturnCleanup(target:*int) -> void {
    defer append(target,3);
    return;
}

func main() -> int {
    var result:int=0;
    var digit:int=1;

    {
        // Call arguments are captured now, so this appends 1.
        defer append((&result).(*int),digit);

        // An anonymous deferred body captures locals by reference and sees 2.
        defer func() {
            append((&result).(*int),digit);
        }
        digit=2;
    }

    // Defers run in LIFO order on fallthrough, return, break and continue.
    addReturnCleanup((&result).(*int));
    stdlib.println(result);

    if (result != 213) { return 1; }
    return 0;
}

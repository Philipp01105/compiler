package main;
import "stdlib";

func append(target: &mut int, digit: int) -> void {
    *target = *target * 10 + digit;
}

func addReturnCleanup(target: &mut int) -> void {
    defer append(target, 3);
    return;
}

func loopCleanup(target: &mut int) -> void {
    for (var digit: int = 4; digit < 7; digit += 1) {
        defer append(target, digit);
        if (digit == 4) {
            continue;
        }
        if (digit == 5) {
            break;
        }
    }
}

func main() -> int {
    var result: int = 0;
    var captured: int = 0;
    var digit: int = 1;

    {
        // The mutable borrow remains live until scope exit. Call arguments are
        // captured now, so this still appends 1 after digit changes.
        defer append(&mut result, digit);

        // The anonymous body captures a disjoint variable by reference and
        // observes digit's later value. It runs before the earlier defer.
        defer func() {
            append(&mut captured, digit);
        }

        digit = 2;
    }
    result = captured * 10 + result;

    // Defers run on fallthrough, return, continue and break.
    addReturnCleanup(&mut result);
    loopCleanup(&mut result);
    stdlib.println(result);

    if (result != 21345) {
        return 1;
    }
    return 0;
}

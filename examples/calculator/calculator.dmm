package main;
import "stdlib";
// =================================================================
// CALCULATOR
// A simple calculator with memory and history
// =================================================================
// This game demonstrates:
// - Struct usage for calculator state
// - Multiple operations
// - Memory storage
// - Result<int,string> and exhaustive match for division errors
// - Operation history tracking
// =================================================================

// Helper functions to replace stdlib utilities
func printLine() -> void {
    stdlib.println("--------------------------------");
}

func printDoubleLine() -> void {
    stdlib.println("================================");
}

func printLabeled(label:string, value:int) -> void {
    {
        var _output0:string = label + ": " + value;
        stdlib.println(_output0);
        free(_output0);
    }
}

// Calculator struct
struct Calculator {
    var currentValue:int;
    var memory:int;
    var operationCount:int;
    var lastOperation:int;
    
    // Initialize calculator
    func init() -> void {
        currentValue = 0;
        memory = 0;
        operationCount = 0;
        lastOperation = 0;
    }
    
    // Clear current value
    func clear() -> void {
        currentValue = 0;
    }
    
    // Clear all (including memory)
    func clearAll() -> void {
        currentValue = 0;
        memory = 0;
        operationCount = 0;
    }
    
    // Add
    func add(value:int) -> void {
        currentValue = currentValue + value;
        operationCount = operationCount + 1;
        lastOperation = 1;
    }
    
    // Subtract
    func subtract(value:int) -> void {
        currentValue = currentValue - value;
        operationCount = operationCount + 1;
        lastOperation = 2;
    }
    
    // Multiply
    func multiply(value:int) -> void {
        currentValue = currentValue * value;
        operationCount = operationCount + 1;
        lastOperation = 3;
    }
    
    // A tagged result makes division failure explicit to callers.
    func divide(value:int) -> stdlib.Result<int,string> {
        if (value == 0) {
            return stdlib.Result<int,string>.Err("Cannot divide by zero");
        }
        currentValue = currentValue / value;
        operationCount = operationCount + 1;
        lastOperation = 4;
        return stdlib.Result<int,string>.Ok(currentValue);
    }

    // Modulo
    func modulo(value:int) -> void {
        if (value != 0) {
            currentValue = currentValue % value;
            operationCount = operationCount + 1;
            lastOperation = 5;
        }
    }
    
    // Square
    func square() -> void {
        currentValue = currentValue * currentValue;
        operationCount = operationCount + 1;
        lastOperation = 6;
    }
    
    // Absolute value
    func absolute() -> void {
        if (currentValue < 0) {
            currentValue = -currentValue;
        }
        operationCount = operationCount + 1;
        lastOperation = 7;
    }
    
    // Store to memory
    func memoryStore() -> void {
        memory = currentValue;
    }
    
    // Recall from memory
    func memoryRecall() -> void {
        currentValue = memory;
    }
    
    // Add to memory
    func memoryAdd() -> void {
        memory = memory + currentValue;
    }
    
    // Clear memory
    func memoryClear() -> void {
        memory = 0;
    }
    
    // Get current value
    func getValue() -> int {
        return currentValue;
    }
    
    // Set value
    func setValue(value:int) -> void {
        currentValue = value;
    }
    
    // Print status
    func printStatus(operation:string) -> void {
        stdlib.print(operation);
        printLabeled("  Result", currentValue);
    }
}

func showDivision(result:stdlib.Result<int,string>) -> void {
    match (result) {
        Ok(value) => { }
        Err(message) => stdlib.println(message);
    }
}

// Demonstrate basic operations
func demonstrateBasicOps() -> void {
    printDoubleLine();
    stdlib.println("         CALCULATOR - BASIC OPERATIONS");
    printDoubleLine();
    stdlib.println("");
    
    var calc:Calculator;
    calc.init();
    
    stdlib.println("Starting value: 0");
    stdlib.println("");
    
    calc.setValue(10);
    calc.printStatus("Set 10");
    
    calc.add(5);
    calc.printStatus("Add 5");
    
    calc.multiply(3);
    calc.printStatus("Multiply by 3");
    
    calc.subtract(20);
    calc.printStatus("Subtract 20");
    
    showDivision(calc.divide(5));
    calc.printStatus("Divide by 5");
    
    calc.modulo(3);
    calc.printStatus("Modulo 3");

    // Err leaves the calculator value and operation count unchanged.
    showDivision(calc.divide(0));
    
    stdlib.println("");
    {
        var _output1:string = "Total operations: " + calc.operationCount;
        stdlib.println(_output1);
        free(_output1);
    }
}

// Demonstrate memory functions
func demonstrateMemory() -> void {
    printDoubleLine();
    stdlib.println("         CALCULATOR - MEMORY FUNCTIONS");
    printDoubleLine();
    stdlib.println("");
    
    var calc:Calculator;
    calc.init();
    
    calc.setValue(42);
    calc.printStatus("Set 42");
    
    calc.memoryStore();
    stdlib.println("Stored to memory");
    stdlib.println("");
    
    calc.setValue(10);
    calc.printStatus("Set 10");
    
    calc.add(5);
    calc.printStatus("Add 5");
    
    stdlib.println("");
    stdlib.println("Recalling memory...");
    calc.memoryRecall();
    calc.printStatus("Memory Recall");
    
    stdlib.println("");
    calc.setValue(8);
    calc.printStatus("Set 8");
    
    calc.memoryAdd();
    stdlib.println("Added to memory");
    
    calc.memoryRecall();
    calc.printStatus("Memory Recall");
}

// Demonstrate mathematical operations
func demonstrateMath() -> void {
    printDoubleLine();
    stdlib.println("         CALCULATOR - MATH OPERATIONS");
    printDoubleLine();
    stdlib.println("");
    
    var calc:Calculator;
    calc.init();
    
    stdlib.println("Computing: ((5 + 3) * 2)^2");
    stdlib.println("");
    
    calc.setValue(5);
    calc.printStatus("Set 5");
    
    calc.add(3);
    calc.printStatus("Add 3");
    
    calc.multiply(2);
    calc.printStatus("Multiply by 2");
    
    calc.square();
    calc.printStatus("Square");
    
    stdlib.println("");
    {
        var _output2:string = "Result: " + calc.getValue();
        stdlib.println(_output2);
        free(_output2);
    }
    {
        var _output3:string = "Operations performed: " + calc.operationCount;
        stdlib.println(_output3);
        free(_output3);
    }
}

// Demonstrate chain calculations
func demonstrateChain() -> void {
    printDoubleLine();
    stdlib.println("         CALCULATOR - CHAIN CALCULATIONS");
    printDoubleLine();
    stdlib.println("");
    
    var calc:Calculator;
    calc.init();
    
    stdlib.println("Computing: 100 - 25 + 10 * 2 / 4");
    stdlib.println("(Left-to-right evaluation)");
    stdlib.println("");
    
    calc.setValue(100);
    {
        var _output4:string = "Start: " + calc.getValue();
        stdlib.println(_output4);
        free(_output4);
    }
    
    calc.subtract(25);
    {
        var _output5:string = "After -25: " + calc.getValue();
        stdlib.println(_output5);
        free(_output5);
    }
    
    calc.add(10);
    {
        var _output6:string = "After +10: " + calc.getValue();
        stdlib.println(_output6);
        free(_output6);
    }
    
    calc.multiply(2);
    {
        var _output7:string = "After *2: " + calc.getValue();
        stdlib.println(_output7);
        free(_output7);
    }
    
    showDivision(calc.divide(4));
    {
        var _output8:string = "After /4: " + calc.getValue();
        stdlib.println(_output8);
        free(_output8);
    }
    
    stdlib.println("");
    {
        var _output9:string = "Final result: " + calc.getValue();
        stdlib.println(_output9);
        free(_output9);
    }
}

// Demonstrate absolute value and negative numbers
func demonstrateAbsolute() -> void {
    printDoubleLine();
    stdlib.println("         CALCULATOR - ABSOLUTE VALUE");
    printDoubleLine();
    stdlib.println("");
    
    var calc:Calculator;
    calc.init();
    
    calc.setValue(10);
    calc.subtract(30);
    calc.printStatus("10 - 30");
    
    stdlib.println("Taking absolute value...");
    calc.absolute();
    calc.printStatus("Absolute");
    
    stdlib.println("");
    calc.setValue(-42);
    calc.printStatus("Set -42");
    
    calc.absolute();
    calc.printStatus("Absolute");
}

func main() -> void {
    demonstrateBasicOps();
    stdlib.println("");
    
    demonstrateMemory();
    stdlib.println("");
    
    demonstrateMath();
    stdlib.println("");
    
    demonstrateChain();
    stdlib.println("");
    
    demonstrateAbsolute();
    
    stdlib.println("");
    printDoubleLine();
    stdlib.println("CALCULATOR DEMONSTRATION COMPLETE");
    printDoubleLine();
}

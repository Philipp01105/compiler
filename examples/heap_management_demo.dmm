import <stdlib>

// ============================================================================
// HEAP MANAGEMENT DEMONSTRATION
// ============================================================================
// This file demonstrates all heap management features:
// - Pointer type declarations
// - Heap allocation with reserve
// - Manual deallocation with free
// - Garbage collection with // ============================================================================

// Example 1: Basic Pointer Declarations
func example1_pointers() -> void {
    println("=== Example 1: Pointer Declarations ===");
    
    var intPtr:*int;
    var charPtr:*char;
    var strPtr:*string;
    
    println("Three pointer variables declared:");
    println("  - intPtr (pointer to int)");
    println("  - charPtr (pointer to char)");
    println("  - strPtr (pointer to string)");
    println("");
}

// Example 2: Basic Heap Allocation with reserve
func example2_reserve() -> void {
    println("=== Example 2: Heap Allocation ===");
    
    var p:*int = reserve(int);  // Allocate memory for int type
    
    println("Allocated memory on heap for integer");
    println("Pointer is now valid and points to heap memory");
    
    free(p);
    println("Memory freed");
    println("");
}

// Example 3: Multiple Allocations
func example3_multiple() -> void {
    println("=== Example 3: Multiple Allocations ===");
    
    var a:*int = reserve(int);
    println("Allocated memory for int");
    
    var b:*char = reserve(char);
    println("Allocated memory for char");
    
    var c:*double = reserve(double);
    println("Allocated memory for double");
    
    println("All allocations successful");
    
    free(a);
    free(b);
    free(c);
    
    println("All memory freed");
    println("");
}

// Example 4: Garbage Collected Variable
func example4_gc() -> void {
    println("=== Example 4: Garbage Collection ===");
    
    var gcPtr:*int = reserve(int);
    
    println("GC-managed pointer allocated");
    println("No manual free needed - automatically collected");
    
    // No free statement - garbage collector handles it
    println("");
}

// Example 5: Allocating Single Block
func example5_large_allocation() -> void {
    println("=== Example 5: Single Allocation ===");
    
    var buffer:*char = reserve(char);
    println("Allocated memory for single char");
    
    free(buffer);
    println("Buffer freed");
    println("");
}

// Example 6: Mixed Manual and GC Memory
func example6_mixed() -> void {
    println("=== Example 6: Mixed Memory Management ===");
    
    // Manual memory management
    var manual:*int = reserve(int);
    println("Manual pointer allocated");
    
    // Garbage collected
    var automatic:*int = reserve(int);
    println("GC pointer allocated");
    
    // Only free the manual one
    free(manual);
    println("Manual pointer freed");
    println("GC pointer will be auto-freed");
    println("");
}

// Example 7: Scoped GC Variables
func example7_scoped_gc() -> void {
    println("=== Example 7: Scoped GC Variables ===");
    
    println("Entering scope with GC variable");
    
    var scopedPtr:*int = reserve(int);
    println("  Allocated inside scope");
    
    println("Exiting scope");
    println("  GC will clean up automatically");
    println("");
}

// Example 8: Different Types
func example8_different_types() -> void {
    println("=== Example 8: Different Types ===");
    
    var intPtr:*int = reserve(int);
    println("Allocated int (4 bytes)");
    
    var doublePtr:*double = reserve(double);
    println("Allocated double (8 bytes)");
    
    var floatPtr:*float = reserve(float);
    println("Allocated float (4 bytes)");
    
    free(intPtr);
    free(doublePtr);
    free(floatPtr);
    println("All freed");
    println("");
}

// Main function - runs all examples
func main() -> void {
    println("############################################");
    println("#                                          #");
    println("#     HEAP MANAGEMENT DEMONSTRATION        #");
    println("#                                          #");
    println("############################################");
    println("");
    
    example1_pointers();
    example2_reserve();
    example3_multiple();
    example4_gc();
    example5_large_allocation();
    example6_mixed();
    example7_scoped_gc();
    example8_different_types();
    
    println("############################################");
    println("#                                          #");
    println("#     ALL EXAMPLES COMPLETED               #");
    println("#                                          #");
    println("############################################");
}

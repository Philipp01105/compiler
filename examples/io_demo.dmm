// ===================================================================
// DMM I/O System Demonstration
// ===================================================================
// This example showcases the pure syscall-based I/O system that
// operates without any C library dependencies.
//
// Features demonstrated:
//   - Direct syscall usage (sys_write, sys_read, sys_open, sys_close)
//   - High-level file operations from stdlib/io.dmm
//   - String operations and conversions
// ===================================================================

import <stdlib>
func main() -> void {
    println("╔════════════════════════════════════════╗");
    println("║   DMM Syscall-Based I/O System Demo   ║");
    println("╚════════════════════════════════════════╝");
    println("");
    
    // ===============================================================
    // Part 1: Direct Syscall Usage (Low-Level)
    // ===============================================================
    println("【Part 1: Direct Syscalls】");
    println("");
    
    var msg1:string = "  → Using sys_write directly...\n";
    var len1:int = io_strlen(msg1);
    sys_write(1, msg1, len1);
    
    var msg2:string = "  → String length of 'Hello': ";
    var len2:int = io_strlen(msg2);
    sys_write(1, msg2, len2);
    
    var test:string = "Hello";
    var test_len:int = io_strlen(test);
    var[16] buf:char;
    var num_len:int = io_int_to_str(test_len, &buf, 16);
    sys_write(1, &buf, num_len);
    var nl:string = "\n";
    sys_write(1, nl, 1);
    
    println("");
    
    // ===============================================================
    // Part 2: High-Level File Operations
    // ===============================================================
    println("【Part 2: File Operations】");
    println("");
    
    println("  → Writing to file 'demo_output.txt'...");
    var content:string = "This file was created using pure Linux syscalls!\nNo C library functions were used.\nDirect kernel I/O operations only.\n";
    var result:int = write_file("demo_output.txt", content);
    
    if (result == 0) {
        println("     ✓ File written successfully");
    }
    
    println("");
    println("  → Reading file back...");
    var[512] read_buf:char;
    var bytes_read:int = read_file("demo_output.txt", &read_buf, 511);
    
    if (bytes_read > 0) {
        println("     ✓ File read successfully");
        println("     Content preview:");
        println("     ─────────────────");
        var preview:string = "     ";
        sys_write(1, preview, 5);
        sys_write(1, &read_buf, 50);
        println("...");
    }
    
    println("");
    
    // ===============================================================
    // Part 3: Stream-Based I/O
    // ===============================================================
    println("【Part 3: Stream I/O】");
    println("");
    
    println("  → Opening file stream...");
    var fd:int = open_write("stream_demo.txt");
    
    if (fd >= 0) {
        println("     ✓ Stream opened (fd: file descriptor obtained)");
        
        write_str_to(fd, "Line 1: Stream-based writing\n");
        write_str_to(fd, "Line 2: Multiple writes\n");
        write_str_to(fd, "Line 3: All without C library\n");
        
        close_file(fd);
        println("     ✓ Stream closed");
    }
    
    println("");
    
    // ===============================================================
    // Summary
    // ===============================================================
    println("╔════════════════════════════════════════╗");
    println("║          Demo Completed! ✓             ║");
    println("╚════════════════════════════════════════╝");
    println("");
    println("Files created:");
    println("  • demo_output.txt");
    println("  • stream_demo.txt");
    println("");
    println("All I/O operations performed using:");
    println("  ✓ Linux syscalls only (write, read, open, close)");
    println("  ✓ No C library dependencies");
    println("  ✓ Direct kernel communication");
}

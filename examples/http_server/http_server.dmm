package main;
import (
    "stdlib/core"
    "stdlib/net"
    "stdlib/time"
    "stdlib/text"
    "stdlib/bytes"
    "stdlib/io"
    "stdlib/process"
    "stdlib/numeric"
);

enum Reply { Home, Health, BadRequest, NotFound, MethodNotAllowed, HeadersTooLarge }

// Responses have fixed byte lengths, so no allocation or formatting is needed.
func response(reply: Reply, head: bit) -> string {
    match (reply) {
        Home => {
            if (head) { return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 16\r\nConnection: close\r\n\r\n"; }
            return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 16\r\nConnection: close\r\n\r\nHello from DMM!\n";
        }
        Health => {
            if (head) { return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 3\r\nConnection: close\r\n\r\n"; }
            return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 3\r\nConnection: close\r\n\r\nok\n";
        }
        NotFound => {
            if (head) { return "HTTP/1.1 404 Not Found\r\nContent-Length: 10\r\nConnection: close\r\n\r\n"; }
            return "HTTP/1.1 404 Not Found\r\nContent-Length: 10\r\nConnection: close\r\n\r\nNot found\n";
        }
        MethodNotAllowed => {
            return "HTTP/1.1 405 Method Not Allowed\r\nAllow: GET, HEAD\r\nContent-Length: 19\r\nConnection: close\r\n\r\nMethod not allowed\n";
        }
        HeadersTooLarge => {
            return "HTTP/1.1 431 Request Header Fields Too Large\r\nContent-Length: 18\r\nConnection: close\r\n\r\nHeaders too large\n";
        }
        BadRequest => return "HTTP/1.1 400 Bad Request\r\nContent-Length: 12\r\nConnection: close\r\n\r\nBad request\n";
    }
}

// Compare byte slices directly; HTTP parsing does not require UTF-8 decoding.
func equal(value: u8[], expected: string) -> bit {
    var other = text.bytes(expected);
    return value.length == other.length && bytes.startsWith(value, other);
}

async func serveConnection(connection: net.Accepted) -> core.Result<void, net.Error> {
    var deadline = time.Deadline.after(10000000000);
    var buffer: u8[8192];
    var used: usize = 0;
    var reply = Reply.BadRequest;
    var head = false;
    while (used < 8192) {
        var destination = buffer[used:];
        var count = connection.stream.read(&mut destination, deadline).await()?;
        if (count == 0) {
            if (used == 0) { return core.Result<void, net.Error>.Ok; }
            break;
        }
        used += count;
        var request = buffer[:used];
        match (bytes.find(request, text.bytes("\r\n\r\n"))) {
            None => {
                if (used == 8192) { reply = Reply.HeadersTooLarge; }
                continue;
            }
            Some(end) => {}
        }
        // Validate the request line before choosing a route.
        match (bytes.find(request, text.bytes("\r\n"))) {
            None => break;
            Some(end) => {
                var line = request[:end];
                match (bytes.find(line, text.bytes(" "))) {
                    None => break;
                    Some(first) => {
                        var method = line[:first];
                        var rest = line[first + 1:];
                        match (bytes.find(rest, text.bytes(" "))) {
                            None => break;
                            Some(second) => {
                                var path = rest[:second];
                                var version = rest[second + 1:];
                                if (!equal(version, "HTTP/1.1") && !equal(version, "HTTP/1.0")) { break; }
                                if (method.length == 0 || path.length == 0) { break; }
                                head = equal(method, "HEAD");
                                if (!head && !equal(method, "GET")) { reply = Reply.MethodNotAllowed; }
                                else if (equal(path, "/")) { reply = Reply.Home; }
                                else if (equal(path, "/health")) { reply = Reply.Health; }
                                else { reply = Reply.NotFound; }
                            }
                        }
                    }
                }
            }
        }
        break;
    }
    var output = text.bytes(response(reply, head));
    connection.stream.writeAll(&output, deadline).await()?;
    connection.stream.shutdownWrite()?;
    return core.Result<void, net.Error>.Ok;
}

async func run(port: u16) -> int {
    match (net.listen(net.ipv4(2130706433, port))) {
        Err(error) => { io.println("Could not listen on the requested port"); return 1; }
        Ok(listener) => {
            match (listener.localAddress()) {
                Err(error) => { io.println("Could not query the listening address"); return 1; }
                Ok(address) => {
                    io.print("HTTP server listening on http://127.0.0.1:");
                    io.print(address.port);
                    io.println(" (Ctrl+C to stop)");
                }
            }
            while (true) {
                match (listener.accept().await()) {
                    Err(error) => { io.println("Accept failed"); return 2; }
                    Ok(connection) => {
                        // Owning the stream keeps its buffers and pending operations in this frame.
                        match (serveConnection(connection).await()) {
                            Ok => {}
                            Err(error) => { io.println("Connection failed or timed out"); }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

func main() -> int {
    match (process.args()) {
        Err(error) => { io.println("Could not read arguments"); return 2; }
        Ok(arguments) => {
            if (arguments.length() > 1) { io.println("Usage: http_server [PORT] (default 8080; 0 chooses a free port)"); return 2; }
            var port: u16 = 8080;
            if (arguments.length() == 1) {
                var digits: u8[5]; var storage = digits[:];
                match (arguments.get(0).copyBytes(&mut storage)) {
                    Err(error) => { io.println("Invalid port"); return 2; }
                    Ok(length) => match (numeric.parseUint(digits[:length], 10)) {
                        Err(error) => { io.println("Invalid port"); return 2; }
                        Ok(value) => { if (value > 65535) { io.println("Invalid port"); return 2; } port = value.(u16); }
                    }
                }
            }
            return block_on(run(port));
        }
    }
}

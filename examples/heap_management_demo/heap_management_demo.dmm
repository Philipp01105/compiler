package main;
import "stdlib";
// ============================================================================
// HEAP MANAGEMENT DEMONSTRATION
// ============================================================================
// This file demonstrates all heap management features:
// - Pointer type declarations
// - Heap allocation with reserve
// - Manual deallocation with free
// - Explicit releases before leaving a scope
// - Generic allocation of Cell<T> with inferred type arguments
// ============================================================================

// Example 1: Basic Pointer Declarations
func example1_pointers() -> void {
    stdlib.println("=== Example 1: Pointer Declarations ===");
    
    var intPtr:*int;
    var charPtr:*char;
    var strPtr:*string;
    
    stdlib.println("Three pointer variables declared:");
    stdlib.println("  - intPtr (pointer to int)");
    stdlib.println("  - charPtr (pointer to char)");
    stdlib.println("  - strPtr (pointer to string)");
    stdlib.println("");
}

// Example 2: Basic Heap Allocation with reserve
func example2_reserve() -> void {
    stdlib.println("=== Example 2: Heap Allocation ===");
    
    var p:*int = reserve(int);  // Allocate memory for int type
    
    stdlib.println("Allocated memory on heap for integer");
    stdlib.println("Pointer is now valid and points to heap memory");
    
    free(p);
    stdlib.println("Memory freed");
    stdlib.println("");
}

// Example 3: Multiple Allocations
func example3_multiple() -> void {
    stdlib.println("=== Example 3: Multiple Allocations ===");
    
    var a:*int = reserve(int);
    stdlib.println("Allocated memory for int");
    
    var b:*char = reserve(char);
    stdlib.println("Allocated memory for char");
    
    var c:*double = reserve(double);
    stdlib.println("Allocated memory for double");
    
    stdlib.println("All allocations successful");
    
    free(a);
    free(b);
    free(c);
    
    stdlib.println("All memory freed");
    stdlib.println("");
}

// Example 4: Explicit Allocation Lifetime
func example4_lifetime() -> void {
    stdlib.println("=== Example 4: Explicit Allocation Lifetime ===");
    
    var pointer:*int = reserve(int);
    
    stdlib.println("Pointer allocated");
    free(pointer);
    stdlib.println("Pointer explicitly freed");
    
    stdlib.println("");
}

// Example 5: Allocating Single Block
func example5_large_allocation() -> void {
    stdlib.println("=== Example 5: Single Allocation ===");
    
    var buffer:*char = reserve(char);
    stdlib.println("Allocated memory for single char");
    
    free(buffer);
    stdlib.println("Buffer freed");
    stdlib.println("");
}

// The argument infers T; reserve allocates the complete concrete Cell<T>.
// The caller owns the returned allocation and releases it once.
func allocateCell<T>(value:T) -> *stdlib.Cell<T> {
    var cell:*stdlib.Cell<T> = reserve(stdlib.Cell<T>);
    cell.value = value;
    return cell;
}

func example9_generic_allocation() -> void {
    stdlib.println("=== Example 9: Generic Heap Containers ===");
    var number:*stdlib.Cell<int> = allocateCell(42);
    var letter:*stdlib.Cell<char> = allocateCell('A');
    stdlib.println(number.value);
    stdlib.println(letter.value);
    free(number);
    free(letter);
    stdlib.println("");
}

// Example 6: Multiple Allocation Lifetimes
func example6_mixed() -> void {
    stdlib.println("=== Example 6: Mixed Memory Management ===");
    
    // Manual memory management
    var manual:*int = reserve(int);
    stdlib.println("Manual pointer allocated");
    
    // A second independent allocation
    var second:*int = reserve(int);
    stdlib.println("Second pointer allocated");
    
    // Release both original allocation pointers
    free(manual);
    stdlib.println("Manual pointer freed");
    free(second);
    stdlib.println("Second pointer freed");
    stdlib.println("");
}

// Example 7: Scoped Allocations
func example7_scoped() -> void {
    stdlib.println("=== Example 7: Scoped Allocations ===");
    
    stdlib.println("Entering scope with a pointer variable");
    
    var scopedPtr:*int = reserve(int);
    stdlib.println("  Allocated inside scope");
    
    stdlib.println("Exiting scope");
    free(scopedPtr);
    stdlib.println("  Allocation explicitly freed");
    stdlib.println("");
}

// Example 8: Different Types
func example8_different_types() -> void {
    stdlib.println("=== Example 8: Different Types ===");
    
    var intPtr:*int = reserve(int);
    stdlib.println("Allocated int (4 bytes)");
    
    var doublePtr:*double = reserve(double);
    stdlib.println("Allocated double (8 bytes)");
    
    var floatPtr:*float = reserve(float);
    stdlib.println("Allocated float (4 bytes)");
    
    free(intPtr);
    free(doublePtr);
    free(floatPtr);
    stdlib.println("All freed");
    stdlib.println("");
}

// Main function - runs all examples
func main() -> void {
    stdlib.println("############################################");
    stdlib.println("#                                          #");
    stdlib.println("#     HEAP MANAGEMENT DEMONSTRATION        #");
    stdlib.println("#                                          #");
    stdlib.println("############################################");
    stdlib.println("");
    
    example1_pointers();
    example2_reserve();
    example3_multiple();
    example4_lifetime();
    example5_large_allocation();
    example6_mixed();
    example7_scoped();
    example8_different_types();
    example9_generic_allocation();
    
    stdlib.println("############################################");
    stdlib.println("#                                          #");
    stdlib.println("#     ALL EXAMPLES COMPLETED               #");
    stdlib.println("#                                          #");
    stdlib.println("############################################");
}

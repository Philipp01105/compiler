package main;
// Test for Input struct functionality
import "stdlib";
func main() -> void {
    var input:stdlib.Input;
    input.init();
    
    stdlib.println("Testing Input struct");
    stdlib.println("Enter an integer:");
    var num:int = input.readInt();
    {
        var _output0:string = "You entered: " + num;
        stdlib.println(_output0);
        free(_output0);
    }
    
    stdlib.println("Enter a character:");
    var ch:char = input.readChar();
    stdlib.print("You entered: ");
    stdlib.print(ch);
    stdlib.println("");
}

package main;
import "stdlib";
// =================================================================
// TIC TAC TOE GAME
// A classic 3x3 Tic Tac Toe game implementation using Structs
// =================================================================
// This game demonstrates:
// - Struct usage with fields and methods
// - Constant array lengths and slice parameters for scripted moves
// - Control flow (game loop, win condition checking)
// - Object-oriented design principles
// - Input validation
// - State management
// =================================================================

const BOARD_CELLS:int = 9;
const SCRIPTED_MOVES:int = 5;

// Helper functions
func printLine() -> void {
    stdlib.println("--------------------------------");
}

func printDoubleLine() -> void {
    stdlib.println("================================");
}

// TicTacToe game struct
struct TicTacToe {
    // Game board: 9 cells (0-8)
    // 0 = empty, 1 = Player X, 2 = Player O
    var board0:int;
    var board1:int;
    var board2:int;
    var board3:int;
    var board4:int;
    var board5:int;
    var board6:int;
    var board7:int;
    var board8:int;
    
    // Current player (1 = X, 2 = O)
    var currentPlayer:int;
    
    // Game state (0 = ongoing, 1 = X wins, 2 = O wins, 3 = draw)
    var gameState:int;

    // Initialize the game board
    func init() -> void {
        board0 = 0;
        board1 = 0;
        board2 = 0;
        board3 = 0;
        board4 = 0;
        board5 = 0;
        board6 = 0;
        board7 = 0;
        board8 = 0;
        currentPlayer = 1;
        gameState = 0;
    }

    // Get board value at position
    func getBoardValue(pos:int) -> int {
        if (pos == 0) {
            return board0;
        } else if (pos == 1) {
            return board1;
        } else if (pos == 2) {
            return board2;
        } else if (pos == 3) {
            return board3;
        } else if (pos == 4) {
            return board4;
        } else if (pos == 5) {
            return board5;
        } else if (pos == 6) {
            return board6;
        } else if (pos == 7) {
            return board7;
        } else if (pos == 8) {
            return board8;
        }
        return 0;
    }
    
    // Set board value at position
    func setBoardValue(pos:int, value:int) -> void {
        if (pos == 0) {
            board0 = value;
        } else if (pos == 1) {
            board1 = value;
        } else if (pos == 2) {
            board2 = value;
        } else if (pos == 3) {
            board3 = value;
        } else if (pos == 4) {
            board4 = value;
        } else if (pos == 5) {
            board5 = value;
        } else if (pos == 6) {
            board6 = value;
        } else if (pos == 7) {
            board7 = value;
        } else if (pos == 8) {
            board8 = value;
        }
    }
    
    // Print the game board
    func printBoard() -> void {
        printLine();
        stdlib.println("Current Board:");
        printLine();
        
        // Row 0
        stdlib.print("  ");
        if (board0 == 0) { stdlib.print("0"); } else if (board0 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board1 == 0) { stdlib.print("1"); } else if (board1 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board2 == 0) { stdlib.print("2"); } else if (board2 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.println("");
        stdlib.println(" -----------");
        
        // Row 1
        stdlib.print("  ");
        if (board3 == 0) { stdlib.print("3"); } else if (board3 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board4 == 0) { stdlib.print("4"); } else if (board4 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board5 == 0) { stdlib.print("5"); } else if (board5 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.println("");
        stdlib.println(" -----------");
        
        // Row 2
        stdlib.print("  ");
        if (board6 == 0) { stdlib.print("6"); } else if (board6 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board7 == 0) { stdlib.print("7"); } else if (board7 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.print(" | ");
        if (board8 == 0) { stdlib.print("8"); } else if (board8 == 1) { stdlib.print("X"); } else { stdlib.print("O"); }
        stdlib.println("");
        printLine();
    }

    // Check if a position is valid and empty
    func isValidMove(pos:int) -> bit {
        if (pos < 0) {
            return 0;
        }
        if (pos > 8) {
            return 0;
        }
        
        // Check if position is empty
        var value:int = 0;
        if (pos == 0) { value = board0; }
        else if (pos == 1) { value = board1; }
        else if (pos == 2) { value = board2; }
        else if (pos == 3) { value = board3; }
        else if (pos == 4) { value = board4; }
        else if (pos == 5) { value = board5; }
        else if (pos == 6) { value = board6; }
        else if (pos == 7) { value = board7; }
        else if (pos == 8) { value = board8; }
        
        if (value != 0) {
            return 0;
        }
        return 1;
    }
    
    // Make a move at position
    func makeMove(pos:int) -> bit {
        if (pos < 0) {
            return 0;
        }
        if (pos > 8) {
            return 0;
        }
        
        // Check if position is empty and make move
        if (pos == 0) {
            if (board0 != 0) { return 0; }
            board0 = currentPlayer;
        } else if (pos == 1) {
            if (board1 != 0) { return 0; }
            board1 = currentPlayer;
        } else if (pos == 2) {
            if (board2 != 0) { return 0; }
            board2 = currentPlayer;
        } else if (pos == 3) {
            if (board3 != 0) { return 0; }
            board3 = currentPlayer;
        } else if (pos == 4) {
            if (board4 != 0) { return 0; }
            board4 = currentPlayer;
        } else if (pos == 5) {
            if (board5 != 0) { return 0; }
            board5 = currentPlayer;
        } else if (pos == 6) {
            if (board6 != 0) { return 0; }
            board6 = currentPlayer;
        } else if (pos == 7) {
            if (board7 != 0) { return 0; }
            board7 = currentPlayer;
        } else if (pos == 8) {
            if (board8 != 0) { return 0; }
            board8 = currentPlayer;
        }
        return 1;
    }

    // Check if there's a winner
    func checkWinner() -> int {
        // Check row 0
        if (board0 != 0) {
            if (board0 == board1) {
                if (board1 == board2) {
                    return board0;
                }
            }
        }
        
        // Check row 1
        if (board3 != 0) {
            if (board3 == board4) {
                if (board4 == board5) {
                    return board3;
                }
            }
        }
        
        // Check row 2
        if (board6 != 0) {
            if (board6 == board7) {
                if (board7 == board8) {
                    return board6;
                }
            }
        }
        
        // Check column 0
        if (board0 != 0) {
            if (board0 == board3) {
                if (board3 == board6) {
                    return board0;
                }
            }
        }
        
        // Check column 1
        if (board1 != 0) {
            if (board1 == board4) {
                if (board4 == board7) {
                    return board1;
                }
            }
        }
        
        // Check column 2
        if (board2 != 0) {
            if (board2 == board5) {
                if (board5 == board8) {
                    return board2;
                }
            }
        }
        
        // Check diagonal 0-4-8
        if (board0 != 0) {
            if (board0 == board4) {
                if (board4 == board8) {
                    return board0;
                }
            }
        }
        
        // Check diagonal 2-4-6
        if (board2 != 0) {
            if (board2 == board4) {
                if (board4 == board6) {
                    return board2;
                }
            }
        }
        
        return 0;
    }

    // Check if board is full (draw)
    func isBoardFull() -> bit {
        if (board0 == 0) { return 0; }
        if (board1 == 0) { return 0; }
        if (board2 == 0) { return 0; }
        if (board3 == 0) { return 0; }
        if (board4 == 0) { return 0; }
        if (board5 == 0) { return 0; }
        if (board6 == 0) { return 0; }
        if (board7 == 0) { return 0; }
        if (board8 == 0) { return 0; }
        return 1;
    }
    
    // Switch to the other player
    func switchPlayer() -> void {
        if (currentPlayer == 1) {
            currentPlayer = 2;
        } else {
            currentPlayer = 1;
        }
    }

    // Get AI move (simple strategy - takes first available spot)
    func getAIMove() -> int {
        // Take center if available
        if (board4 == 0) {
            return 4;
        }
        
        // Take corners
        if (board0 == 0) {
            return 0;
        }
        if (board2 == 0) {
            return 2;
        }
        if (board6 == 0) {
            return 6;
        }
        if (board8 == 0) {
            return 8;
        }
        
        // Take edges
        if (board1 == 0) {
            return 1;
        }
        if (board3 == 0) {
            return 3;
        }
        if (board5 == 0) {
            return 5;
        }
        if (board7 == 0) {
            return 7;
        }
        
        return 0;
    }
}

// Simulate a game with predetermined moves
func simulateGame() -> void {
    printDoubleLine();
    stdlib.println("         TIC TAC TOE GAME SIMULATION");
    printDoubleLine();
    stdlib.println("           (Using Structs)");
    stdlib.println("");
    
    // Game moves: X at 4, O at 0, X at 1, O at 8, X at 7 (X wins)
    var moves:int[SCRIPTED_MOVES];
    moves[0] = 4;
    moves[1] = 0;
    moves[2] = 1;
    moves[3] = 8;
    moves[4] = 7;
    
    playMoves(moves);
}

// Passing a fixed array supplies both the data and its checked slice length.
func playMoves(moves:int[]) -> void {
    var game:TicTacToe;
    game.init();

    var moveCount:int = 0;
    
    for (var turn:int = 0; turn < moves.length; turn++) {
        game.printBoard();
        
        var move:int = moves[turn];
        var playerName:string = "X";
        if (game.currentPlayer == 2) {
            playerName = "O";
        }
        
        {
            var _output0:string = "Player " + playerName + " plays at position " + move;
            stdlib.println(_output0);
            free(_output0);
        }
        stdlib.println("");
        
        if (game.makeMove(move) == 1) {
            moveCount = moveCount + 1;
            
            var winner:int = game.checkWinner();
            if (winner != 0) {
                game.printBoard();
                if (winner == 1) {
                    stdlib.println("PLAYER X WINS!");
                } else {
                    stdlib.println("PLAYER O WINS!");
                }
                return;
            }
            
            if (game.isBoardFull() == 1) {
                game.printBoard();
                stdlib.println("IT'S A DRAW!");
                return;
            }
            
            game.switchPlayer();
        }
    }
    
    game.printBoard();
    stdlib.println("Game simulation completed!");
}

// Simulate AI vs AI game
func simulateAIGame() -> void {
    printDoubleLine();
    stdlib.println("         TIC TAC TOE - AI VS AI");
    printDoubleLine();
    stdlib.println("           (Using Structs)");
    stdlib.println("");
    
    var game:TicTacToe;
    game.init();
    
    var maxMoves:int = BOARD_CELLS;
    
    for (var turn:int = 0; turn < maxMoves; turn++) {
        game.printBoard();
        
        var move:int = game.getAIMove();
        var playerName:string = "X";
        if (game.currentPlayer == 2) {
            playerName = "O";
        }
        
        {
            var _output1:string = "Player " + playerName + " (AI) plays at position " + move;
            stdlib.println(_output1);
            free(_output1);
        }
        stdlib.println("");
        
        if (game.makeMove(move) == 1) {
            var winner:int = game.checkWinner();
            if (winner != 0) {
                game.printBoard();
                if (winner == 1) {
                    stdlib.println("PLAYER X (AI) WINS!");
                } else {
                    stdlib.println("PLAYER O (AI) WINS!");
                }
                return;
            }
            
            if (game.isBoardFull() == 1) {
                game.printBoard();
                stdlib.println("IT'S A DRAW!");
                return;
            }
            
            game.switchPlayer();
        }
    }
}

func main() -> void {
    // Run predefined game simulation
    simulateGame();
    
    stdlib.println("");
    stdlib.println("");
    
    // Run AI vs AI simulation
    simulateAIGame();
    
    stdlib.println("");
    printDoubleLine();
    stdlib.println("TIC TAC TOE DEMONSTRATION COMPLETE");
    printDoubleLine();
}

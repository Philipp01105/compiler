package main;
import "stdlib";
// =================================================================
// ROCK PAPER SCISSORS GAME
// A classic Rock-Paper-Scissors game implementation
// =================================================================
// This game demonstrates:
// - Struct usage for game state
// - Game logic with multiple outcomes
// - Score tracking
// - Named compile-time constants for moves
// =================================================================

const ROCK:int = 0;
const PAPER:int = 1;
const SCISSORS:int = 2;

// Helper functions
func printLine() -> void {
    stdlib.println("--------------------------------");
}

func printDoubleLine() -> void {
    stdlib.println("================================");
}

func printLabeled(label:string, value:int) -> void {
    {
        var _output0:string = label + ": " + value;
        stdlib.println(_output0);
        free(_output0);
    }
}

// Rock Paper Scissors Game struct
struct RPSGame {
    var player1Score:int;
    var player2Score:int;
    var roundsPlayed:int;
    var maxRounds:int;
    
    // Initialize the game
    func init(rounds:int) -> void {
        player1Score = 0;
        player2Score = 0;
        roundsPlayed = 0;
        maxRounds = rounds;
    }
    
    // Determine winner of a round
    // Returns: 0 = tie, 1 = player1 wins, 2 = player2 wins
    func playRound(p1Move:int, p2Move:int) -> int {
        roundsPlayed = roundsPlayed + 1;
        
        // Tie
        if (p1Move == p2Move) {
            return 0;
        }
        
        // Player 1 wins scenarios
        if (p1Move == ROCK) {
            if (p2Move == SCISSORS) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        if (p1Move == PAPER) {
            if (p2Move == ROCK) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        if (p1Move == SCISSORS) {
            if (p2Move == PAPER) {
                player1Score = player1Score + 1;
                return 1;
            }
        }
        
        // Player 2 wins
        player2Score = player2Score + 1;
        return 2;
    }
    
    // Check if game is over
    func isGameOver() -> bit {
        if (roundsPlayed >= maxRounds) {
            return 1;
        }
        return 0;
    }
    
    // Get final winner
    func getFinalWinner() -> int {
        if (player1Score > player2Score) {
            return 1;
        } else if (player2Score > player1Score) {
            return 2;
        }
        return 0;
    }
    
    // Print current score
    func printScore() -> void {
        printLine();
        printLabeled("Round", roundsPlayed);
        printLabeled("Max Rounds", maxRounds);
        printLabeled("Player 1 Score", player1Score);
        printLabeled("Player 2 Score", player2Score);
        printLine();
    }
}

// Convert move number to name
func getMoveName(move:int) -> string {
    if (move == ROCK) {
        return "Rock";
    } else if (move == PAPER) {
        return "Paper";
    } else {
        return "Scissors";
    }
}

// Simulate a game
func simulateGame() -> void {
    printDoubleLine();
    stdlib.println("         ROCK PAPER SCISSORS");
    printDoubleLine();
    stdlib.println("");
    
    var game:RPSGame;
    game.init(5);
    
    stdlib.println("Best of 5 rounds!");
    stdlib.println("0 = Rock, 1 = Paper, 2 = Scissors");
    stdlib.println("");
    
    // Predefined moves for simulation
    var p1Moves:int[5];
    p1Moves[0] = ROCK;
    p1Moves[1] = PAPER;
    p1Moves[2] = SCISSORS;
    p1Moves[3] = ROCK;
    p1Moves[4] = PAPER;
    
    var p2Moves:int[5];
    p2Moves[0] = SCISSORS;
    p2Moves[1] = ROCK;
    p2Moves[2] = SCISSORS;
    p2Moves[3] = PAPER;
    p2Moves[4] = PAPER;
    
    for (var i:int = 0; i < 5; i++) {
        var p1Move:int = p1Moves[i];
        var p2Move:int = p2Moves[i];
        
        {
            var _output1:string = "Round " + (i + 1) + ":";
            stdlib.println(_output1);
            free(_output1);
        }
        {
            var _output2:string = "  Player 1: " + getMoveName(p1Move);
            stdlib.println(_output2);
            free(_output2);
        }
        {
            var _output3:string = "  Player 2: " + getMoveName(p2Move);
            stdlib.println(_output3);
            free(_output3);
        }
        
        var result:int = game.playRound(p1Move, p2Move);
        
        if (result == 0) {
            stdlib.println("  Result: TIE!");
        } else if (result == 1) {
            stdlib.println("  Result: Player 1 wins this round!");
        } else {
            stdlib.println("  Result: Player 2 wins this round!");
        }
        
        game.printScore();
    }
    
    var winner:int = game.getFinalWinner();
    stdlib.println("");
    if (winner == 0) {
        stdlib.println("FINAL RESULT: IT'S A TIE!");
    } else if (winner == 1) {
        stdlib.println("FINAL RESULT: PLAYER 1 WINS!");
    } else {
        stdlib.println("FINAL RESULT: PLAYER 2 WINS!");
    }
    {
        var _output4:string = "Final Score - P1: " + game.player1Score + " | P2: " + game.player2Score;
        stdlib.println(_output4);
        free(_output4);
    }
}

// Simulate a tournament
func simulateTournament() -> void {
    printDoubleLine();
    stdlib.println("         RPS TOURNAMENT");
    printDoubleLine();
    stdlib.println("");
    
    var game:RPSGame;
    game.init(10);
    
    stdlib.println("10-round tournament with pattern strategy");
    stdlib.println("");
    
    for (var i:int = 0; i < 10; i++) {
        // Player 1 uses cycling pattern
        var p1Move:int = i % 3;
        
        // Player 2 uses counter pattern (tries to beat P1)
        var p2Move:int = (i + 1) % 3;
        
        {
            var _output5:string = "Round " + (i + 1) + ": " + getMoveName(p1Move) + " vs " + getMoveName(p2Move);
            stdlib.println(_output5);
            free(_output5);
        }
        
        var result:int = game.playRound(p1Move, p2Move);
        
        if (result == 0) {
            stdlib.println("  TIE");
        } else if (result == 1) {
            stdlib.println("  P1 wins");
        } else {
            stdlib.println("  P2 wins");
        }
    }
    
    game.printScore();
    
    var winner:int = game.getFinalWinner();
    stdlib.println("");
    if (winner == 1) {
        stdlib.println("Player 1 wins the tournament!");
    } else if (winner == 2) {
        stdlib.println("Player 2 wins the tournament!");
    } else {
        stdlib.println("Tournament ends in a tie!");
    }
}

func main() -> void {
    simulateGame();
    
    stdlib.println("");
    stdlib.println("");
    
    simulateTournament();
    
    stdlib.println("");
    printDoubleLine();
    stdlib.println("ROCK PAPER SCISSORS DEMONSTRATION COMPLETE");
    printDoubleLine();
}

package main;
import "stdlib";
// =================================================================
// SHAPES - Nested Structs Example
// A demonstration of nested structs with geometric shapes
// =================================================================
// This example demonstrates:
// - Nested struct usage (struct within struct)
// - Methods accessing nested struct fields
// - Struct composition for complex data structures
// - Generic Point<T> coordinates
// - Explicit Equal trait implementation with Self and a generic bound
// =================================================================

// Helper functions
func printLine() -> void {
    stdlib.println("--------------------------------");
}

func printDoubleLine() -> void {
    stdlib.println("================================");
}

func printLabeled(label:string, value:int) -> void {
    {
        var _output0:string = label + ": " + value;
        stdlib.println(_output0);
        free(_output0);
    }
}

// Point struct - represents a 2D coordinate
struct Point<T> {
    var x:T;
    var y:T;
    
    // Initialize point with coordinates
    func init(xVal:T, yVal:T) -> void {
        x = xVal;
        y = yVal;
    }
}

impl stdlib.Equal for Point<int> {
    func equal(other:Self) -> bit {
        return x == other.x && y == other.y;
    }
}

func same<T:stdlib.Equal>(left:T, right:T) -> bit {
    return left.equal(right);
}

struct Rectangle {
    var topLeft:Point<int>;
    var bottomRight:Point<int>;
}

// Demonstrate simple rectangle
func demonstrateSimpleRectangle() -> void {
    printDoubleLine();
    stdlib.println("         NESTED STRUCTS - SIMPLE RECTANGLE");
    printDoubleLine();
    stdlib.println("");
    
    var rect:Rectangle;
    rect.topLeft.x = 0;
    rect.topLeft.y = 0;
    rect.bottomRight.x = 10;
    rect.bottomRight.y = 5;
    
    printLine();
    stdlib.println("Rectangle:");
    stdlib.println("  Top-Left Corner:");
    printLabeled("    X", rect.topLeft.x);
    printLabeled("    Y", rect.topLeft.y);
    stdlib.println("  Bottom-Right Corner:");
    printLabeled("    X", rect.bottomRight.x);
    printLabeled("    Y", rect.bottomRight.y);
    
    var width:int = rect.bottomRight.x - rect.topLeft.x;
    var height:int = rect.bottomRight.y - rect.topLeft.y;
    var area:int = width * height;
    var perimeter:int = (width + height) * 2;
    
    printLabeled("  Width", width);
    printLabeled("  Height", height);
    printLabeled("  Area", area);
    printLabeled("  Perimeter", perimeter);
    printLine();
}

// Demonstrate rectangle with offset
func demonstrateOffsetRectangle() -> void {
    printDoubleLine();
    stdlib.println("         NESTED STRUCTS - OFFSET RECTANGLE");
    printDoubleLine();
    stdlib.println("");
    
    var rect:Rectangle;
    rect.topLeft.x = 100;
    rect.topLeft.y = 200;
    rect.bottomRight.x = 150;
    rect.bottomRight.y = 280;
    
    printLine();
    stdlib.println("Rectangle:");
    stdlib.println("  Top-Left Corner:");
    printLabeled("    X", rect.topLeft.x);
    printLabeled("    Y", rect.topLeft.y);
    stdlib.println("  Bottom-Right Corner:");
    printLabeled("    X", rect.bottomRight.x);
    printLabeled("    Y", rect.bottomRight.y);
    
    var width:int = rect.bottomRight.x - rect.topLeft.x;
    var height:int = rect.bottomRight.y - rect.topLeft.y;
    var area:int = width * height;
    var perimeter:int = (width + height) * 2;
    
    printLabeled("  Width", width);
    printLabeled("  Height", height);
    printLabeled("  Area", area);
    printLabeled("  Perimeter", perimeter);
    printLine();
}

// Demonstrate square (special case of rectangle)
func demonstrateSquare() -> void {
    printDoubleLine();
    stdlib.println("         NESTED STRUCTS - SQUARE");
    printDoubleLine();
    stdlib.println("");
    
    var square:Rectangle;
    square.topLeft.x = 10;
    square.topLeft.y = 10;
    square.bottomRight.x = 30;
    square.bottomRight.y = 30;
    
    printLine();
    stdlib.println("Square:");
    stdlib.println("  Top-Left Corner:");
    printLabeled("    X", square.topLeft.x);
    printLabeled("    Y", square.topLeft.y);
    stdlib.println("  Bottom-Right Corner:");
    printLabeled("    X", square.bottomRight.x);
    printLabeled("    Y", square.bottomRight.y);
    
    var width:int = square.bottomRight.x - square.topLeft.x;
    var height:int = square.bottomRight.y - square.topLeft.y;
    
    printLabeled("  Width", width);
    printLabeled("  Height", height);
    
    stdlib.println("Verification:");
    if (width == height) {
        stdlib.println("  This is a SQUARE (width == height)");
    } else {
        stdlib.println("  This is a RECTANGLE (width != height)");
    }
    printLine();
}

// Demonstrate point manipulation
func demonstratePointManipulation() -> void {
    printDoubleLine();
    stdlib.println("         NESTED STRUCTS - POINT MANIPULATION");
    printDoubleLine();
    stdlib.println("");
    
    var rect:Rectangle;
    
    // Initialize with one set of points
    rect.topLeft.x = 5;
    rect.topLeft.y = 10;
    rect.bottomRight.x = 15;
    rect.bottomRight.y = 25;
    
    printLine();
    stdlib.println("Initial Rectangle:");
    stdlib.println("  Top-Left:");
    printLabeled("    X", rect.topLeft.x);
    printLabeled("    Y", rect.topLeft.y);
    stdlib.println("  Bottom-Right:");
    printLabeled("    X", rect.bottomRight.x);
    printLabeled("    Y", rect.bottomRight.y);
    printLine();
    
    // Move rectangle by changing points
    stdlib.println("Moving rectangle right by 10 units...");
    rect.topLeft.x = rect.topLeft.x + 10;
    rect.bottomRight.x = rect.bottomRight.x + 10;
    
    printLine();
    stdlib.println("After moving:");
    stdlib.println("  Top-Left:");
    printLabeled("    X", rect.topLeft.x);
    printLabeled("    Y", rect.topLeft.y);
    stdlib.println("  Bottom-Right:");
    printLabeled("    X", rect.bottomRight.x);
    printLabeled("    Y", rect.bottomRight.y);
    printLine();
    
    // Resize rectangle
    stdlib.println("Doubling rectangle size...");
    var originalWidth:int = rect.bottomRight.x - rect.topLeft.x;
    var originalHeight:int = rect.bottomRight.y - rect.topLeft.y;
    rect.bottomRight.x = rect.topLeft.x + (originalWidth * 2);
    rect.bottomRight.y = rect.topLeft.y + (originalHeight * 2);
    
    printLine();
    stdlib.println("After resizing:");
    stdlib.println("  Top-Left:");
    printLabeled("    X", rect.topLeft.x);
    printLabeled("    Y", rect.topLeft.y);
    stdlib.println("  Bottom-Right:");
    printLabeled("    X", rect.bottomRight.x);
    printLabeled("    Y", rect.bottomRight.y);
    var newWidth:int = rect.bottomRight.x - rect.topLeft.x;
    var newHeight:int = rect.bottomRight.y - rect.topLeft.y;
    printLabeled("  Width", newWidth);
    printLabeled("  Height", newHeight);
    printLine();
}

func main() -> void {
    var origin:Point<int>;
    origin.init(0, 0);
    var copy:Point<int> = origin;
    stdlib.println("Copied points are equal:");
    stdlib.println(same(origin, copy));
    copy.x = 1;
    stdlib.println("Changed points are equal:");
    stdlib.println(same(origin, copy));
    var fractional:Point<double>;
    fractional.init(1.5, 2.5);
    stdlib.println("A Point<double> coordinate:");
    stdlib.println(fractional.x);
    stdlib.println("");
    demonstrateSimpleRectangle();
    stdlib.println("");
    
    demonstrateOffsetRectangle();
    stdlib.println("");
    
    demonstrateSquare();
    stdlib.println("");
    
    demonstratePointManipulation();
    
    stdlib.println("");
    printDoubleLine();
    stdlib.println("NESTED STRUCTS DEMONSTRATION COMPLETE");
    printDoubleLine();
}

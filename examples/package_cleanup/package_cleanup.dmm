package main;
import "stdlib";

struct FirstPackageResource {
    var value:int;

    destructor {
        stdlib.println("dropping first package resource");
    }
}

struct SecondPackageResource {
    var value:int;

    destructor {
        stdlib.println("dropping second package resource");
    }
}

// Package-stored values are initialized before main and remain owned by the
// package. Moving either value out is rejected by semantic analysis.
var first:FirstPackageResource;
var second:SecondPackageResource;

func main() -> int {
    stdlib.println("main complete");
    return 0;
}

// After main returns normally, package cleanup runs in reverse declaration
// order: second is destroyed first, then first. Each live value is dropped once.

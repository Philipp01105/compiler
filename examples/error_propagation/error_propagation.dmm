package main;
import "stdlib";

enum IOError {
    Read,
}

enum AppError {
    Io,
    ;
    static func fromResidual(error: IOError) -> Self {
        return AppError.Io;
    }
}

enum Validation {
    Valid(int),
    Invalid(int),
    ;
    static func branch(value: Self) -> stdlib.Propagation<int, int> {
        match (value) {
            Valid(output) => return stdlib.Propagation<int, int>.Continue(output);
            Invalid(residual) => return stdlib.Propagation<int, int>.Break(residual);
        }
    }

    static func fromResidual(residual: int) -> Self {
        return Validation.Invalid(residual);
    }
}

func increment(value: stdlib.Option<int>) -> stdlib.Option<int> {
    return stdlib.Option<int>.Some(value? + 1);
}

func read(value: stdlib.Result<int, IOError>) -> stdlib.Result<int, AppError> {
    return stdlib.Result<int, AppError>.Ok(value?);
}

func validate(value: Validation) -> Validation {
    return Validation.Valid(value? + 3);
}

func appendAudit(target: &mut int, digit: int) -> void {
    *target = *target * 10 + digit;
}

func audited(value: stdlib.Result<int, IOError>, audit: &mut int) -> stdlib.Result<int, AppError> {
    // The same deferred cleanup runs on success and on the early return from `?`.
    defer appendAudit(audit, 9);
    return stdlib.Result<int, AppError>.Ok(value? + 1);
}

func main() -> int {
    var audit: int = 0;
    var option = increment(stdlib.Option<int>.Some(20));
    match (option) {
        Some(value) => if (value != 21) {
            return 1;
        }
        None => return 2;
    }

    var result = read(stdlib.Result<int, IOError>.Err(IOError.Read));
    match (result) {
        Ok(value) => return 3;
        Err(error) => match (error) {
            Io => {}
        }
    }

    var custom = validate(Validation.Invalid(7));
    match (custom) {
        Valid(value) => return 4;
        Invalid(error) => if (error != 7) {
            return 5;
        }
    }
    var auditedOk = audited(stdlib.Result<int, IOError>.Ok(4), &mut audit);
    var auditedError = audited(stdlib.Result<int, IOError>.Err(IOError.Read), &mut audit);
    match (auditedOk) {
        Ok(value) => if (value != 5) {
            return 6;
        }
        Err(error) => return 7;
    }
    match (auditedError) {
        Ok(value) => return 8;
        Err(error) => match (error) {
            Io => {}
        }
    }
    if (audit != 99) {
        return 9;
    }
    return 0;
}

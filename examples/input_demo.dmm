// Test for I/O functionality
#import <stdlib/io.dmm>

func main() -> void {
    println("=== DMM I/O Demo ===");
    println("");
    
    println("Enter an integer:");
    var num:int = readInt();
    print("You entered: ");
    printlnInt(num);
    println("");
    
    println("Enter a character:");
    var ch:char = readChar();
    print("You entered: ");
    printlnChar(ch);
    println("");
    
    println("Enter a string:");
    var text:string = readString();
    print("You entered: ");
    println(text);
}

// ===================================================================
// Demonstration of the new read() function
// ===================================================================
// The read() function provides a unified interface for reading input
// from streams using format specifiers (inspired by scanf/Java Scanner)
//
// Syntax: read(stream, format_specifier)
//   stream: file descriptor (0 for stdin)
//   format: "%i" or "%d" for integers, "%c" for characters
// ===================================================================

#import <stdlib/io.dmm>

func main() -> void {
    println("╔════════════════════════════════════════╗");
    println("║      DMM read() Function Demo         ║");
    println("╚════════════════════════════════════════╝");
    println("");
    
    // Example 1: Reading integers from stdin
    println("【Example 1: Reading Integers】");
    println("Enter a number:");
    var num1:int = read(0, "%i");
    print("You entered: ");
    println(num1);
    println("");
    
    // Example 2: Reading with System.in enum
    println("【Example 2: Using System.in】");
    println("Enter another number:");
    var num2:int = read(System.in.fd, "%i");
    print("You entered: ");
    println(num2);
    println("");
    
    // Example 3: Simple calculation
    println("【Example 3: Simple Calculator】");
    println("Enter first number:");
    var a:int = read(0, "%i");
    println("Enter second number:");
    var b:int = read(0, "%i");
    
    var sum:int = a + b;
    print("Sum: ");
    println(sum);
    println("");
    
    // Example 4: Reading from file
    println("【Example 4: Reading from File】");
    
    // First, write a number to a file
    write_file("number.txt", "999\n");
    println("Created file 'number.txt' with value 999");
    
    // Open and read from the file
    var fd:int = open_read("number.txt");
    if (fd >= 0) {
        var file_num:int = read(fd, "%i");
        close_file(fd);
        
        print("Read from file: ");
        println(file_num);
    }
    
    println("");
    println("╔════════════════════════════════════════╗");
    println("║        Demo Completed! ✓               ║");
    println("╚════════════════════════════════════════╝");
}

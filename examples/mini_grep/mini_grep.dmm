package main;
import (
    "stdlib/bytes"
    "stdlib/collections"
    "stdlib/core"
    "stdlib/fs"
    "stdlib/io"
    "stdlib/numeric"
    "stdlib/process"
    "stdlib/text"
);

func folded(value:u8, ignoreCase:bit) -> u8 {
    if (ignoreCase && value >= 65 && value <= 90) {
        return value + 32;
    }
    return value;
}

func contains(line:&u8[], pattern:&u8[], ignoreCase:bit) -> bit {
    if (pattern.length > line.length) {
        return false;
    }
    for (var start:usize = 0; start <= line.length - pattern.length; start += 1) {
        var same = true;
        for (var i:usize = 0; i < pattern.length; i += 1) {
            if (folded(line[start + i], ignoreCase) != folded(pattern[i], ignoreCase)) {
                same = false;
                break;
            }
        }
        if (same) {
            return true;
        }
    }
    return false;
}

func emit<W:io.Writer>(output:&mut W, number:usize, line:&u8[]) -> core.Result<void,io.Error> {
    var digits:u8[20];
    match (numeric.formatUint(number.(u64), 10, digits[:])) {
        Ok(count) => {
            var prefix = digits[:count];
            io.writeAll(output, &prefix)?;
        }
        Err(error) => return core.Result<void,io.Error>.Err(
            io.Error{
                kind:io.ErrorKind.InvalidInput,
                domain:io.ErrorDomain.Library,
                code:0,
                transferred:0
            }
        );
    }
    var colon = text.bytes(":");
    io.writeAll(output, &colon)?;
    io.writeAll(output, line)?;
    var newline = text.bytes("\n");
    io.writeAll(output, &newline)?;
    return core.Result<void,io.Error>.Ok;
}

// Bounded streaming works with files, stdin or a memory reader using the same contract.
func search<R:io.Reader,W:io.Writer>(
    input:&mut R,
    output:&mut W,
    pattern:&u8[],
    ignoreCase:bit
) -> core.Result<usize,io.Error> {
    var buffer:u8[4096];
    var destination = buffer[:];
    var line = collections.list<u8>();
    var number:usize = 1;
    var matches:usize = 0;
    while (true) {
        var count = input.read(&mut destination)?;
        if (count == 0) {
            break;
        }
        for (var i:usize = 0; i < count; i += 1) {
            if (buffer[i] == 10) {
                var content = line.view();
                if (contains(&content, pattern, ignoreCase)) {
                    emit(output, number, &content)?;
                    matches += 1;
                }
                line.clear();
                number += 1;
            } else {
                if (line.length() == 1048576) {
                    return core.Result<usize,io.Error>.Err(
                        io.Error{
                            kind:io.ErrorKind.LimitExceeded,
                            domain:io.ErrorDomain.Library,
                            code:0,
                            transferred:0
                        }
                    );
                }
                line.append(buffer[i])?;
            }
        }
    }
    if (line.length() > 0) {
        var content = line.view();
        if (contains(&content, pattern, ignoreCase)) {
            emit(output, number, &content)?;
            matches += 1;
        }
    }
    return core.Result<usize,io.Error>.Ok(matches);
}

func run() -> int {
    match (process.args()) {
        Err(error) => {
            io.println("Could not read arguments");
            return 2;
        }
        Ok(arguments) => {
            if (arguments.length() < 2 || arguments.length() > 3) {
                io.println(
                    "Usage: mini_grep PATTERN FILE [--ignore-case] (FILE may be - for stdin)"
                );
                return 2;
            }
            var ignoreCase = false;
            if (arguments.length() == 3) {
                var option = arguments.get(2).view();
                if (option.length() != 13 || !option.startsWith("--ignore-case")) {
                    io.println("Unknown option");
                    return 2;
                }
                ignoreCase = true;
            }
            var needle:u8[4096];
            var needleStorage = needle[:];
            match (arguments.get(0).copyBytes(&mut needleStorage)) {
                Err(error) => {
                    io.println("Pattern exceeds 4096 bytes");
                    return 2;
                }
                Ok(size) => {
                    var pattern = needle[:size];
                    var output = io.stdout();
                    var name = arguments.get(1).view();
                    var result:core.Result<usize,io.Error>;
                    if (name.length() == 1 && name.startsWith("-")) {
                        var input = io.stdin();
                        result = search(&mut input, &mut output, &pattern, ignoreCase);
                    } else {
                        var path:u8[4096];
                        var pathStorage = path[:];
                        match (name.copyBytes(&mut pathStorage)) {
                            Err(error) => {
                                io.println("Path exceeds 4096 bytes");
                                return 2;
                            }
                            Ok(length) => match (fs.open(path[:length], fs.OpenMode.Read)) {
                                Err(error) => {
                                    io.println("Could not open input file");
                                    return 2;
                                }
                                Ok(file) => result = search(
                                    &mut file,
                                    &mut output,
                                    &pattern,
                                    ignoreCase
                                );
                            }
                        }
                    }
                    match (result) {
                        Ok(count) => return if (count == 0) {
                            1
                        } else {
                            0
                        };
                        Err(error) => {
                            io.println("Read/write failed or a line exceeded 1 MiB");
                            return 2;
                        }
                    }
                }
            }
        }
    }
}

func main() -> int {
    return run();
}

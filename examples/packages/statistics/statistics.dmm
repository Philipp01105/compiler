package statistics;
import "stdlib";

pub struct Summary {
    pub var minimum:int;
    pub var maximum:int;
    pub var total:int;
}

struct PackageLifetime {
    destructor {
        stdlib.println("statistics package cleanup");
    }
}

// Package-stored values live until normal process termination.
var lifetime:PackageLifetime;

pub func summarize(values:int[]) -> Summary {
    var result:Summary;
    if (values.length == 0) { return result; }

    result.minimum=values[0];
    result.maximum=values[0];
    for (var index:int=0; index < values.length; index+=1) {
        var value:int=values[index];
        if (value < result.minimum) { result.minimum=value; }
        if (value > result.maximum) { result.maximum=value; }
        result.total+=value;
    }
    return result;
}

pub func average(summary:Summary, count:usize) -> double {
    if (count == 0) { return 0.0; }
    return summary.total.(double)/count.(double);
}

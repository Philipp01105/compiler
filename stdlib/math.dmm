#import <stdlib/core.dmm>

// ============== BASIC MATH ==============

// Power function: base^exponent
func pow(base:int, exponent:int) -> int {
    if (exponent == 0) {
        return 1;
    }
    if (exponent < 0) {
        return 0;  // Integer division would give 0 anyway
    }
    
    var result:int = 1;
    var i:int = 0;
    for (i = 0; i < exponent; i = i + 1) {
        result = result * base;
    }
    return result;
}

// Square of a number
func square(n:int) -> int {
    return n * n;
}

// Cube of a number
func cube(n:int) -> int {
    return n * n * n;
}

// Integer square root (floor)
func sqrt(n:int) -> int {
    if (n < 0) {
        return 0;
    }
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    
    var x:int = n / 2;
    var i:int = 0;
    
    // Newton's method with integer arithmetic
    for (i = 0; i < 20; i = i + 1) {
        var x_new:int = (x + (n / x)) / 2;
        if (x_new >= x) {
            return x;
        }
        x = x_new;
    }
    
    return x;
}

// ============== NUMBER THEORY ==============

// Greatest Common Divisor using Euclidean algorithm
func gcd(a:int, b:int) -> int {
    var aa:int = abs(a);
    var bb:int = abs(b);
    var temp:int = 0;
    
    for (temp = 0; bb != 0; temp = 0) {
        temp = bb;
        bb = aa % bb;
        aa = temp;
    }
    return aa;
}

// Least Common Multiple
func lcm(a:int, b:int) -> int {
    if (a == 0) {
        return 0;
    }
    if (b == 0) {
        return 0;
    }
    return abs(a * b) / gcd(a, b);
}

// Check if number is prime
func isPrime(n:int) -> bit {
    if (n < 2) {
        return 0;
    }
    if (n == 2) {
        return 1;
    }
    if (isEven(n) == 1) {
        return 0;
    }
    
    var i:int = 3;
    var limit:int = sqrt(n);
    
    for (i = 3; i <= limit; i = i + 2) {
        if ((n % i) == 0) {
            return 0;
        }
    }
    return 1;
}

// Factorial
func factorial(n:int) -> int {
    if (n < 0) {
        return 0;
    }
    if (n == 0) {
        return 1;
    }
    if (n == 1) {
        return 1;
    }
    
    var result:int = 1;
    var i:int = 2;
    for (i = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// Fibonacci number (iterative)
func fibonacci(n:int) -> int {
    if (n <= 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    
    var a:int = 0;
    var b:int = 1;
    var i:int = 2;
    
    for (i = 2; i <= n; i = i + 1) {
        var temp:int = a + b;
        a = b;
        b = temp;
    }
    
    return b;
}

// Sum of integers from 1 to n
func sum(n:int) -> int {
    return (n * (n + 1)) / 2;
}

// Sum of integers from start to end (inclusive)
func sumRange(start:int, end:int) -> int {
    if (start > end) {
        return 0;
    }
    return sum(end) - sum(start - 1);
}

// ============== DIGIT OPERATIONS ==============

// Count number of digits in integer
func digitCount(n:int) -> int {
    if (n == 0) {
        return 1;
    }
    
    var count:int = 0;
    var temp:int = abs(n);
    
    for (count = 0; temp > 0; temp = temp / 10) {
        count = count + 1;
    }
    
    return count;
}

// Sum of digits
func digitSum(n:int) -> int {
    var sum:int = 0;
    var temp:int = abs(n);
    
    for (temp = abs(n); temp > 0; temp = temp / 10) {
        sum = sum + (temp % 10);
    }
    
    return sum;
}

// Reverse digits of a number
func digitReverse(n:int) -> int {
    var result:int = 0;
    var temp:int = abs(n);
    var isNeg:bit = 0;
    
    if (n < 0) {
        isNeg = 1;
    }
    
    for (temp = abs(n); temp > 0; temp = temp / 10) {
        result = (result * 10) + (temp % 10);
    }
    
    if (isNeg == 1) {
        return -result;
    }
    return result;
}

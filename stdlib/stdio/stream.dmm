package stdio;
import "stdlib/core";

pub enum Status {
    pub Ok,
    pub EndOfStream,
    pub Closed,
    pub AccessDenied,
    pub NoProgress,
    pub SystemError,
    pub OutOfMemory,
    pub LimitReached,
    pub InvalidInput
}

// count always reports progress, including partial progress before an error.
// error preserves the OS error when status is SystemError; other statuses use 0.
pub struct Transfer {
    pub var count:usize;
    pub var status:Status;
    pub var error:isize;
    pub func ok() -> bit { return status == Status.Ok; }
}
pub struct ByteResult {
    pub var value:u8;
    pub var status:Status;
    pub var error:isize;
}
func transfer(count:usize, status:Status, error:isize) -> Transfer {
    var result:Transfer; result.count=count; result.status=status; result.error=error; return result;
}
// A portable single operation stays within both targets' transfer limits.
const CHUNK:usize=1073741824;
func subview(bytes:u8[], start:usize, count:usize) -> u8[] {
    return slice(core.core_offset(bytes.data,start.(isize)),count);
}

func readFrom(fd:int, active:bit, readable:bit, destination:u8[]) -> Transfer {
    if (!active) { return transfer(0,Status.Closed,0); }
    if (!readable) { return transfer(0,Status.AccessDenied,0); }
    if (destination.length == 0) { return transfer(0,Status.Ok,0); }
    var count:usize=destination.length; if (count > CHUNK) { count=CHUNK; }
    var result:isize=core.core_read(fd,destination.data,count);
    if (result < 0) { return transfer(0,Status.SystemError,result); }
    if (result == 0) { return transfer(0,Status.EndOfStream,0); }
    return transfer(result.(usize),Status.Ok,0);
}
func writeTo(fd:int, active:bit, writable:bit, source:u8[]) -> Transfer {
    if (!active) { return transfer(0,Status.Closed,0); }
    if (!writable) { return transfer(0,Status.AccessDenied,0); }
    if (source.length == 0) { return transfer(0,Status.Ok,0); }
    var count:usize=source.length; if (count > CHUNK) { count=CHUNK; }
    var result:isize=core.core_write(fd,source.data,count);
    if (result < 0) { return transfer(0,Status.SystemError,result); }
    if (result == 0) { return transfer(0,Status.NoProgress,0); }
    return transfer(result.(usize),Status.Ok,0);
}
func writeAllTo(fd:int, active:bit, writable:bit, source:u8[]) -> Transfer {
    if (source.length == 0) { return writeTo(fd,active,writable,source); }
    var total:usize=0;
    while (total < source.length) {
        var result:Transfer=writeTo(fd,active,writable,subview(source,total,source.length-total));
        total+=result.count;
        if (!result.ok()) { return transfer(total,result.status,result.error); }
    }
    return transfer(total,Status.Ok,0);
}

// Explicitly owned descriptor, or a borrowed descriptor for standard streams.
// Do not copy an owning Stream: DMM does not yet enforce move-only resources.
pub struct Stream {
    var fd:int;
    var active:bit;
    var readable:bit;
    var writable:bit;
    var owned:bit;
    var error:isize;
    pub func isOpen() -> bit { return active; }
    pub func canRead() -> bit { return active && readable; }
    pub func canWrite() -> bit { return active && writable; }
    pub func lastError() -> isize { return error; }
    pub func descriptor() -> int { if (!active) { return -1; } return fd; }

    // close is idempotent. Borrowed descriptors are detached, never OS-closed.
    // A failed OS close still invalidates this wrapper; do not retry that descriptor.
    pub func close() -> isize {
        if (!active) { return 0; }
        active=false;
        if (!owned) { return 0; }
        var result:isize=core.core_close(fd); fd=-1;
        if (result < 0) { error=result; }
        return result;
    }
    pub func read(destination:u8[]) -> Transfer {
        var result:Transfer=readFrom(fd,active,readable,destination);
        if (result.error < 0) { error=result.error; } return result;
    }
    pub func write(source:u8[]) -> Transfer {
        var result:Transfer=writeTo(fd,active,writable,source);
        if (result.error < 0) { error=result.error; } return result;
    }
    pub func readExact(destination:u8[]) -> Transfer {
        if (destination.length == 0) { return readFrom(fd,active,readable,destination); }
        var total:usize=0;
        while (total < destination.length) {
            var result:Transfer=readFrom(fd,active,readable,subview(destination,total,destination.length-total));
            total+=result.count;
            if (!result.ok()) { if (result.error < 0) { error=result.error; } return transfer(total,result.status,result.error); }
        }
        return transfer(total,Status.Ok,0);
    }
    pub func writeAll(source:u8[]) -> Transfer {
        var result:Transfer=writeAllTo(fd,active,writable,source);
        if (result.error < 0) { error=result.error; } return result;
    }
    // Strings are borrowed for the operation; binary data should use u8[] directly.
    pub func writeString(text:string) -> Transfer {
        var result:Transfer=writeAllTo(fd,active,writable,slice(core.core_string_data(text),core.core_string_length(text)));
        if (result.error < 0) { error=result.error; } return result;
    }
    pub func writeLine(text:string) -> Transfer {
        var result:Transfer=writeAllTo(fd,active,writable,slice(core.core_string_data(text),core.core_string_length(text)));
        if (result.error < 0) { error=result.error; }
        if (!result.ok()) { return result; }
        var newline:Transfer=writeAllTo(fd,active,writable,slice(core.core_string_data("\n"),1));
        if (newline.error < 0) { error=newline.error; }
        return transfer(result.count+newline.count,newline.status,newline.error);
    }
    pub func readByte() -> ByteResult {
        var bytes:u8[1]; var readResult:Transfer=readFrom(fd,active,readable,bytes);
        if (readResult.error < 0) { error=readResult.error; }
        var result:ByteResult; result.status=readResult.status; result.error=readResult.error;
        if (readResult.count == 1) { result.value=bytes[0]; }
        return result;
    }
}

// Borrow an existing descriptor without transferring its ownership.
pub func borrow(fd:int, readable:bit, writable:bit) -> Stream {
    var stream:Stream; stream.fd=fd; stream.readable=readable; stream.writable=writable;
    stream.active=fd >= 0 && (readable || writable);
    if (fd < 0) { stream.error=fd; }
    return stream;
}
func openFile(path:string, flags:int, readable:bit, writable:bit) -> Stream {
    var fd:int=core.core_open(path,flags,384);
    var stream:Stream=borrow(fd,readable,writable); stream.owned=stream.active; return stream;
}
// Failed opens return a closed stream with the negative OS error in lastError().
pub func openRead(path:string) -> Stream { return openFile(path,core.CORE_READ_ONLY,true,false); }
pub func openWrite(path:string) -> Stream { return openFile(path,core.CORE_WRITE_ONLY+core.CORE_CREATE+core.CORE_TRUNCATE,false,true); }
pub func openAppend(path:string) -> Stream { return openFile(path,core.CORE_WRITE_ONLY+core.CORE_CREATE+core.CORE_APPEND,false,true); }
pub func openReadWrite(path:string) -> Stream { return openFile(path,core.CORE_READ_WRITE+core.CORE_CREATE,true,true); }
pub func stdin() -> Stream { return borrow(core.CORE_STDIN,true,false); }
pub func stdout() -> Stream { return borrow(core.CORE_STDOUT,false,true); }
pub func stderr() -> Stream { return borrow(core.CORE_STDERR,false,true); }

// Copy until EOF using borrowed scratch storage. A failure retains written progress.
pub func copy(source:*Stream, destination:*Stream, scratch:u8[]) -> Transfer {
    if (source == core.null<Stream>() || destination == core.null<Stream>() || scratch.length == 0) { return transfer(0,Status.InvalidInput,0); }
    var total:usize=0;
    while (true) {
        var readResult:Transfer=source.read(scratch);
        if (readResult.status == Status.EndOfStream) { return transfer(total,Status.Ok,0); }
        if (!readResult.ok()) { return transfer(total,readResult.status,readResult.error); }
        var written:Transfer=destination.writeAll(subview(scratch,0,readResult.count));
        total+=written.count;
        if (!written.ok()) { return transfer(total,written.status,written.error); }
    }
    return transfer(total,Status.Ok,0);
}

package stdio;
import (
    core "stdlib/core/raw"
);

// Decimal integer output is DMM arithmetic, including both 64-bit extremes.
pub func writeUint(destination: *Stream, value: u64) -> Transfer {
    if (destination == core.null<Stream>()) {
        return transfer(0, Status.InvalidInput, 0);
    }
    var digits: u8[20];
    var position: usize = 20;
    while (value >= 10) {
        position -= 1;
        digits[position] = (48.(u64) + value % 10).(u8);
        value /= 10;
    }
    position -= 1;
    digits[position] = (48.(u64) + value).(u8);
    return (*destination).writeAll(subview(digits, position, 20 - position));
}

pub func writeInt(destination: *Stream, value: i64) -> Transfer {
    if (destination == core.null<Stream>()) {
        return transfer(0, Status.InvalidInput, 0);
    }
    var digits: u8[21];
    var position: usize = 21;
    var negative: bit = value < 0;
    var magnitude: u64 = value.(u64);
    if (negative) {
        magnitude = 0.(u64) - magnitude;
    }
    while (magnitude >= 10) {
        position -= 1;
        digits[position] = (48.(u64) + magnitude % 10).(u8);
        magnitude /= 10;
    }
    position -= 1;
    digits[position] = (48.(u64) + magnitude).(u8);
    if (negative) {
        position -= 1;
        digits[position] = 45;
    }
    return (*destination).writeAll(subview(digits, position, 21 - position));
}

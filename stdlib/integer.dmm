package stdlib;
import "stdlib/core";
// Fixed-width integer output uses DMM arithmetic and raw byte writes.
pub func print_fixed_unsigned(value:u64) -> void {
    var digits:u8[20];
    var position:int = 20;
    while (value >= 10) {
        position -= 1;
        digits[position] = (48.(u64) + value % 10).(u8);
        value /= 10;
    }
    position -= 1;
    digits[position] = (48.(u64) + value).(u8);
    core.core_write(core.CORE_STDOUT, (&digits[position]).(*u8), (20-position).(usize));
}
pub func print_fixed_signed(value:i64) -> void {
    if (value < 0) {
        core.core_write(core.CORE_STDOUT, core.core_string_data("-"), 1);
        print_fixed_unsigned(0.(u64) - value.(u64));
    } else { print_fixed_unsigned(value.(u64)); }
}
pub func print(value:i8) -> void { print_fixed_signed(value); }
pub func print(value:u8) -> void { print_fixed_unsigned(value); }
pub func print(value:i16) -> void { print_fixed_signed(value); }
pub func print(value:u16) -> void { print_fixed_unsigned(value); }
pub func print(value:i32) -> void { print_fixed_signed(value); }
pub func print(value:u32) -> void { print_fixed_unsigned(value); }
pub func print(value:i64) -> void { print_fixed_signed(value); }
pub func print(value:u64) -> void { print_fixed_unsigned(value); }
pub func print(value:isize) -> void { print_fixed_signed(value); }
pub func print(value:usize) -> void { print_fixed_unsigned(value); }
pub func println(value:i8) -> void { print(value); println(""); }
pub func println(value:u8) -> void { print(value); println(""); }
pub func println(value:i16) -> void { print(value); println(""); }
pub func println(value:u16) -> void { print(value); println(""); }
pub func println(value:i32) -> void { print(value); println(""); }
pub func println(value:u32) -> void { print(value); println(""); }
pub func println(value:i64) -> void { print(value); println(""); }
pub func println(value:u64) -> void { print(value); println(""); }
pub func println(value:isize) -> void { print(value); println(""); }
pub func println(value:usize) -> void { print(value); println(""); }

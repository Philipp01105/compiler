// =================================================================
// STANDARD LIBRARY - CORE MODULE
// =================================================================
// Provides essential primitive operations and utilities
// =================================================================

// ============== INTEGER OPERATIONS ==============

// Returns absolute value of integer
func abs(n:int) -> int {
    if (n < 0) {
        return -n;
    }
    return n;
}

// Returns minimum of two integers
func min(a:int, b:int) -> int {
    if (a < b) {
        return a;
    }
    return b;
}

// Returns maximum of two integers
func max(a:int, b:int) -> int {
    if (a > b) {
        return a;
    }
    return b;
}

// Clamps value between min and max
func clamp(value:int, minVal:int, maxVal:int) -> int {
    if (value < minVal) {
        return minVal;
    }
    if (value > maxVal) {
        return maxVal;
    }
    return value;
}

// Returns sign of integer (-1, 0, or 1)
func sign(n:int) -> int {
    if (n < 0) {
        return -1;
    }
    if (n > 0) {
        return 1;
    }
    return 0;
}

// Checks if integer is even
func isEven(n:int) -> bit {
    return (n % 2) == 0;
}

// Checks if integer is odd
func isOdd(n:int) -> bit {
    return (n % 2) != 0;
}

// ============== BOOLEAN OPERATIONS ==============

// Logical NOT
func not(b:bit) -> bit {
    if (b == 1) {
        return 0;
    }
    return 1;
}

// Logical AND
func and(a:bit, b:bit) -> bit {
    if (a == 1) {
        if (b == 1) {
            return 1;
        }
    }
    return 0;
}

// Logical OR
func or(a:bit, b:bit) -> bit {
    if (a == 1) {
        return 1;
    }
    if (b == 1) {
        return 1;
    }
    return 0;
}

// Logical XOR
func xor(a:bit, b:bit) -> bit {
    if (a == b) {
        return 0;
    }
    return 1;
}

// ============== CHARACTER OPERATIONS ==============

// Checks if character is uppercase letter (A-Z)
func isUpper(c:char) -> bit {
    if (c >= 'A') {
        if (c <= 'Z') {
            return 1;
        }
    }
    return 0;
}

// Checks if character is lowercase letter (a-z)
func isLower(c:char) -> bit {
    if (c >= 'a') {
        if (c <= 'z') {
            return 1;
        }
    }
    return 0;
}

// Checks if character is a letter (A-Z or a-z)
func isAlpha(c:char) -> bit {
    return or(isUpper(c), isLower(c));
}

// Checks if character is a digit (0-9)
func isDigit(c:char) -> bit {
    if (c >= '0') {
        if (c <= '9') {
            return 1;
        }
    }
    return 0;
}

// Checks if character is alphanumeric
func isAlnum(c:char) -> bit {
    return or(isAlpha(c), isDigit(c));
}

// Checks if character is whitespace
func isSpace(c:char) -> bit {
    if (c == ' ') {
        return 1;
    }
    if (c == '\t') {
        return 1;
    }
    if (c == '\n') {
        return 1;
    }
    if (c == '\r') {
        return 1;
    }
    return 0;
}

// Convert uppercase letter to lowercase
func toLower(c:char) -> char {
    if (isUpper(c) == 1) {
        return c + 32;
    }
    return c;
}

// Convert lowercase letter to uppercase
func toUpper(c:char) -> char {
    if (isLower(c) == 1) {
        return c - 32;
    }
    return c;
}

// ============== UTILITY FUNCTIONS ==============

// Swaps two integers (requires passing by reference, so uses array trick)
func swap(arr[]:int, i:int, j:int) -> void {
    var temp:int = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

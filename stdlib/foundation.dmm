// Compile-time containers and capabilities. Pointer/string ownership stays explicit.
enum Option<T> { Some(T), None, }
enum Result<T,E> { Ok(T), Err(E), }
struct Cell<T> {
    var value:T;
    func get() -> T { return value; }
    func set(newValue:T) -> void { value=newValue; }
}
trait Printable { func toString() -> string; }
trait Equal { func equal(other:Self) -> bit; }
func unwrapOr<T>(value:Option<T>,fallback:T) -> T {
    match (value) {
        Some(v) => return v;
        None => return fallback;
    }
}
func printValue<T:Printable>(value:T) -> void { print(value.toString()); }

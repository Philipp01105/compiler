package stdlib;
// Standard I/O surface implemented in DMM over the typed runtime intrinsics.
pub struct Input {
    pub func init() -> void {}
    pub func readInt() -> int { return scanfInt(); }
    pub func readChar() -> char { return scanfChar(); }
    pub func readString() -> string { return scanfString(); }
}

pub enum System(pub fd:int) {
    pub in(0),
    pub out(1),
    pub err(2)
}

pub func open_read(path:string) -> int {
    return sys_open(path, 0, 0);
}

pub func open_write(path:string) -> int {
    return sys_open(path, 577, 384);
}

pub func close_file(fd:int) -> int {
    return sys_close(fd);
}

pub func write_str_to(fd:int, text:string) -> int {
    return sys_write(fd, text, io_strlen(text));
}

pub func write_file(path:string, text:string) -> int {
    var fd:int = open_write(path);
    if (fd < 0) { return fd; }
    var result:int = write_str_to(fd, text);
    close_file(fd);
    if (result < 0) { return result; }
    return 0;
}

pub func read_file(path:string, buffer:char[], capacity:int) -> int {
    var fd:int = open_read(path);
    if (fd < 0) { return fd; }
    var result:int = sys_read(fd, buffer, capacity);
    close_file(fd);
    return result;
}

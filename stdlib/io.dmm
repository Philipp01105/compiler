package stdlib;
import core "stdlib/core/raw";
import "stdlib/stdio";
// Compatibility input scanning. New byte-oriented I/O uses stdlib/stdio streams.
pub struct Input {
    pub func init() -> void {}
    pub func readInt() -> int { return scanfInt(); }
    pub func readChar() -> char { return scanfChar(); }
    pub func readString() -> string { return scanfString(); }
}

pub enum System(pub fd:int) {
    pub in(0),
    pub out(1),
    pub err(2)
}

pub func open_read(path:string) -> int {
    return core.core_open(path,core.CORE_READ_ONLY,0);
}

pub func open_write(path:string) -> int {
    return core.core_open(path,core.CORE_WRITE_ONLY+core.CORE_CREATE+core.CORE_TRUNCATE,384);
}

pub func close_file(fd:int) -> int {
    return core.core_close(fd);
}

pub func write_str_to(fd:int, text:string) -> int {
    if (core.core_string_length(text) > 2147483647.(usize)) { return -1; }
    var stream=stdio.borrow(fd,false,true);
    var result=stream.writeString(text);
    if (!result.ok()) { if (result.error < 0) { return result.error.(int); } return -1; }
    return result.count.(int);
}

pub func write_file(path:string, text:string) -> int {
    var stream=stdio.openWrite(path);
    if (!stream.isOpen()) { return stream.lastError().(int); }
    var result=stream.writeString(text);
    var closed:isize=stream.close();
    if (!result.ok()) { if (result.error < 0) { return result.error.(int); } return -1; }
    if (closed < 0) { return closed.(int); }
    return 0;
}

pub func read_file(path:string, buffer:char[], capacity:int) -> int {
    if (capacity < 0 || capacity.(usize) > buffer.length) { return -1; }
    var stream=stdio.openRead(path);
    if (!stream.isOpen()) { return stream.lastError().(int); }
    var result=stream.read(slice(buffer.data.(*u8),capacity.(usize)));
    var closed:isize=stream.close();
    if (result.status != stdio.Status.Ok && result.status != stdio.Status.EndOfStream) {
        if (result.error < 0) { return result.error.(int); } return -1;
    }
    if (closed < 0) { return closed.(int); }
    return result.count.(int);
}

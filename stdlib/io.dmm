// =================================================================
// STANDARD LIBRARY - I/O MODULE
// =================================================================
// Provides input/output operations using compiler built-ins
// Built-in functions: scanfInt(), scanfChar(), scanfString()
// =================================================================

// Read an integer from standard input
func readInt() -> int {
    return scanfInt();
}

// Read a character from standard input
func readChar() -> char {
    return scanfChar();
}

// Read a string from standard input
func readString() -> string {
    return scanfString();
}

// Print with newline
func println(s:string) -> void {
    print(s);
    print("\n");
}

// Print an integer
func printInt(n:int) -> void {
    print(n);
}

// Print an integer with newline
func printlnInt(n:int) -> void {
    print(n);
    print("\n");
}

// Print a character
func printChar(c:char) -> void {
    print(c);
}

// Print a character with newline
func printlnChar(c:char) -> void {
    print(c);
    print("\n");
}

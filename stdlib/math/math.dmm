package math;
extern "system" {
    union DoubleBits {
        var value:double;
        var bits:u64;
    }
}

pub const PI:double = 3.14159265358979323846264338327950288;

pub const TAU:double = 6.28318530717958647692528676655900576;

pub const E:double = 2.7182818284590452353602874713526625;

pub func isNaN(value:double) -> bit {
    var word:DoubleBits;
    word.value = value;
    return word.bits % 9223372036854775808.(u64) > 9218868437227405312.(u64);
}

pub func isFinite(value:double) -> bit {
    var word:DoubleBits;
    word.value = value;
    return word.bits % 9223372036854775808.(u64) < 9218868437227405312.(u64);
}

pub func abs(value:double) -> double {
    return nativeAbs(value);
}

pub func sqrt(value:double) -> double {
    return nativeSqrt(value);
}

pub func sin(value:double) -> double {
    return nativeSin(value);
}

pub func cos(value:double) -> double {
    return nativeCos(value);
}

pub func tan(value:double) -> double {
    return nativeTan(value);
}

pub func log(value:double) -> double {
    return nativeLog(value);
}

pub func exp(value:double) -> double {
    return nativeExp(value);
}

pub func pow(value:double, exponent:double) -> double {
    return nativePow(value, exponent);
}

pub func floor(value:double) -> double {
    return nativeFloor(value);
}

pub func ceil(value:double) -> double {
    return nativeCeil(value);
}

pub func trunc(value:double) -> double {
    return nativeTrunc(value);
}

pub func remainder(value:double, divisor:double) -> double {
    return nativeRemainder(value, divisor);
}

pub func min(a:double, b:double) -> double {
    if (isNaN(a)) {
        return a;
    }
    if (isNaN(b)) {
        return b;
    }
    if (a == 0.0 && b == 0.0) {
        var word:DoubleBits;
        word.value = a;
        if (word.bits >= 9223372036854775808.(u64)) {
            return a;
        }
        return b;
    }
    if (a < b) {
        return a;
    }
    return b;
}

pub func max(a:double, b:double) -> double {
    if (isNaN(a)) {
        return a;
    }
    if (isNaN(b)) {
        return b;
    }
    if (a == 0.0 && b == 0.0) {
        var word:DoubleBits;
        word.value = a;
        if (word.bits < 9223372036854775808.(u64)) {
            return a;
        }
        return b;
    }
    if (a > b) {
        return a;
    }
    return b;
}

pub func clamp(value:double, low:double, high:double) -> double {
    if (value < low) {
        return low;
    }
    if (value > high) {
        return high;
    }
    return value;
}

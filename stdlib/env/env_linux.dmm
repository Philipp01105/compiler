package env;
import (
    "stdlib"
    raw "stdlib/core/raw"
);
extern "system" from "c" {
    func getenv(name: *u8) -> *u8;
    func setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
    func unsetenv(name: *u8) -> i32;
    func errnoAddress() -> *i32 = "__errno_location";
}

func terminated(value: u8[]) -> stdlib.Result<stdlib.Bytes, EnvError> {
    if (value.length >= 9223372036854775807.(usize)) {
        return stdlib.Result<stdlib.Bytes, EnvError>.Err(failure(ErrorKind.OutOfMemory, 0));
    }
    var output = stdlib.bytes(value.length + 1);
    if (
        output.append(value) != stdlib.AllocationError.None ||
        output.push(0) != stdlib.AllocationError.None
    ) {
        return stdlib.Result<stdlib.Bytes, EnvError>.Err(failure(ErrorKind.OutOfMemory, 0));
    }
    return stdlib.Result<stdlib.Bytes, EnvError>.Ok(output);
}

func nativeGet(name: u8[]) -> stdlib.Result<stdlib.Bytes, EnvError> {
    if (!validName(name)) {
        return stdlib.Result<stdlib.Bytes, EnvError>.Err(failure(ErrorKind.InvalidName, 0));
    }
    var converted = terminated(name);
    match (converted) {
        Err(error) => return stdlib.Result<stdlib.Bytes, EnvError>.Err(error);
        Ok(key) => {
            var view: u8[] = key.view();
            var pointer: *u8 = getenv(view.data);
            if (pointer == raw.null<u8>()) {
                return stdlib.Result<stdlib.Bytes, EnvError>.Err(failure(ErrorKind.Missing, 0));
            }
            var length: usize = 0;
            while (pointer[length] != 0) {
                length += 1;
            }
            var output = stdlib.bytes(length);
            if (output.append(slice(pointer, length)) != stdlib.AllocationError.None) {
                return stdlib.Result<stdlib.Bytes, EnvError>.Err(failure(ErrorKind.OutOfMemory, 0));
            }
            return stdlib.Result<stdlib.Bytes, EnvError>.Ok(output);
        }
    }
}

func nativeSet(name: u8[], value: u8[]) -> stdlib.Result<void, EnvError> {
    if (!validName(name)) {
        return stdlib.Result<void, EnvError>.Err(failure(ErrorKind.InvalidName, 0));
    }
    if (!validValue(value)) {
        return stdlib.Result<void, EnvError>.Err(failure(ErrorKind.InvalidValue, 0));
    }
    var a = terminated(name);
    match (a) {
        Err(error) => return stdlib.Result<void, EnvError>.Err(error);
        Ok(key) => {
            var b = terminated(value);
            match (b) {
                Err(error) => return stdlib.Result<void, EnvError>.Err(error);
                Ok(data) => {
                    var av: u8[] = key.view();
                    var bv: u8[] = data.view();
                    if (setenv(av.data, bv.data, 1) != 0) {
                        return stdlib.Result<void, EnvError>.Err(
                            failure(ErrorKind.System, (*errnoAddress()).(isize))
                        );
                    }
                    return stdlib.Result<void, EnvError>.Ok;
                }
            }
        }
    }
}

func nativeRemove(name: u8[]) -> stdlib.Result<void, EnvError> {
    if (!validName(name)) {
        return stdlib.Result<void, EnvError>.Err(failure(ErrorKind.InvalidName, 0));
    }
    var converted = terminated(name);
    match (converted) {
        Err(error) => return stdlib.Result<void, EnvError>.Err(error);
        Ok(key) => {
            var view: u8[] = key.view();
            if (unsetenv(view.data) != 0) {
                return stdlib.Result<void, EnvError>.Err(
                    failure(ErrorKind.System, (*errnoAddress()).(isize))
                );
            }
            return stdlib.Result<void, EnvError>.Ok;
        }
    }
}

package env;
import (
    "stdlib"
);

pub enum ErrorKind {
    pub Missing,
    pub InvalidName,
    pub InvalidValue,
    pub OutOfMemory,
    pub System,
}

pub struct EnvError {
    pub var kind: ErrorKind;
    pub var code: isize;
}

pub func get(name: u8[]) -> stdlib.Result<stdlib.Bytes, EnvError> {
    return nativeGet(name);
}

pub func set(name: u8[], value: u8[]) -> stdlib.Result<void, EnvError> {
    return nativeSet(name, value);
}

pub func remove(name: u8[]) -> stdlib.Result<void, EnvError> {
    return nativeRemove(name);
}

func failure(kind: ErrorKind, code: isize) -> EnvError {
    return EnvError{ kind: kind, code: code };
}

func validName(name: u8[]) -> bit {
    if (name.length == 0) {
        return false;
    }
    for (var i: usize = 0; i < name.length; i += 1) {
        if (name[i] == 0 || name[i] == 61) {
            return false;
        }
    }
    return true;
}

func validValue(value: u8[]) -> bit {
    for (var i: usize = 0; i < value.length; i += 1) {
        if (value[i] == 0) {
            return false;
        }
    }
    return true;
}

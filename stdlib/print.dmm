package stdlib;
// Ordinary overloaded output functions. Conversion is expressed in DMM through
// string concatenation; byte output remains the neutral sys_write intrinsic.
pub func print(value:string) -> void { write_str_to(1, value); }
pub func println(value:string) -> void {
    var text:string = value + "\n";
    write_str_to(1, text);
    free(text);
}

pub func print(value:int) -> void {
    var text:string = "" + value;
    write_str_to(1, text);
    free(text);
}
pub func println(value:int) -> void {
    var text:string = "" + value + "\n";
    write_str_to(1, text);
    free(text);
}


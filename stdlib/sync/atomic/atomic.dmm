package atomic;
import (
    "stdlib/core"
);

// The native boundary is four machine operations, not special DMM call names.
extern "system" from "dmm_runtime" {
    func atomicLoad(address:*usize) -> usize = "__dmm_core_atomic_load";

    func atomicStore(address:*usize, value:usize) -> void = "__dmm_core_atomic_store";

    func atomicSwap(address:*usize, value:usize) -> usize = "__dmm_core_atomic_swap";

    func atomicCompare(address:*usize, expected:usize, value:usize) -> usize = "__dmm_core_atomic_compare_exchange";
}

// All operations use sequentially consistent ordering. The storage address
// must remain aligned and must not be accessed non-atomically after sharing.
@[core.Send + core.Sync]
pub struct AtomicUsize {
    var value:usize;
    destructor {}

    pub func load() -> usize {
        return atomicLoad((&value).(*usize));
    }

    pub func store(next:usize) -> void {
        atomicStore((&value).(*usize), next);
    }

    pub func swap(next:usize) -> usize {
        return atomicSwap((&value).(*usize), next);
    }

    // Returns the previous value; equality with expected indicates success.

    pub func compareExchange(expected:usize, next:usize) -> usize {
        return atomicCompare((&value).(*usize), expected, next);
    }
}

pub func atomicUsize(initial:usize) -> AtomicUsize {
    var result:AtomicUsize;
    result.value = initial;
    return result;
}

@[core.Send + core.Sync]
pub struct AtomicBit {
    var value:usize;
    destructor {}

    pub func load() -> bit {
        return atomicLoad((&value).(*usize)) != 0.(usize);
    }

    pub func store(next:bit) -> void {
        atomicStore((&value).(*usize), next.(usize));
    }

    pub func swap(next:bit) -> bit {
        return atomicSwap((&value).(*usize), next.(usize)) != 0.(usize);
    }

    // Returns the previous value; equality with expected indicates success.

    pub func compareExchange(expected:bit, next:bit) -> bit {
        return atomicCompare((&value).(*usize), expected.(usize), next.(usize)) != 0.(usize);
    }
}

pub func atomicBit(initial:bit) -> AtomicBit {
    var result:AtomicBit;
    result.value = initial.(usize);
    return result;
}

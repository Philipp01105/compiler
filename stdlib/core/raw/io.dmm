package raw;

pub const CORE_STDIN: int = 0;

pub const CORE_STDOUT: int = 1;

pub const CORE_STDERR: int = 2;

pub const CORE_READ_ONLY: int = 0;

pub const CORE_WRITE_ONLY: int = 1;

pub const CORE_READ_WRITE: int = 2;

pub const CORE_CREATE: int = 64;

pub const CORE_TRUNCATE: int = 512;

pub const CORE_APPEND: int = 1024;

// Byte count or a negative error. Short reads/writes are returned unchanged.
pub func core_read(fd: int, destination: *u8, bytes: usize) -> isize {
    return __dmm_intrinsic_read(fd, destination, bytes);
}

pub func core_write(fd: int, source: *u8, bytes: usize) -> isize {
    return __dmm_intrinsic_write(fd, source, bytes);
}

pub func core_open(path: string, flags: int, permissions: int) -> int {
    return __dmm_intrinsic_open(path, flags, permissions);
}

pub func core_close(fd: int) -> int {
    return __dmm_intrinsic_close(fd);
}

// String traversal is ordinary DMM code, rather than a runtime string routine.
pub func core_string_length(text: string) -> usize {
    var data: *u8 = core_string_data(text);
    if (data == core_null()) {
        return 0;
    }
    var length: usize = 0;
    while (core_load(data, length) != 0) {
        length += 1;
    }
    return length;
}

package core;
import "stdlib/core/raw";
pub func alloc<T>() -> *T { return raw.alloc<T>(); }
pub func alloc<T>(count:usize) -> T[] { return raw.alloc<T>(count); }
pub func release<T>(data:*T) -> void { raw.release<T>(data); }
pub func release<T>(data:T[]) -> void { raw.release<T>(data); }
pub func null<T>() -> *T { return raw.null<T>(); }

package core;
// Byte counts use usize; offsets use isize. Regions are explicitly owned.
pub func core_alloc(bytes:usize) -> *u8 { return __dmm_intrinsic_alloc(bytes); }
pub func core_release(data:*u8) -> void { __dmm_intrinsic_release(data); }
pub func core_null() -> *u8 { return __dmm_intrinsic_null(); }
pub func core_offset(data:*u8, offset:isize) -> *u8 { return __dmm_intrinsic_offset(data, offset); }
pub func core_copy(destination:*u8, source:*u8, bytes:usize) -> void {
    __dmm_intrinsic_copy(destination, source, bytes);
}
pub func core_fill(destination:*u8, value:u8, bytes:usize) -> void {
    __dmm_intrinsic_fill(destination, value, bytes);
}
pub func core_load(data:*u8, offset:usize) -> u8 { return *core_offset(data, offset.(isize)); }
pub func core_store(data:*u8, offset:usize, value:u8) -> void {
    *core_offset(data, offset.(isize)) = value;
}
// Borrowed bytes, including a trailing NUL. Do not release or mutate this view.
pub func core_string_data(text:string) -> *u8 { return __dmm_intrinsic_string_data(text); }

package network;
extern "system" {
    align(8) struct NativeAddress {
        pub var family: u16;
        pub var padding: u8[126];
    }

    struct NativeIPv4 {
        pub var family: u16;
        pub var port: u16;
        pub var address: u8[4];
        pub var padding: u8[8];
    }

    struct NativeIPv6 {
        pub var family: u16;
        pub var port: u16;
        pub var flow: u32;
        pub var address: u8[16];
        pub var scope: u32;
    }

    union DropBits {
        pub var bits: usize;
        pub var callback: extern "system" func(*void) -> void;
    }
}

func nullDrop() -> extern "system" func(*void) -> void {
    var value: DropBits;
    return value.callback;
}

func swapPort(port: u16) -> u16 {
    return (port % 256) * 256 + port / 256;
}

func toNative(input: *Address, out: *NativeAddress, length: *i32) -> bit {
    var zero: NativeAddress;
    *out = zero;
    if (input.port > 65535 || input.scope > 4294967295) {
        return false;
    }
    if (input.family == 4) {
        var a: *NativeIPv4 = out.(*NativeIPv4);
        a.family = AF4;
        a.port = swapPort(input.port.(u16));
        var i: usize = 0;
        while (i < 4) {
            a.address[i] = input.bytes[i];
            i = i + 1;
        }
        *length = (NativeIPv4.size).(i32);
        return true;
    }
    if (input.family == 6) {
        var a: *NativeIPv6 = out.(*NativeIPv6);
        a.family = AF6;
        a.port = swapPort(input.port.(u16));
        a.scope = input.scope.(u32);
        var i: usize = 0;
        while (i < 16) {
            a.address[i] = input.bytes[i];
            i = i + 1;
        }
        *length = (NativeIPv6.size).(i32);
        return true;
    }
    return false;
}

func fromNative(input: *NativeAddress, out: *Address) -> bit {
    var zero: Address;
    *out = zero;
    if (input.family == AF4) {
        var a: *NativeIPv4 = input.(*NativeIPv4);
        out.family = 4;
        out.port = swapPort(a.port).(u64);
        var i: usize = 0;
        while (i < 4) {
            out.bytes[i] = a.address[i];
            i = i + 1;
        }
        return true;
    }
    if (input.family == AF6) {
        var a: *NativeIPv6 = input.(*NativeIPv6);
        out.family = 6;
        out.port = swapPort(a.port).(u64);
        out.scope = a.scope.(u64);
        var i: usize = 0;
        while (i < 16) {
            out.bytes[i] = a.address[i];
            i = i + 1;
        }
        return true;
    }
    return false;
}

func serviceName(port: u64, out: *u8) -> void {
    var digits: u8[5];
    var count: usize = 0;
    while (true) {
        digits[count] = (48 + port % 10).(u8);
        count = count + 1;
        port = port / 10;
        if (port == 0) {
            break;
        }
    }
    var index: usize = 0;
    while (index < count) {
        out[index] = digits[count - index - 1];
        index = index + 1;
    }
    out[count] = 0;
}

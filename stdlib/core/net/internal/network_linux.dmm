package network;
import (
    "stdlib/native/glibc"
    "stdlib/native/pthreads"
);
extern "system" from "c" {
    func abort() -> void;
    func reallocate(address: *void, size: usize) -> *void = "realloc";
    func stringLength(value: *u8) -> usize = "strlen";
    struct Iovec {
        pub var base: *void;
        pub var length: usize;
    }

    struct Message {
        pub var name: *void;
        pub var nameLength: u32;
        pub var vectors: *Iovec;
        pub var vectorCount: usize;
        pub var control: *void;
        pub var controlLength: usize;
        pub var flags: i32;
    }

    func recvMessage(fd: i32, message: *Message, flags: i32) -> isize = "recvmsg";
}

extern "system" {
    pub struct Operation {
        pub var request: Request;
        pub var error: Error;
        pub var peer: Address;
        pub var accepted: *Socket;
        pub var addresses: *Addresses;
        pub var io: *void;
        pub var refs: usize;
        pub var heapIndex: usize;
        pub var count: u64;
        pub var done: i32;
        pub var cancel: i32;
        pub var timeout: i32;
        pub var eof: i32;
        pub var truncated: i32;
        pub var started: i32;
        pub var notified: i32;
        pub var dnsActive: i32;
        pub var dnsQueued: i32;
        pub var hostname: *u8;
        pub var next: *Operation;
        pub var dnsNext: *Operation;
        pub var notifyNext: *Operation;
    }
}

const AF4: u16 = 2;
const AF6: u16 = 10;
var netMutex: pthreads.Mutex;
var dnsCondition: pthreads.Condition;
var epollFd: i32 = -1;
var commandFd: i32 = -1;

func lockNet() -> void {
    require(pthreads.mutexLock((&netMutex).(*pthreads.Mutex)) == 0);
}

func unlockNet() -> void {
    require(pthreads.mutexUnlock((&netMutex).(*pthreads.Mutex)) == 0);
}

func wakeDns() -> void {
    require(pthreads.conditionBroadcast((&dnsCondition).(*pthreads.Condition)) == 0);
}

func waitDns() -> void {
    require(
        pthreads.conditionWait(
            (&dnsCondition).(*pthreads.Condition),
            (&netMutex).(*pthreads.Mutex)
        ) == 0
    );
}

func allocate(size: usize) -> *void {
    return glibc.calloc(1, size);
}

func release(address: *void) -> void {
    glibc.release(address);
}

func copy(out: *void, input: *void, size: usize) -> void {
    glibc.memcpy(out, input, size);
}

func osError() -> i32 {
    return *glibc.errnoAddress();
}

func nativeError(code: i32) -> Error {
    var kind: u64 = 11;
    if (code == 111) {
        kind = 6;
    }
    if (code == 104 || code == 103 || code == 32) {
        kind = 7;
    }
    if (code == 101 || code == 113) {
        kind = 8;
    }
    if (code == 98) {
        kind = 9;
    }
    if (code == 12 || code == 105) {
        kind = 10;
    }
    if (code == 22 || code == 97) {
        kind = 5;
    }
    if (code == 110) {
        kind = 2;
    }
    return errorWith(kind, 1, code);
}

pub export "system" func __dmm_net_now() -> u64 {
    var value: glibc.Timespec;
    require(glibc.clockGettime(1, (&value).(*glibc.Timespec)) == 0);
    var seconds: u64 = value.seconds.(u64);
    var fraction: u64 = value.nanoseconds.(u64);
    if (seconds > NEVER / 1000000000) {
        return NEVER - 1;
    }
    var whole: u64 = seconds * 1000000000;
    if (fraction >= NEVER - whole) {
        return NEVER - 1;
    }
    return whole + fraction;
}

func closeFd(fd: usize) -> i32 {
    var result: i32 = glibc.close(fd.(i32));
    socketClosed();
    return result;
}

func wakeReactor() -> void {
    var one: u64 = 1;
    if (commandFd >= 0) {
        glibc.write(commandFd, (&one).(*void), 8);
    }
}

func initializeOs(error: *Error) -> bit {
    epollFd = glibc.epollCreate(524288);
    commandFd = glibc.eventfd(0, 526336);
    var event: glibc.EpollEvent;
    event.events = 1;
    if (
        epollFd < 0 ||
        commandFd < 0 ||
        glibc.epollControl(epollFd, 1, commandFd, (&event).(*glibc.EpollEvent)) != 0
    ) {
        *error = nativeError(osError());
        if (epollFd >= 0) {
            glibc.close(epollFd);
        }
        if (commandFd >= 0) {
            glibc.close(commandFd);
        }
        epollFd = -1;
        commandFd = -1;
        return false;
    }
    return true;
}

func newFd(family: u64, transport: u64, error: *Error) -> usize {
    var af: i32 = 2;
    if (family == 6) {
        af = 10;
    }
    var kind: i32 = 1;
    if (transport == 2) {
        kind = 2;
    }
    var fd: i32 = glibc.socket(af, kind + 526336, 0);
    if (fd < 0) {
        *error = nativeError(osError());
        return INVALID;
    }
    socketOpened();
    if (family == 6) {
        var one: i32 = 1;
        if (glibc.setsockopt(fd, 41, 26, (&one).(*void), 4) != 0) {
            *error = nativeError(osError());
            closeFd(fd.(usize));
            return INVALID;
        }
    }
    return fd.(usize);
}

func bindFd(fd: usize, address: *NativeAddress, length: i32) -> i32 {
    return glibc.bind(fd.(i32), address.(*glibc.Sockaddr), length.(u32));
}

func listenFd(fd: usize, backlog: i32) -> i32 {
    return glibc.listen(fd.(i32), backlog);
}

func shutdownFd(fd: usize, direction: i32) -> i32 {
    return glibc.shutdown(fd.(i32), direction);
}

func addressFd(fd: usize, peer: u64, address: *NativeAddress, length: *i32) -> i32 {
    if (peer != 0) {
        return glibc.getpeername(fd.(i32), address.(*glibc.Sockaddr), length.(*u32));
    }
    return glibc.getsockname(fd.(i32), address.(*glibc.Sockaddr), length.(*u32));
}

func interest(s: *Socket) -> u32 {
    var events: u32 = 0;
    if (s.read != nullPointer().(*Operation)) {
        events = events + 1;
    }
    if (s.write != nullPointer().(*Operation)) {
        events = events + 4;
    }
    return events;
}

func updateInterest(s: *Socket) -> void {
    if (s.fd == INVALID) {
        return;
    }
    var event: glibc.EpollEvent;
    event.events = interest(s);
    if (event.events != 0) {
        if (
            glibc.epollControl(epollFd, 3, s.fd.(i32), (&event).(*glibc.EpollEvent)) != 0 &&
            osError() == 2
        ) {
            glibc.epollControl(epollFd, 1, s.fd.(i32), (&event).(*glibc.EpollEvent));
        }
    } else {
        glibc.epollControl(epollFd, 2, s.fd.(i32), nullPointer().(*glibc.EpollEvent));
    }
}

func pending(op: *Operation) -> void {
    var event: glibc.EpollEvent;
    event.events = interest(op.request.socket);
    event.data.wide = 1;
    if (
        glibc.epollControl(
            epollFd,
            3,
            op.request.socket.fd.(i32),
            (&event).(*glibc.EpollEvent)
        ) != 0
    ) {
        if (
            osError() != 2 ||
            glibc.epollControl(
                epollFd,
                1,
                op.request.socket.fd.(i32),
                (&event).(*glibc.EpollEvent)
            ) != 0
        ) {
            completeLocked(op, nativeError(osError()));
        }
    }
}

func prepareOperation(op: *Operation) -> void {}

func cancelOs(op: *Operation) -> bit {
    return false;
}

func step(op: *Operation) -> void {
    var s: *Socket = op.request.socket;
    var command: u64 = op.request.command;
    if (command != 1) {
        op.started = 1;
    }
    var address: NativeAddress;
    var length: i32 = 0;
    var count: isize = -1;
    var code: i32 = 0;
    if (command == 1) {
        if (op.started == 0) {
            toNative(
                (&op.request.address).(*Address),
                (&address).(*NativeAddress),
                (&length).(*i32)
            );
            op.started = 1;
            var result: i32 = glibc.connect(
                s.fd.(i32),
                (&address).(*glibc.Sockaddr),
                length.(u32)
            );
            s.state = 1;
            if (result == 0) {
                completeLocked(op, netError(0));
                return;
            }
            code = osError();
            if (code == 115 || code == 114 || code == 4) {
                pending(op);
                return;
            }
        } else {
            var peer: NativeAddress;
            var peerSize: u32 = 128;
            var size: u32 = 4;
            if (
                glibc.getsockopt(
                    s.fd.(i32),
                    1,
                    4,
                    (&code).(*void),
                    (&size).(*u32)
                ) != 0
            ) {
                code = osError();
            }
            if (
                code == 0 &&
                glibc.getpeername(
                    s.fd.(i32),
                    (&peer).(*glibc.Sockaddr),
                    (&peerSize).(*u32)
                ) != 0
            ) {
                if (osError() == 107) {
                    pending(op);
                    return;
                }
                code = osError();
            }
        }
        if (code != 0) {
            completeLocked(op, nativeError(code));
        } else {
            completeLocked(op, netError(0));
        }
        return;
    }
    if (command == 2) {
        var size: u32 = 128;
        var fd: i32 = glibc.accept4(
            s.fd.(i32),
            (&address).(*glibc.Sockaddr),
            (&size).(*u32),
            526336
        );
        if (fd >= 0) {
            socketOpened();
            op.accepted = allocate(Socket.size).(*Socket);
            if (op.accepted == nullPointer().(*Socket)) {
                closeFd(fd.(usize));
                completeLocked(op, netError(10));
                return;
            }
            op.accepted.fd = fd.(usize);
            op.accepted.family = s.family;
            op.accepted.transport = 1;
            op.accepted.state = 3;
            fromNative((&address).(*NativeAddress), (&op.peer).(*Address));
            completeLocked(op, netError(0));
            return;
        }
    } else if (command == 3) {
        count = glibc.recv(
            s.fd.(i32),
            op.request.buffer,
            op.request.length.(usize),
            0
        );
    } else if (command == 4) {
        count = glibc.send(
            s.fd.(i32),
            op.request.buffer,
            op.request.length.(usize),
            16384
        );
    } else if (command == 6) {
        toNative(
            (&op.request.address).(*Address),
            (&address).(*NativeAddress),
            (&length).(*i32)
        );
        count = glibc.sendto(
            s.fd.(i32),
            op.request.buffer,
            op.request.length.(usize),
            16384,
            (&address).(*glibc.Sockaddr),
            length.(u32)
        );
    } else if (command == 5) {
        var buffer: Iovec;
        buffer.base = op.request.buffer;
        buffer.length = op.request.length.(usize);
        var message: Message;
        message.name = (&address).(*void);
        message.nameLength = 128;
        message.vectors = (&buffer).(*Iovec);
        message.vectorCount = 1;
        count = recvMessage(s.fd.(i32), (&message).(*Message), 0);
        if (count >= 0) {
            op.truncated = ((message.flags / 32) % 2 != 0).(i32);
            fromNative((&address).(*NativeAddress), (&op.peer).(*Address));
        }
    }
    if (count >= 0) {
        if (command == 6) {
            s.state = 1;
        }
        op.count = count.(u64);
        op.eof = (command == 3 && count == 0 && op.request.length != 0).(i32);
        completeLocked(op, netError(0));
        return;
    }
    code = osError();
    if (code == 4) {
        wakeReactor();
        return;
    }
    if (code != 11) {
        completeLocked(op, nativeError(code));
        return;
    }
    pending(op);
}

func waitReactor(timeout: i32) -> void {
    var events: glibc.EpollEvent[32];
    var count: i32 = glibc.epollWait(
        epollFd,
        (&events[0]).(*glibc.EpollEvent),
        32,
        timeout
    );
    require(count >= 0 || osError() == 4);
    var value: u64;
    while (glibc.read(commandFd, (&value).(*void), 8) > 0) {}
}

func finishOs() -> void {
    if (epollFd >= 0) {
        glibc.close(epollFd);
    }
    if (commandFd >= 0) {
        glibc.close(commandFd);
    }
    epollFd = -1;
    commandFd = -1;
}

func resolveNative(op: *Operation, error: *Error) -> *Addresses {
    var hints: glibc.Addrinfo;
    hints.family = 0;
    if (op.request.address.family == 4) {
        hints.family = 2;
    }
    if (op.request.address.family == 6) {
        hints.family = 10;
    }
    hints.socketType = op.request.transport.(i32);
    hints.flags = 1024;
    var service: u8[6];
    serviceName(op.request.address.port, (&service[0]).(*u8));
    var answers: *glibc.Addrinfo;
    var code: i32 = glibc.getaddrinfo(
        op.hostname,
        (&service[0]).(*u8),
        (&hints).(*glibc.Addrinfo),
        (&answers).(**glibc.Addrinfo)
    );
    if (code != 0) {
        var kind: u64 = 11;
        if (code == - 10) {
            kind = 10;
        }
        *error = errorWith(kind, 3, code);
        return nullPointer().(*Addresses);
    }
    var count: usize = 0;
    var a: *glibc.Addrinfo = answers;
    while (a != nullPointer().(*glibc.Addrinfo)) {
        if (a.family == 2 || a.family == 10) {
            count = count + 1;
        }
        a = a.next;
    }
    var list: *Addresses = nullPointer().(*Addresses);
    if (count <= (INVALID - Addresses.size) / Address.size) {
        list = allocate(Addresses.size + count * Address.size).(*Addresses);
    }
    if (list == nullPointer().(*Addresses)) {
        *error = netError(10);
    } else {
        var values: *Address = listValues(list);
        a = answers;
        while (a != nullPointer().(*glibc.Addrinfo)) {
            if (
                fromNative(
                    a.address.(*NativeAddress),
                    (&values[list.count]).(*Address)
                )
            ) {
                list.count = list.count + 1;
            }
            a = a.next;
        }
    }
    glibc.freeaddrinfo(answers);
    return list;
}

package core;

// Propagation transfers owner payloads and preserves stored borrow origins.
pub func mapOption<T, U>(value: Option<T>, mapper: once func(T) -> U) -> Option<U> {
    var item = value?;
    return Option<U>.Some(mapper(item));
}

pub func andThenOption<T, U>(value: Option<T>, mapper: once func(T) -> Option<U>) -> Option<U> {
    var item = value?;
    return mapper(item);
}

pub func unwrapOrElse<T>(value: Option<T>, fallback: once func() -> T) -> T {
    match (value) {
        Some(item) => return item;
        None => return fallback();
    }
}

pub func mapResult<T, U, E>(value: Result<T, E>, mapper: once func(T) -> U) -> Result<U, E> {
    match (value) {
        Ok(item) => return Result<U, E>.Ok(mapper(item));
        Err(error) => return Result<U, E>.Err(error);
    }
}

pub func mapError<T, E, F>(value: Result<T, E>, mapper: once func(E) -> F) -> Result<T, F> {
    match (value) {
        Ok(item) => return Result<T, F>.Ok(item);
        Err(error) => return Result<T, F>.Err(mapper(error));
    }
}

pub func andThenResult<T, U, E>(value: Result<T, E>, mapper: once func(T) -> Result<U, E>) -> Result<U, E> {
    match (value) {
        Ok(item) => return mapper(item);
        Err(error) => return Result<U, E>.Err(error);
    }
}

pub func unwrapOr<T>(value: Option<T>, fallback: T) -> T {
    match (value) {
        Some(v) => return v;
        None => return fallback;
    }
}


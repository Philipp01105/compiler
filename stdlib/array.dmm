// =================================================================
// STANDARD LIBRARY - ARRAY MODULE
// =================================================================
// Provides array manipulation and analysis functions
// =================================================================

#import <stdlib/core.dmm>

// ============== ARRAY INITIALIZATION ==============

// Fill integer array with a value
func fillInt(arr[]:int, size:int, value:int) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        arr[i] = value;
    }
}

// Fill byte array with a value
func fillByte(arr[]:byte, size:int, value:byte) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        arr[i] = value;
    }
}

// Fill character array with a value
func fillChar(arr[]:char, size:int, value:char) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        arr[i] = value;
    }
}

// ============== ARRAY SEARCH ==============

// Find index of first occurrence of value in integer array
func indexOfInt(arr[]:int, size:int, value:int) -> int {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        if (arr[i] == value) {
            return i;
        }
    }
    return -1;  // Not found
}

// Check if integer array contains value
func containsInt(arr[]:int, size:int, value:int) -> bit {
    return indexOfInt(arr, size, value) != -1;
}

// Count occurrences of value in integer array
func countInt(arr[]:int, size:int, value:int) -> int {
    var count:int = 0;
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        if (arr[i] == value) {
            count = count + 1;
        }
    }
    return count;
}

// ============== ARRAY STATISTICS ==============

// Find minimum value in integer array
func minInt(arr[]:int, size:int) -> int {
    if (size <= 0) {
        return 0;
    }
    
    var minVal:int = arr[0];
    var i:int = 1;
    
    for (i = 1; i < size; i = i + 1) {
        if (arr[i] < minVal) {
            minVal = arr[i];
        }
    }
    
    return minVal;
}

// Find maximum value in integer array
func maxInt(arr[]:int, size:int) -> int {
    if (size <= 0) {
        return 0;
    }
    
    var maxVal:int = arr[0];
    var i:int = 1;
    
    for (i = 1; i < size; i = i + 1) {
        if (arr[i] > maxVal) {
            maxVal = arr[i];
        }
    }
    
    return maxVal;
}

// Sum all elements in integer array
func sumInt(arr[]:int, size:int) -> int {
    var sum:int = 0;
    var i:int = 0;
    
    for (i = 0; i < size; i = i + 1) {
        sum = sum + arr[i];
    }
    
    return sum;
}

// Calculate average of integer array (integer division)
func averageInt(arr[]:int, size:int) -> int {
    if (size <= 0) {
        return 0;
    }
    return sumInt(arr, size) / size;
}

// Find index of minimum value
func indexOfMinInt(arr[]:int, size:int) -> int {
    if (size <= 0) {
        return -1;
    }
    
    var minIdx:int = 0;
    var i:int = 1;
    
    for (i = 1; i < size; i = i + 1) {
        if (arr[i] < arr[minIdx]) {
            minIdx = i;
        }
    }
    
    return minIdx;
}

// Find index of maximum value
func indexOfMaxInt(arr[]:int, size:int) -> int {
    if (size <= 0) {
        return -1;
    }
    
    var maxIdx:int = 0;
    var i:int = 1;
    
    for (i = 1; i < size; i = i + 1) {
        if (arr[i] > arr[maxIdx]) {
            maxIdx = i;
        }
    }
    
    return maxIdx;
}

// ============== ARRAY MANIPULATION ==============

// Reverse integer array in place
func reverseInt(arr[]:int, size:int) -> void {
    var i:int = 0;
    var j:int = size - 1;
    
    for (i = 0; i < j; i = i + 1) {
        swap(arr, i, j);
        j = j - 1;
    }
}

// Copy integer array from source to destination
func copyInt(source[]:int, dest[]:int, size:int) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        dest[i] = source[i];
    }
}

// Multiply all elements by a scalar
func multiplyScalarInt(arr[]:int, size:int, scalar:int) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        arr[i] = arr[i] * scalar;
    }
}

// Add a scalar to all elements
func addScalarInt(arr[]:int, size:int, scalar:int) -> void {
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        arr[i] = arr[i] + scalar;
    }
}

// ============== ARRAY SORTING ==============

// Bubble sort for integer array
func sortInt(arr[]:int, size:int) -> void {
    var i:int = 0;
    var j:int = 0;
    
    for (i = 0; i < size - 1; i = i + 1) {
        for (j = 0; j < size - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                swap(arr, j, j + 1);
            }
        }
    }
}

// Check if integer array is sorted
func isSortedInt(arr[]:int, size:int) -> bit {
    var i:int = 0;
    
    for (i = 0; i < size - 1; i = i + 1) {
        if (arr[i] > arr[i + 1]) {
            return 0;
        }
    }
    
    return 1;
}

// ============== ARRAY COMPARISON ==============

// Check if two integer arrays are equal
func equalsInt(arr1[]:int, arr2[]:int, size:int) -> bit {
    var i:int = 0;
    
    for (i = 0; i < size; i = i + 1) {
        if (arr1[i] != arr2[i]) {
            return 0;
        }
    }
    
    return 1;
}

// ============== ARRAY PRINTING ==============

// Print integer array
func printArrayInt(arr[]:int, size:int) -> void {
    print("[");
    var i:int = 0;
    for (i = 0; i < size; i = i + 1) {
        print(arr[i]);
        if (i < size - 1) {
            print(", ");
        }
    }
    print("]");
}

// Print integer array with newline
func printlnArrayInt(arr[]:int, size:int) -> void {
    printArrayInt(arr, size);
    print("\n");
}

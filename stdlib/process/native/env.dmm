package env;
import (
    "stdlib/collections"
    "stdlib/core"
    memraw "stdlib/memory/raw"
    "stdlib/sync"
);

pub enum ErrorKind {
    pub Missing,
    pub InvalidName,
    pub InvalidValue,
    pub InvalidEncoding,
    pub NotFound,
    pub AccessDenied,
    pub OutOfMemory,
    pub CapacityOverflow,
    pub System,
}

pub struct Error {
    pub var kind:ErrorKind;
    pub var code:isize;

    pub static func fromResidual(error:core.AllocError) -> Self {
        match (error) {
            OutOfMemory => return Error{kind:ErrorKind.OutOfMemory, code:0};
            CapacityOverflow => return Error{kind:ErrorKind.CapacityOverflow, code:0};
        }
    }
}

pub enum ExitStatus {
    pub Code(i32),
    pub Signal(i32)
}

pub struct Argument {
    pub var bytes:u8[];
}

struct State {}

func makeLock() -> sync.Mutex<State> {
    match (sync.mutex(State{})) {
        Ok(value) => return value;
        Err(error) => {
            memraw.core_trap();
        }
    }
}

var stateLock = makeLock();

pub func get(name:u8[]) -> core.Result<collections.List<u8>,Error> {
    var guard = sync.lock(&stateLock);
    return nativeGet(name);
}

pub func set(name:u8[], value:u8[]) -> core.Result<void,Error> {
    var guard = sync.lock(&stateLock);
    return nativeSet(name, value);
}

pub func remove(name:u8[]) -> core.Result<void,Error> {
    var guard = sync.lock(&stateLock);
    return nativeRemove(name);
}

func failure(kind:ErrorKind, code:isize) -> Error {
    return Error{kind:kind, code:code};
}

func validName(name:u8[]) -> bit {
    if (name.length == 0) {
        return false;
    }
    for (var i:usize = 0; i < name.length; i += 1) {
        if (name[i] == 0 || name[i] == 61) {
            return false;
        }
    }
    return true;
}

func validValue(value:u8[]) -> bit {
    for (var i:usize = 0; i < value.length; i += 1) {
        if (value[i] == 0) {
            return false;
        }
    }
    return true;
}

    value.second = 52140;
    value.third = 4559;
    value.bytes[0] = 149;
    value.bytes[1] = 202;
    value.bytes[2] = 0;
    value.bytes[3] = 128;
    value.bytes[4] = 95;
    value.bytes[5] = 72;

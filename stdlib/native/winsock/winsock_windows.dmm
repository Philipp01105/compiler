}

pub func connectExId() -> Guid {
    var value:Guid;
    value.first = 631375801;
    value.second = 56819;
    value.third = 18016;
    value.bytes[0] = 142;
    value.bytes[1] = 233;
    value.bytes[2] = 118;
    value.bytes[3] = 229;
    value.bytes[4] = 140;
    value.bytes[5] = 116;
    value.bytes[6] = 6;
    value.bytes[7] = 62;
    return value;
}

package text;
import (
    byteops "stdlib/bytes"
    "stdlib/core"
    raw "stdlib/memory/raw"
);

pub func bytes(value:string) -> u8[] {
    return slice(raw.core_string_data(value), raw.core_string_length(value));
}

pub func length(value:string) -> usize {
    return raw.core_string_length(value);
}

pub func startsWith(value:string, prefix:string) -> bit {
    return byteops.startsWith(bytes(value), bytes(prefix));
}

pub func endsWith(value:string, suffix:string) -> bit {
    return byteops.endsWith(bytes(value), bytes(suffix));
}

pub func contains(value:string, needle:string) -> bit {
    match (byteops.find(bytes(value), bytes(needle))) {
        Some(index) => return true;
        None => return false;
    }
}

pub func find(value:string, needle:string) -> core.Option<usize> {
    return byteops.find(bytes(value), bytes(needle));
}

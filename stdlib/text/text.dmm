package text;
import (
    "stdlib"
    raw "stdlib/core/raw"
);

pub func bytes(value: string) -> u8[] {
    return slice(raw.core_string_data(value), strlen(value));
}

pub func startsWith(value: u8[], prefix: u8[]) -> bit {
    if (prefix.length > value.length) {
        return false;
    }
    for (var i: usize = 0; i < prefix.length; i += 1) {
        if (value[i] != prefix[i]) {
            return false;
        }
    }
    return true;
}

pub func endsWith(value: u8[], suffix: u8[]) -> bit {
    if (suffix.length > value.length) {
        return false;
    }
    for (var i: usize = 0; i < suffix.length; i += 1) {
        if (value[value.length - suffix.length + i] != suffix[i]) {
            return false;
        }
    }
    return true;
}

pub func find(value: u8[], needle: u8[]) -> stdlib.Option<usize> {
    if (needle.length > value.length) {
        return stdlib.Option<usize>.None;
    }
    for (var start: usize = 0; start <= value.length - needle.length; start += 1) {
        var same: bit = true;
        for (var i: usize = 0; i < needle.length; i += 1) {
            if (value[start + i] != needle[i]) {
                same = false;
                break;
            }
        }
        if (same) {
            return stdlib.Option<usize>.Some(start);
        }
    }
    return stdlib.Option<usize>.None;
}

pub func asciiSpace(value: u8) -> bit {
    return value == 32 || (value >= 9 && value <= 13);
}

pub func trimAscii(value: u8[]) -> u8[] {
    var start: usize = 0;
    var end: usize = value.length;
    while (start < end && asciiSpace(value[start])) {
        start += 1;
    }
    while (end > start && asciiSpace(value[end - 1])) {
        end -= 1;
    }
    return value[start: end];
}

pub struct Split {
    var source: u8[];
    var delimiter: u8;
    var offset: usize;
    var finished: bit;
    pub func next() -> stdlib.Option<u8[]> {
        if (finished) {
            return stdlib.Option<u8[]>.None;
        }
        var start: usize = offset;
        while (offset < source.length && source[offset] != delimiter) {
            offset += 1;
        }
        var end: usize = offset;
        if (offset == source.length) {
            finished = true;
        } else {
            offset += 1;
        }
        return stdlib.Option<u8[]>.Some(source[start: end]);
    }

    // A move-only iterator carries the source loan until its lifetime ends.
    destructor {}
}

pub func split(value: u8[], delimiter: u8) -> Split {
    return Split{
        source: value,
        delimiter: delimiter,
        offset: 0,
        finished: false
    };
}

pub struct StringBuilder {
    var data: stdlib.Bytes;
    pub func length() -> usize {
        return data.length();
    }

    pub func view() -> u8[] {
        return data.view();
    }

    pub func append(value: u8[]) -> stdlib.AllocationError {
        return data.append(value);
    }

    pub func appendString(value: string) -> stdlib.AllocationError {
        return data.append(bytes(value));
    }

    pub func clear() -> void {
        data.clear();
    }
}

pub func builder(capacity: usize) -> stdlib.Result<StringBuilder, stdlib.AllocationError> {
    var data = stdlib.bytes(capacity);
    if (!data.ok()) {
        return stdlib.Result<StringBuilder, stdlib.AllocationError>.Err(data.error);
    }
    return stdlib.Result<StringBuilder, stdlib.AllocationError>.Ok(StringBuilder{ data: data });
}

pub func clone(value: u8[]) -> stdlib.Result<stdlib.Bytes, stdlib.AllocationError> {
    var result = stdlib.bytes(value.length);
    if (!result.ok()) {
        return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Err(result.error);
    }
    var error = result.append(value);
    if (error != stdlib.AllocationError.None) {
        return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Err(error);
    }
    return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Ok(result);
}

pub func replace(value: u8[], needle: u8[], replacement: u8[]) -> stdlib.Result<stdlib.Bytes, stdlib.AllocationError> {
    var result = stdlib.bytes(value.length);
    if (!result.ok()) {
        return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Err(result.error);
    }
    var start: usize = 0;
    while (start < value.length) {
        var found: bit = needle.length > 0 && needle.length <= value.length - start;
        if (found) {
            for (var i: usize = 0; i < needle.length; i += 1) {
                if (value[start + i] != needle[i]) {
                    found = false;
                    break;
                }
            }
        }
        var error: stdlib.AllocationError;
        if (found) {
            error = result.append(replacement);
            start += needle.length;
        } else {
            error = result.push(value[start]);
            start += 1;
        }
        if (error != stdlib.AllocationError.None) {
            return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Err(error);
        }
    }
    return stdlib.Result<stdlib.Bytes, stdlib.AllocationError>.Ok(result);
}

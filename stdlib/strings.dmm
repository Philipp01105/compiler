// =================================================================
// STANDARD LIBRARY - STRING MODULE
// =================================================================
// Provides string manipulation and analysis functions
// Note: Strings in DMM are immutable literals
// =================================================================

#import <stdlib/core.dmm>

// ============== STRING ANALYSIS ==============

// Get length of string
func length(s:string) -> int {
    var len:int = 0;
    var i:int = 0;
    
    // Iterate through string until null terminator
    for (i = 0; s[i] != 0; i = i + 1) {
        len = len + 1;
    }
    
    return len;
}

// Check if string is empty
func isEmpty(s:string) -> bit {
    return s[0] == 0;
}

// Get character at specific index
func charAt(s:string, index:int) -> char {
    return s[index];
}

// Find first occurrence of character in string
func indexOf(s:string, c:char) -> int {
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (s[i] == c) {
            return i;
        }
    }
    
    return -1;  // Not found
}

// Find last occurrence of character in string
func lastIndexOf(s:string, c:char) -> int {
    var lastPos:int = -1;
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (s[i] == c) {
            lastPos = i;
        }
    }
    
    return lastPos;
}

// Count occurrences of character in string
func countChar(s:string, c:char) -> int {
    var count:int = 0;
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (s[i] == c) {
            count = count + 1;
        }
    }
    
    return count;
}

// ============== STRING COMPARISON ==============

// Compare two strings (returns -1, 0, or 1)
func compare(s1:string, s2:string) -> int {
    var i:int = 0;
    
    for (i = 0; s1[i] != 0; i = i + 1) {
        if (s2[i] == 0) {
            return 1;  // s1 is longer
        }
        if (s1[i] < s2[i]) {
            return -1;
        }
        if (s1[i] > s2[i]) {
            return 1;
        }
    }
    
    if (s2[i] != 0) {
        return -1;  // s2 is longer
    }
    
    return 0;  // Equal
}

// Check if two strings are equal
func equals(s1:string, s2:string) -> bit {
    return compare(s1, s2) == 0;
}

// Check if string starts with character
func startsWith(s:string, c:char) -> bit {
    return s[0] == c;
}

// Check if string ends with character
func endsWith(s:string, c:char) -> bit {
    var len:int = length(s);
    if (len == 0) {
        return 0;
    }
    return s[len - 1] == c;
}

// ============== STRING CLASSIFICATION ==============

// Check if all characters are alphabetic
func isAlphaStr(s:string) -> bit {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var i:int = 0;
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isAlpha(s[i]) == 0) {
            return 0;
        }
    }
    
    return 1;
}

// Check if all characters are digits
func isDigitStr(s:string) -> bit {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var i:int = 0;
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isDigit(s[i]) == 0) {
            return 0;
        }
    }
    
    return 1;
}

// Check if all characters are alphanumeric
func isAlnumStr(s:string) -> bit {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var i:int = 0;
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isAlnum(s[i]) == 0) {
            return 0;
        }
    }
    
    return 1;
}

// Check if all characters are uppercase
func isUpperStr(s:string) -> bit {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var hasAlpha:bit = 0;
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isAlpha(s[i]) == 1) {
            hasAlpha = 1;
            if (isUpper(s[i]) == 0) {
                return 0;
            }
        }
    }
    
    return hasAlpha;
}

// Check if all characters are lowercase
func isLowerStr(s:string) -> bit {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var hasAlpha:bit = 0;
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isAlpha(s[i]) == 1) {
            hasAlpha = 1;
            if (isLower(s[i]) == 0) {
                return 0;
            }
        }
    }
    
    return hasAlpha;
}

// ============== STRING CONVERSION ==============

// Convert digit character to integer value
func charToDigit(c:char) -> int {
    if (isDigit(c) == 1) {
        return c - '0';
    }
    return -1;  // Invalid
}

// Convert integer digit to character
func digitToChar(digit:int) -> char {
    if (digit >= 0) {
        if (digit <= 9) {
            return '0' + digit;
        }
    }
    return '?';  // Invalid
}

// Parse integer from string (basic implementation)
func parseInt(s:string) -> int {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var result:int = 0;
    var sign:int = 1;
    var i:int = 0;
    
    // Handle negative sign
    if (s[0] == '-') {
        sign = -1;
        i = 1;
    }
    
    // Parse digits
    for (i = i; s[i] != 0; i = i + 1) {
        if (isDigit(s[i]) == 1) {
            result = (result * 10) + charToDigit(s[i]);
        }
    }
    
    return result * sign;
}

// ============== STRING UTILITIES ==============

// Count words in string (space-separated)
func countWords(s:string) -> int {
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    var count:int = 0;
    var inWord:bit = 0;
    var i:int = 0;
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (isSpace(s[i]) == 1) {
            inWord = 0;
        }
        if (isSpace(s[i]) == 0) {
            if (inWord == 0) {
                count = count + 1;
                inWord = 1;
            }
        }
    }
    
    return count;
}

// Count newlines in string
func countLines(s:string) -> int {
    var count:int = 1;  // Start with 1 for first line
    var i:int = 0;
    
    if (isEmpty(s) == 1) {
        return 0;
    }
    
    for (i = 0; s[i] != 0; i = i + 1) {
        if (s[i] == '\n') {
            count = count + 1;
        }
    }
    
    return count;
}

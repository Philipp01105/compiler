package threading;
import (
    "stdlib/native/glibc"
    "stdlib/native/pthreads"
);
extern "system" from "c" {
    func abort() -> void;
}

extern "system" {
    struct Thread {
        pub var callback:extern "system" func(*void) -> void;
        pub var argument:*void;
        pub var handle:usize;
    }

    struct Event {
        pub var mutex:pthreads.Mutex;
        pub var condition:pthreads.Condition;
        pub var signalled:i32;
    }
}

func check(result:i32) -> void {
    if (result != 0) {
        abort();
    }
}

func allocate(size:usize) -> *void {
    var result:*void = glibc.calloc(1, size);
    if (result == nullPointer()) {
        abort();
    }
    return result;
}

pub export "system" func __dmm_platform_thread_entry(address:*void) -> *void{
    var thread:*Thread = address.(*Thread);
    (*thread).callback((*thread).argument);
    return nullPointer();
} pub export "system" func __dmm_async_thread_create(
    callback:extern "system" func(*void) -> void,
    argument:*void
) -> *void{
    var thread:*Thread = allocate(Thread.size).(*Thread);
    (*thread).callback = callback;
    (*thread).argument = argument;
    check(
        pthreads.create(
            (&(*thread).handle).(*usize),
            nullPointer().(*pthreads.Attributes),
            __dmm_platform_thread_entry,
            thread.(*void)
        )
    );
    return thread.(*void);
} pub export "system" func __dmm_async_thread_join(address:*void) -> void{
    var thread:*Thread = address.(*Thread);
    check(pthreads.join((*thread).handle, nullPointer().(**void)));
    glibc.release(address);
} pub export "system" func __dmm_async_wait_create() -> *void{
    var event:*Event = allocate(Event.size).(*Event);
    check(
        pthreads.mutexInit(
            (&(*event).mutex).(*pthreads.Mutex),
            nullPointer().(*pthreads.MutexAttributes)
        )
    );
    check(
        pthreads.conditionInit(
            (&(*event).condition).(*pthreads.Condition),
            nullPointer().(*pthreads.ConditionAttributes)
        )
    );
    return event.(*void);
} pub export "system" func __dmm_async_wait(address:*void) -> void{
    var event:*Event = address.(*Event);
    check(pthreads.mutexLock((&(*event).mutex).(*pthreads.Mutex)));
    while ((*event).signalled == 0) {
        check(
            pthreads.conditionWait(
                (&(*event).condition).(*pthreads.Condition),
                (&(*event).mutex).(*pthreads.Mutex)
            )
        );
    }
    check(pthreads.mutexUnlock((&(*event).mutex).(*pthreads.Mutex)));
} pub export "system" func __dmm_async_wake(address:*void) -> void{
    var event:*Event = address.(*Event);
    check(pthreads.mutexLock((&(*event).mutex).(*pthreads.Mutex)));
    (*event).signalled = 1;
    check(pthreads.conditionBroadcast((&(*event).condition).(*pthreads.Condition)));
    check(pthreads.mutexUnlock((&(*event).mutex).(*pthreads.Mutex)));
} pub export "system" func __dmm_async_wait_reset(address:*void) -> void{
    var event:*Event = address.(*Event);
    check(pthreads.mutexLock((&(*event).mutex).(*pthreads.Mutex)));
    (*event).signalled = 0;
    check(pthreads.mutexUnlock((&(*event).mutex).(*pthreads.Mutex)));
} pub export "system" func __dmm_async_wait_destroy(address:*void) -> void{
    var event:*Event = address.(*Event);
    check(pthreads.conditionDestroy((&(*event).condition).(*pthreads.Condition)));
    check(pthreads.mutexDestroy((&(*event).mutex).(*pthreads.Mutex)));
    glibc.release(address);
} pub export "system" func __dmm_platform_exit(code:i32) -> void{
    glibc.immediateExit(code);
}

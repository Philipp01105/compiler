package memory;
import "stdlib/core";

struct SharedStorage<T> {
    var references: core.AtomicUsize;
    var value: T;
}

@[no_default] @[core.Send + core.Sync where T: core.Send + core.Sync] pub struct Shared<T> {
    var storage: *SharedStorage<T>;

    pub func clone() -> Shared<T> {
        var count: usize = (*storage).references.load();
        while (true) {
            if (count == 18446744073709551615.(usize)) {
                core.core_trap();
            }
            var previous: usize = (*storage).references.compareExchange(count, count + 1.(usize));
            if (previous == count) {
                return Shared<T>{ storage: storage };
            }
            count = previous;
        }
        core.core_trap();
    }

    pub func get() -> &T {
        return &(*self.storage).value;
    }

    destructor {
        var count: usize = (*storage).references.load();
        while (true) {
            var previous: usize = (*storage).references.compareExchange(count, count - 1.(usize));
            if (previous == count) {
                break;
            }
            count = previous;
        }
        if (count == 1.(usize)) {
            core.destroy<T>(&(*storage).value);
            core.core_release(storage.(*u8));
        }
    }
}

pub func shared<T>(value: T) -> core.Result<Shared<T>, core.AllocError> {
    var block: *SharedStorage < T >= core.core_alloc(sizeof(SharedStorage<T>)).(*SharedStorage<T>);
    if (block == core.null<SharedStorage<T>>()) {
        return core.Result<Shared<T>, core.AllocError>.Err(core.AllocError.OutOfMemory);
    }
    core.initialize<SharedStorage<T>>(
        block,
        SharedStorage<T>{ references: core.atomicUsize(1.(usize)), value: value }
    );
    return core.Result<Shared<T>, core.AllocError>.Ok(Shared<T>{ storage: block });
}

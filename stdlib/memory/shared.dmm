package memory;
import (
    "stdlib/core"
    memraw "stdlib/memory/raw"
    atomic "stdlib/sync/atomic"
);

struct SharedStorage<T> {
    var references:atomic.AtomicUsize;
    var value:T;
}

@[no_default]
@[core.Send + core.Sync where T:core.Send + core.Sync]
pub struct Shared<T> {
    var storage:*SharedStorage<T>;

    pub func clone() -> Shared<T> {
        var count:usize = (*storage).references.load();
        while (true) {
            if (count == 18446744073709551615.(usize)) {
                memraw.core_trap();
            }
            var previous:usize = (*storage).references.compareExchange(count, count + 1.(usize));
            if (previous == count) {
                return Shared<T>{storage:storage};
            }
            count = previous;
        }
        memraw.core_trap();
    }

    pub func get() -> &T {
        return &(*self.storage).value;
    }

    destructor {
        var count:usize = (*storage).references.load();
        while (true) {
            var previous:usize = (*storage).references.compareExchange(count, count - 1.(usize));
            if (previous == count) {
                break;
            }
            count = previous;
        }
        if (count == 1.(usize)) {
            memraw.destroy<T>(&(*storage).value);
            memraw.core_release(storage.(*u8));
        }
    }
}

pub func shared<T>(value:T) -> core.Result<Shared<T>,core.AllocError> {
    var block:*SharedStorage<T>= memraw.core_alloc(sizeof(SharedStorage<T>)).(*SharedStorage<T>);
    if (block == memraw.null<SharedStorage<T>>()) {
        return core.Result<Shared<T>,core.AllocError>.Err(core.AllocError.OutOfMemory);
    }
    memraw.initialize<SharedStorage<T>>(
        block,
        SharedStorage<T>{references:atomic.atomicUsize(1.(usize)), value:value}
    );
    return core.Result<Shared<T>,core.AllocError>.Ok(Shared<T>{storage:block});
}

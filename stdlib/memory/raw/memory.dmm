package raw;
// Byte counts use usize; offsets use isize. Regions are explicitly owned.
pub func core_alloc(bytes: usize) -> *u8 {
    return __dmm_intrinsic_alloc(bytes);
}

pub func core_release(data: *u8) -> void {
    __dmm_intrinsic_release(data);
}

// Native POD unions expose pointer bits without a compiler-recognized function.
extern "system" {
    union BytePointer {
        pub var bits: usize;
        pub var data: *u8;
    }
}

pub func core_null() -> *u8 {
    var pointer: BytePointer;
    return pointer.data;
}

pub func core_offset(data: *u8, offset: isize) -> *u8 {
    var pointer: BytePointer;
    pointer.data = data;
    pointer.bits = pointer.bits + offset.(usize);
    return pointer.data;
}

pub func core_copy(destination: *u8, source: *u8, bytes: usize) -> void {
    if (bytes == 0) {
        return;
    }
    if (bytes > 9223372036854775807 || destination == core_null() || source == core_null()) {
        core_trap();
    }
    var out: BytePointer;
    out.data = destination;
    var input: BytePointer;
    input.data = source;
    // Copy backwards only for overlapping regions with the destination above
    // the source. Subtraction avoids overflowing source+bytes.
    if (out.bits > input.bits && out.bits - input.bits < bytes) {
        var remaining: usize = bytes;
        while (remaining != 0) {
            remaining -= 1;
            core_store(destination, remaining, core_load(source, remaining));
        }
    } else {
        var index: usize = 0;
        while (index < bytes) {
            core_store(destination, index, core_load(source, index));
            index += 1;
        }
    }
}

pub func core_fill(destination: *u8, value: u8, bytes: usize) -> void {
    if (bytes == 0) {
        return;
    }
    if (bytes > 9223372036854775807 || destination == core_null()) {
        core_trap();
    }
    var index: usize = 0;
    while (index < bytes) {
        core_store(destination, index, value);
        index += 1;
    }
}

pub func core_load(data: *u8, offset: usize) -> u8 {
    return *core_offset(data, offset.(isize));
}

pub func core_store(data: *u8, offset: usize, value: u8) -> void {
    *core_offset(data, offset.(isize)) = value;
}

// Borrowed bytes, including a trailing NUL. Do not release or mutate this view.
pub func core_string_data(text: string) -> *u8 {
    return __dmm_intrinsic_string_data(text);
}

// String traversal is ordinary DMM code, rather than a runtime string routine.
pub func core_string_length(text: string) -> usize {
    var data: *u8 = core_string_data(text);
    if (data == core_null()) {
        return 0;
    }
    var length: usize = 0;
    while (core_load(data, length) != 0) {
        length += 1;
    }
    return length;
}

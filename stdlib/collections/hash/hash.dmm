package hash;
// SipHash-2-4 for keyed table hashing, not password hashing or encryption.
// DMM currently has no bitwise operators; the xor implementation is ordinary
// integer arithmetic and can be optimized independently without an intrinsic.
func xorWord(left:u64,right:u64)->u64 {
    var result:u64=0;var power:u64=1;
    for(var i:usize=0;i<64;i+=1) {
        if(left%2!=right%2) {result+=power;}
        left/=2;right/=2;power*=2;
    }
    return result;
}
func rotate(word:u64,power:u64,divisor:u64)->u64 {return word*power+word/divisor;}
struct State {
    var v0:u64;var v1:u64;var v2:u64;var v3:u64;
    func round()->void {
        v0+=v1;v1=rotate(v1,8192,2251799813685248);v1=xorWord(v1,v0);v0=rotate(v0,4294967296,4294967296);
        v2+=v3;v3=rotate(v3,65536,281474976710656);v3=xorWord(v3,v2);
        v0+=v3;v3=rotate(v3,2097152,8796093022208);v3=xorWord(v3,v0);
        v2+=v1;v1=rotate(v1,131072,140737488355328);v1=xorWord(v1,v2);v2=rotate(v2,4294967296,4294967296);
    }
    func block(word:u64)->void {
        v3=xorWord(v3,word);self.round();self.round();v0=xorWord(v0,word);
    }
}
pub func sipHash(input:&u8[],key0:u64,key1:u64)->u64 {
    var state=State{
        v0:xorWord(8317987319222330741.(u64),key0),
        v1:xorWord(7237128888997146477.(u64),key1),
        v2:xorWord(7816392313619706465.(u64),key0),
        v3:xorWord(8387220255154660723.(u64),key1)
    };
    var offset:usize=0;
    while(input.length-offset>=8) {
        var word:u64=0;var power:u64=1;
        for(var i:usize=0;i<8;i+=1) {word+=input[offset+i].(u64)*power;power*=256;}
        state.block(word);offset+=8;
    }
    var word:u64=(input.length%256).(u64)*72057594037927936.(u64);
    var power:u64=1;
    for(var i:usize=offset;i<input.length;i+=1) {word+=input[i].(u64)*power;power*=256;}
    state.block(word);state.v2=xorWord(state.v2,255);
    state.round();state.round();state.round();state.round();
    return xorWord(xorWord(state.v0,state.v1),xorWord(state.v2,state.v3));
}

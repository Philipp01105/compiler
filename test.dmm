    printHeader("TEST 131: Point Struct - Basic Field Access");
    var p1:Point;
    p1.x = 10;
    p1.y = 20;
    println("  Set x=10, y=20");
    println("  x = " + p1.x + ", y = " + p1.y);
    println("  [OK] Direct field access works");

    printHeader("TEST 132: Point Struct - Getter Methods");
    println("  getX() = " + p1.getX());
    println("  getY() = " + p1.getY());
    println("  [OK] Getter methods work");

    printHeader("TEST 133: Point Struct - Move Method");
    p1.move(5, 3);
    println("  After move(5, 3):");
    println("  x = " + p1.getX() + ", y = " + p1.getY());
    println("  [OK] Move method modifies fields correctly");

    printHeader("TEST 134: Point Struct - Reset Method");
    p1.reset();
    println("  After reset():");
    println("  x = " + p1.x + ", y = " + p1.y);
    println("  [OK] Reset method works");

    printHeader("TEST 135: Multiple Point Instances");
    var p2:Point;
    p1.x = 5;
    p1.y = 10;
    p2.x = 100;
    p2.y = 200;
    println("  p1: x=" + p1.x + ", y=" + p1.y);
    println("  p2: x=" + p2.x + ", y=" + p2.y);
    println("  [OK] Multiple instances are independent");

    printHeader("TEST 136: Rectangle Struct - Set Dimensions");
    var rect:Rectangle;
    rect.setDimensions(5, 10);
    println("  setDimensions(5, 10)");
    println("  width = " + rect.width + ", height = " + rect.height);
    println("  [OK] setDimensions works");

    printHeader("TEST 137: Rectangle Struct - Area Method");
    var rectArea:int = rect.area();
    println("  area() = " + rectArea);
    println("  Expected: 50");
    println("  [OK] Area calculation correct");

    printHeader("TEST 138: Rectangle Struct - Perimeter Method");
    var rectPerim:int = rect.perimeter();
    println("  perimeter() = " + rectPerim);
    println("  Expected: 30");
    println("  [OK] Perimeter calculation correct");

    printHeader("TEST 139: Rectangle Struct - isSquare Method");
    println("  Rectangle 5x10: isSquare() = " + rect.isSquare());
    rect.setDimensions(7, 7);
    println("  Rectangle 7x7: isSquare() = " + rect.isSquare());
    println("  [OK] isSquare method works correctly");

    printHeader("TEST 140: Counter Struct - Basic Operations");
    var counter:Counter;
    counter.reset();
    println("  After reset: count = " + counter.getValue());
    counter.increment();
    counter.increment();
    counter.increment();
    println("  After 3 increments: count = " + counter.getValue());
    counter.decrement();
    println("  After 1 decrement: count = " + counter.getValue());
    println("  [OK] Counter increment/decrement works");

    printHeader("TEST 141: Counter Struct - setValue Method");
    counter.setValue(42);
    println("  setValue(42): count = " + counter.getValue());
    println("  [OK] setValue method works");

    printHeader("TEST 142: Point Struct - Chained Operations");
    var p3:Point;
    p3.x = 0;
    p3.y = 0;
    p3.move(10, 20);
    p3.move(5, 5);
    println("  Start at (0,0), move(10,20), move(5,5)");
    println("  Final position: (" + p3.getX() + ", " + p3.getY() + ")");
    println("  [OK] Chained method calls work");

    printHeader("TEST 143: Struct Methods in Expressions");
    var r1:Rectangle;
    r1.setDimensions(3, 4);
    var r2:Rectangle;
    r2.setDimensions(5, 6);
    var totalArea:int = r1.area() + r2.area();
    println("  r1 area: " + r1.area() + ", r2 area: " + r2.area());
    println("  Total area: " + totalArea);
    println("  [OK] Method calls in expressions work");

    printHeader("TEST 144: Struct Field Modifications");
    var p4:Point;
    p4.x = 100;
    p4.y = 200;
    var oldX:int = p4.getX();
    p4.x = p4.x + 50;
    var newX:int = p4.getX();
    println("  Original x: " + oldX);
    println("  After x = x + 50: " + newX);
    println("  [OK] Field modifications work");

    printHeader("TEST 145: Complex Struct Usage");
    var c1:Counter;
    var c2:Counter;
    c1.setValue(0);
    c2.setValue(0);
    for (var struct_i:int = 0; struct_i < 5; struct_i++) {
        c1.increment();
        c2.increment();
        c2.increment();
    }
    println("  c1 (incremented 5 times): " + c1.getValue());
    println("  c2 (incremented 10 times): " + c2.getValue());
    println("  [OK] Structs in loops work correctly");


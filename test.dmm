}

// =================================================================
// BASIC ARITHMETIC FUNCTIONS
// =================================================================

func add(a:int, b:int) -> int
{
    return a + b;
}

func subtract(a:int, b:int) -> int
{
    return a - b;
}

func multiply(x:int, y:int) -> int
{
    return x * y;
}

func divide(x:int, y:int) -> int
{
    return x / y;
}

func square(n:int) -> int
{
    var temp:int = n * n;
    return temp;
}

func abs(n:int) -> int
{
    if (n < 0) {
        return -n;
    } else {
        return n;
    }
}

// =================================================================
// CHAR/BYTE/BIT FUNCTIONS
// =================================================================

func getGradeA() -> char
{
    return 'A';
}

func getGradeB() -> char
{
    return 'B';
}

func getGradeC() -> char
{
    return 'C';
}

func getMaxByte() -> byte
{
    return 255;
}

func addBytes(a:byte, b:byte) -> byte
{
    var result:byte = a + b;
    return result;
}

func isTrue() -> bit
{
    return 1;
}

func isFalse() -> bit
{
    return 0;
}

func boolAnd(a:bit, b:bit) -> bit
{
    if (a == 1 && b == 1) {
        return 1;
    } else {
        return 0;
    }
}

func boolOr(a:bit, b:bit) -> bit
{
    if (a == 1 || b == 1) {
        return 1;
    } else {
        return 0;
    }
}

func boolNot(b:bit) -> bit
{
    if (b == 1) {
        return 0;
    } else {
        return 1;
    }
}


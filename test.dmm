// =================================================================
// ELSE IF FUNCTIONS
// =================================================================

func getLetterGrade(score:int) -> char
{
    if (score >= 90) {
        return 'A';
    } else if (score >= 80) {
        return 'B';
    } else if (score >= 70) {
        return 'C';
    } else if (score >= 60) {
        return 'D';
    } else {
        return 'F';
    }
}

func classifyNumber(n:int) -> string
{
    if (n < 0) {
        return "negative";
    } else if (n == 0) {
        return "zero";
    } else if (n < 10) {
        return "single";
    } else if (n < 100) {
        return "double";
    } else if (n < 1000) {
        return "triple";
    } else {
        return "large";
    }
}

func getDayName(day:int) -> string
{

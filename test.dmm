    println("  sumTo(25) = " + sumTo(25));
    println("  sumTo(75) = " + sumTo(75));
    println("  sumTo(150) = " + sumTo(150));
    println("  [OK] SumTo with various limits works");

    printHeader("TEST 125: SumRange with Different Ranges");
    printSeparator();
    println("  sumRange(20, 30) = " + sumRange(20, 30));
    println("  sumRange(100, 110) = " + sumRange(100, 110));
    println("  sumRange(1, 5) = " + sumRange(1, 5));
    println("  sumRange(50, 55) = " + sumRange(50, 55));
    println("  [OK] SumRange with different ranges works");

    printHeader("TEST 126: SumOfSquares for Various N");
    printSeparator();
    println("  sumOfSquares(3) = " + sumOfSquares(3));
    println("  sumOfSquares(7) = " + sumOfSquares(7));
    println("  sumOfSquares(12) = " + sumOfSquares(12));
    println("  sumOfSquares(15) = " + sumOfSquares(15));
    println("  [OK] SumOfSquares for various N works");

    printHeader("TEST 127: GCD with More Test Cases");
    printSeparator();
    println("  gcd(24, 36) = " + gcd(24, 36));
    println("  gcd(105, 45) = " + gcd(105, 45));
    println("  gcd(54, 24) = " + gcd(54, 24));
    println("  gcd(120, 75) = " + gcd(120, 75));
    println("  gcd(13, 17) = " + gcd(13, 17));
    println("  [OK] GCD with more test cases works");

    printHeader("TEST 128: Prime Test for Larger Range");
    printSeparator();
    for (var test_i116:int = 21; test_i116 <= 40; test_i116++) {
        if (isPrime(test_i116) == 1) {
            println("  " + test_i116 + " is prime");
        }
    }
    println("  [OK] Prime test for larger range works");

    printHeader("TEST 129: IsEven for Extended Range");
    printSeparator();
    for (var test_i117:int = 11; test_i117 <= 30; test_i117++) {
        println("  " + test_i117 + " is even: " + isEven(test_i117));
    }
    println("  [OK] IsEven for extended range works");

    printHeader("TEST 130: Comparison Functions Comprehensive");
    printSeparator();
    for (var test_i118:int = -10; test_i118 <= 10; test_i118 += 5) {
        println("  Value: " + test_i118);
        println("    isPositive: " + isPositive(test_i118) + ", isNegative: " + isNegative(test_i118) + ", isZero: " + isZero(test_i118));
    }

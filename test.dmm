// =================================================================
// COMPARISON FUNCTIONS
// =================================================================

func isPositive(n:int) -> bit
{
    if (n > 0) {
        return 1;
    } else {
        return 0;
    }
}

func isNegative(n:int) -> bit
{
    if (n < 0) {
        return 1;
    } else {
        return 0;
    }
}

func isZero(n:int) -> bit
{
    if (n == 0) {
        return 1;
    } else {
        return 0;
    }
}

func isEven(n:int) -> bit
{
    var mod:int = n % 2;
    if (mod == 0) {
        return 1;
    } else {
        return 0;
    }
}

func max2(a:int, b:int) -> int
{
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

func min2(a:int, b:int) -> int
{
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

// =================================================================
// ALGORITHM FUNCTIONS (FIXED!)
// =================================================================

func factorial(n:int) -> int
{
    var result:int = 1;
    for (var i:int = 1; i <= n; i++) {
        var temp:int = result * i;
        result = temp;
    }
    return result;
}

func fibonacci(n:int) -> int
{
    if (n <= 1) {
        return n;
    }

    var prev:int = 0;
    var curr:int = 1;

    for (var i:int = 2; i <= n; i++) {
        var next:int = prev + curr;
        prev = curr;
        curr = next;
    }

    return curr;
}

func power(base:int, exp:int) -> int
{
    var result:int = 1;
    for (var i:int = 0; i < exp; i++) {
        var temp:int = result * base;
        result = temp;
    }
    return result;
}

func sumTo(n:int) -> int
{
    var sum:int = 0;
    for (var i:int = 1; i <= n; i++) {
        var temp:int = sum + i;
        sum = temp;
    }
    return sum;
}

func sumRange(start:int, end:int) -> int
{
    var sum:int = 0;
    for (var i:int = start; i <= end; i++) {
        var temp:int = sum + i;
        sum = temp;
    }
    return sum;
}

func sumOfSquares(n:int) -> int
{
    var sum:int = 0;
    for (var i:int = 1; i <= n; i++) {
        var sq:int = i * i;
        var temp:int = sum + sq;
        sum = temp;
    }
    return sum;
}

func gcd(a:int, b:int) -> int
{
    for (var i:int = 0; i < 1000; i++) {
        if (b == 0) {
            return a;
        }
        var temp:int = b;
        b = a % b;
        a = temp;
    }
    return a;
}

func isPrime(n:int) -> bit
{
    if (n <= 1) {
        return 0;
    }
    if (n == 2) {
        return 1;
    }
    if (n % 2 == 0) {
        return 0;
    }

    var i:int = 3;
    for (var count:int = 0; count < 1000; count++) {
        if (i * i > n) {
            return 1;
        }
        if (n % i == 0) {
            return 0;
        }
        i = i + 2;
    }

    return 1;
}

// =================================================================
// NESTED FUNCTIONS
// =================================================================

func sum3(a:int, b:int, c:int) -> int
{
    var temp1:int = a + b;
    var result:int = temp1 + c;
    return result;
}

func sum4(a:int, b:int, c:int, d:int) -> int
{
    var temp1:int = a + b;
    var temp2:int = c + d;
    var result:int = temp1 + temp2;
    return result;
}

func average2(a:int, b:int) -> int
{
    var sum:int = a + b;
    var result:int = sum / 2;
    return result;
}

func average3(a:int, b:int, c:int) -> int
{
    var sum:int = sum3(a, b, c);
    var result:int = sum / 3;
    return result;
}

func addAndMultiply(a:int, b:int, c:int) -> int
{
    var sum:int = add(a, b);
    var result:int = multiply(sum, c);
    return result;
}

func nestedSquares(a:int, b:int) -> int
{
    var sq1:int = square(a);
    var sq2:int = square(b);
    var result:int = add(sq1, sq2);
    return result;
}

func getConstant() -> int
{
    return 42;
}

// =================================================================
// STRUCT DEFINITIONS WITH METHODS
// =================================================================

struct Point {
    var x:int;
    var y:int;
    
    func move(dx:int, dy:int) -> void {
        x = x + dx;
        y = y + dy;
    }
    
    func getX() -> int {
        return x;
    }
    
    func getY() -> int {
        return y;
    }
    
    func reset() -> void {
        x = 0;
        y = 0;
    }
}

struct Rectangle {
    var width:int;
    var height:int;
    
    func area() -> int {
        return width * height;
    }
    
    func perimeter() -> int {
        return 2 * (width + height);
    }
    
    func setDimensions(w:int, h:int) -> void {
        width = w;
        height = h;
    }
    
    func isSquare() -> bit {
        if (width == height) {
            return 1;
        } else {
            return 0;
        }
    }
}

struct Counter {
    var count:int;
    
    func increment() -> void {
        count = count + 1;
    }
    
    func decrement() -> void {
        count = count - 1;
    }
    
    func reset() -> void {
        count = 0;
    }
    
    func getValue() -> int {
        return count;
    }
    
    func setValue(val:int) -> void {
        count = val;
    }
}


package main;

import "stdlib";
import "stdlib/core";

struct SharedCounter {
    var value:core.AtomicUsize;

    static func create() -> SharedCounter {
        return SharedCounter {
            value: core.atomicUsize(0)
        };
    }

    func increment() -> void {
        while (true) {
            var old:usize = value.load();
            var previous:usize = value.compareExchange(old, old + 1);

            if (previous == old) {
                return;
            }
        }
    }

    func get() -> usize {
        return value.load();
    }
}

async func worker(counter:&SharedCounter) -> void {
    while (counter.get() < 100000) {
        counter.increment();
    }
}

async func run() -> void {
    var counter:SharedCounter = SharedCounter.create();

    var worker1 = spawn(worker(&counter));
    var worker2 = spawn(worker(&counter));
    var worker3 = spawn(worker(&counter));
    var worker4 = spawn(worker(&counter));

    while (counter.get() < 100000) {
        stdlib.println(counter.get());
    }

    var result1 = worker1.await();
    var result2 = worker2.await();
    var result3 = worker3.await();
    var result4 = worker4.await();

    stdlib.println(counter.get());
}

func main() -> int {
    block_on(run());
    return 0;
}
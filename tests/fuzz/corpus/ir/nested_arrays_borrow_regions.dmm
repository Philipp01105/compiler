package main;

const WIDTH:int=4;
struct Matrix {var rows:int[WIDTH][3]; var writes:int;}
func sum(items:int[])->int {
    var result:int;
    for(var i=0;i<items.length;i+=1){result+=items[i];}
    return result;
}
func update(left:&mut int,right:&mut int,delta:int)->void{*left+=delta; *right-=delta;}
func rotate(matrix:&mut Matrix)->int {
    for(var row=0;row<3;row+=1){
        for(var column=0;column<WIDTH;column+=1){matrix.rows[row][column]=row*WIDTH+column;}
    }
    {
        var first:&mut int=&mut matrix.rows[0][0];
        var second:&mut int=&mut matrix.rows[0][1];
        update(first,second,3);
    }
    var result:int;
    for(var row=0;row<3;row+=1){
        var view:int[]=matrix.rows[row];
        result+=sum(view);
        var middle:int[]=view[1:3];
        result+=sum(middle);
    }
    matrix.writes+=12;
    return result;
}
func main()->int {
    var matrix:Matrix;
    var result=rotate(&mut matrix);
    var snapshot=matrix.rows;
    matrix.rows[2][3]=99;
    var pointer:*int=(&snapshot[2][3]).(*int);
    return result+*pointer+matrix.writes;
}

package main;
import "stdlib";

enum Phase(index: int, text: string, multiplier: int, enabled: bit) {
    warmup(0, "warmup", 1, true),
    active(1, "active", 3, true),
    stopped(2, "stopped", 0, false)
}

struct Matrix {
    var cells: int[16];
    var writes: int;

    func reset() -> void {
        writes = 0;
        for (var i: int = 0; i < 16; i++) {
            cells[i] = 0;
        }
    }

    func set(row: int, column: int, value: int) -> void {
        var offset: int = row * 4 + column;
        cells[offset] = value;
        writes++;
    }

    func get(row: int, column: int) -> int {
        return cells[row * 4 + column];
    }

    static func clamp(value: int, low: int, high: int) -> int {
        if (value < low) {
            return low;
        }
        if (value > high) {
            return high;
        }
        return value;
    }
}

func phase_for(step: int) -> Phase {
    if (step == 0) {
        return Phase.warmup;
    } else {
        if (step < 4) {
            return Phase.active;
        }
    }
    return Phase.stopped;
}

func evaluate(matrix: Matrix, row: int) -> int {
    var total: int = 0;
    for (var column: int = 0; column < 4; column++) {
        total += matrix.get(row, column);
    }
    return total;
}

func main() -> void {
    var matrix: Matrix;
    matrix.reset();
    var row_totals: int[5];
    var row: int = 0;

    while (row < 4) {
        var phase: Phase = phase_for(row);
        for (var column: int = 0; column < 4; column++) {
            var raw: int = (row + 1) * (column + 2) * phase.multiplier;
            if (phase.enabled) {
                if (raw % 2 == 0) {
                    matrix.set(row, column, Matrix.clamp(raw, 0, 50));
                } else {
                    matrix.set(row, column, raw + 1);
                }
            } else {
                matrix.set(row, column, -1);
            }
        }
        row_totals[row] = evaluate(matrix, row);
        row++;
    }

    var aggregate: *int = reserve(int);
    *aggregate = 0;
    for (var i: int = 0; i < 4; i++) {
        *aggregate += row_totals[i];
    }

    var converted: float = ((*aggregate).(double) / 7.0).(float);
    var manual: *int = reserve(int);
    *manual = (converted).(int);
    var final_phase: Phase = phase_for(4);
    var output: string = "phase=" + final_phase.text + ",index=" + final_phase.index + ",writes=" + matrix.writes + ",total=" + * aggregate + ",cast=" + * manual + ",enabled=" + final_phase.enabled;
    stdlib.println(output);
    free(output);
    free(manual);
}

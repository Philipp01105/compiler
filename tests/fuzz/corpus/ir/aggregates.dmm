package main;
import "stdlib/io";
import stdlib "stdlib/core";

enum Result(message: string, code: int) {
    Ok("ok", 0),
    Error("error", 1)
}

struct Box {
    var values: int[4];
}

func main() -> void {
    var box: Box;
    box.values[2] = 7;
    io.println(box.values[2]);
    io.println(Result.Error.code);
}

package main;
import "stdlib/io";
import stdlib "stdlib/core";

func choose(value: int) -> int {
    if (value > 0 && value < 10) {
        return value;
    }
    return 0 - value;
}

func main() -> void {
    var index: int = 0;
    while (index < 4) {
        io.println(choose(index));
        index++;
    }
}

package main;
interface Measure<T>{func measure(value:T)->int;}
struct IntegerMeasure{func measure(value:int)->int{return value;}}
struct DoubleMeasure{func measure(value:double)->int{return value.(int);}}
struct Box<T:Measure<int>>{var value:T;}
func invoke<T:Measure<int>>(value:T)->int{return value.measure(3);}
func select(flag:bit)->Measure<int>{if(flag){var a:IntegerMeasure; return a;} var b:DoubleMeasure; return b;}
func main()->int {
    var wrong:Box<DoubleMeasure>;
    var erased:Measure<int>=select(false);
    var concrete:DoubleMeasure;
    return invoke(concrete)+erased.measure(5)+wrong.value.measure(2.5);
}

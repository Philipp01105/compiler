package main;
import "stdlib/io";
import stdlib "stdlib/core";

func set_value(p: *int, value: int) -> void {
    *p = value;
}

func main() -> void {
    var first: *int = reserve(int);
    var second: *double = reserve(double);
    set_value(first, 42);
    *second = 3.5;
    io.println(*first);
    io.println(*second);
    free(second);
    free(first);
}

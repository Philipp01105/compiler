package main;
import "stdlib";
func choose(c:bit) -> int {
    var x=1;
    if(c) { x=4; } else { x=9; }
    return x;
}
func loop(limit:int) -> int {
    var x=0;
    while(x<limit) { x+=1; }
    return x;
}
func change(p:*int) -> int {
    var old=*p;
    *p+=1;
    return old+*p;
}
func address() -> double {
    var x:double=1.25;
    var p:*double = &x;
    x=3.5;
    return *p;
}
func reads(p:*int) -> int { return *p+*p; }
func effect() -> bit { stdlib.println("unexpected"); return true; }
func main() -> void {
    stdlib.println((2+3)*8+2);
    stdlib.println(choose(true));
    stdlib.println(choose(false));
    stdlib.println(loop(5));
    var value=7;
    stdlib.println(change(&value));
    stdlib.println(value);
    stdlib.println(reads(&value));
    stdlib.println(address());
    stdlib.println(false && effect());
    stdlib.println(true || effect());
    var dead=1;
    dead=2;
    stdlib.println(-0.0+0.0);
}

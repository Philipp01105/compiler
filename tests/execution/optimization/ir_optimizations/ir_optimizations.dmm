package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func choose(c:bit) -> int {
    var x = 1;
    if (c) {
        x = 4;
    } else {
        x = 9;
    }
    return x;
}

func loop(limit:int) -> int {
    var x = 0;
    while (x < limit) {
        x += 1;
    }
    return x;
}

func change(p:*int) -> int {
    var old = *p;
    *p += 1;
    return old + *p;
}

func address() -> double {
    var x:double = 1.25;
    var p:*double = (&x).(*double);
    x = 3.5;
    return *p;
}

func reads(p:*int) -> int {
    return *p + *p;
}

func effect() -> bit {
    io.println("unexpected");
    return true;
}

func main() -> void {
    io.println((2 + 3) * 8 + 2);
    io.println(choose(true));
    io.println(choose(false));
    io.println(loop(5));
    var value = 7;
    io.println(change((&value).(*int)));
    io.println(value);
    io.println(reads((&value).(*int)));
    io.println(address());
    io.println(false && effect());
    io.println(true || effect());
    var dead = 1;
    dead = 2;
    io.println(-0.0 + 0.0);
}

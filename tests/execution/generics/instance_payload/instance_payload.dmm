package main;
import "stdlib/io";
import stdlib "stdlib/core";

struct Payload<T> {
    var value: T;
}

func make() -> stdlib.Result<int, string> {
    return stdlib.Result<int, string>.Ok(42);
}

func main() -> void {
    var p: stdlib.Result<int, string> = make();
    io.println(p.Ok());
    io.println(make().Ok());
    p = stdlib.Result<int, string>.Err("failure");
    io.println(p.Err());
    var item: Payload<u64>;
    item.value = 18446744073709551615;
    var nested: stdlib.Result<Payload<u64>, int> = stdlib.Result<Payload<u64>, int>.Ok(item);
    var extracted: Payload<u64> = nested.Ok();
    extracted.value = 7;
    io.println(nested.Ok().value);
    io.println(extracted.value);
    var opt: stdlib.Option<int> = stdlib.Option<int>.Some(9);
    io.println(opt.Some());
}

import <stdlib>
enum Value<T> { Data(T), Empty, }
func copy<T>(value:Value<T>) -> Value<T> { return value; }
func main() -> void {
    var a:int[3]; a[0]=11; a[1]=22; a[2]=33;
    var value:Value<int[3]>=Value<int[3]>.Data(a);
    var other:Value<int[3]>=copy(value);
    a[0]=99;
    match(other) { Data(items) => { println(items[0]); println(items[2]); } Empty => println(0); }
    var number:int=17;
    var pointer:Value<*int>=Value<*int>.Data(&number);
    match(pointer) { Data(p) => println(*p); Empty => println(0); }
    var floating:Value<double>=Value<double>.Data(2.5);
    match(floating) { Data(x) => println(x); Empty => println(0); }
}

package main;

interface Marker {
    func marker() -> int;
}

struct Item {
    var value:int;

    func marker() -> int {
        return value;
    }
}

func identity<T>(value:T) -> T {
    return value;
}

func use(callable:func<X>(X) -> X) -> int {
    return callable(42);
}

func choose(callable:func<X>(X) -> X) -> func<Y>(Y) -> Y {
    return callable;
}

const retained = identity;

func main() -> int {
    var callable = identity;
    var mono:func(int) -> int = identity < int > ;
    var contextual:func(int) -> int = identity;
    var bounded:func<T:Marker>(T) -> T = identity;
    var integer:int = callable(42);
    var floating:double = callable(3.5);
    var returned = choose(identity);
    var item:Item;
    item.value = 9;
    var copy = bounded(item);
    if (integer != 42 || floating != 3.5) {
        return 1;
    }
    if (mono(7) != 7 || contextual(9) != 9 || retained(5) != 5) {
        return 2;
    }
    if (use(identity) != 42 || returned(11) != 11 || copy.value != 9) {
        return 3;
    }
    return 0;
}

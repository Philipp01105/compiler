import <stdlib>
struct Person { var name:string; }
impl Printable for Person { func toString() -> string { return name; } }
impl Equal for Person { func equal(other:Self) -> bit { return name == other.name; } }
func output<T:Printable>(value:T) -> void { println(value.toString()); }
func compare<T:Printable + Equal>(a:T,b:T) -> bit { output(a); return a.equal(b); }
func main() -> void {
    var p:Person; p.name="Ada";
    var q:Person; q.name="Ada";
    println(compare(p,q));
}

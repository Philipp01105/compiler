package main;
import "stdlib";

enum Value<T> {
    Data(T),
    Empty,
}

func copy<T>(value: Value<T>) -> Value<T> {
    return value;
}

func main() -> void {
    var a: int[3];
    a[0] = 11;
    a[1] = 22;
    a[2] = 33;
    var value: Value < int[3] >= Value<int[3]>.Data(a);
    var other: Value < int[3] >= copy(value);
    a[0] = 99;
    match (other) {
        Data(items) => {
            stdlib.println(items[0]);
            stdlib.println(items[2]);
        }
        Empty => stdlib.println(0);
    }
    var number: int = 17;
    var pointer: Value < * int >= Value< * int>.Data((&number).(*int));
    match (pointer) {
        Data(p) => stdlib.println(*p);
        Empty => stdlib.println(0);
    }
    var floating: Value < double >= Value<double>.Data(2.5);
    match (floating) {
        Data(x) => stdlib.println(x);
        Empty => stdlib.println(0);
    }
}

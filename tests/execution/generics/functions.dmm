import <stdlib>
func identity<T>(value:T) -> T { return value; }
func first<T>(values:T[]) -> T { return values[0]; }
func choose<T>(a:T,b:T) -> T { return b; }
func choose(a:int,b:int) -> int { return a+b; }
func factorial<T>(value:T) -> T {
    if (value <= 1) { return value; }
    return value * factorial(value - 1);
}
func main() -> void {
    println(identity(42));
    println(identity("hello"));
    println(identity('Z'));
    println(identity(2.5));
    println(identity(43));
    println(choose(2,3));
    var numbers:int[3]; numbers[0]=7;
    println(first(numbers));
    println(factorial(5));
    var x:int=8; var p:*int=identity(&x); println(*p);
}

package main;
import "stdlib";

var packageFixed:int[5] = [3, 4; 5];
var packageSlice:int[] = [6, 7, 8];

func sum(values:int[]) -> int {
    var total:int = 0;
    for (var i:int = 0; i < 6; i++) {
        total += values[i];
    }
    return total;
}

func fixed() -> int[4] {
    return [1, 2, 3, 4];
}

func forwarded() -> int[] {
    return numbers();
}

func numbers() -> int[] {
    return [7, 8, 9];
}

func main() -> void {
    stdlib.println(packageFixed[4]);
    stdlib.println(packageSlice[1]);
    var fixedValues:int[4] = [0, 1; 4];
    stdlib.println(fixedValues[0]);
    stdlib.println(fixedValues[3]);
    fixedValues = [4, 5, 6, 7];
    stdlib.println(fixedValues[2]);

    var sliceValues:int[] = [1, 2; 6];
    var copied:int[] = sliceValues;
    copied[1] = 9;
    stdlib.println(sliceValues[1]);
    stdlib.println(sum([1, 2, 3; 6]));

    var returnedFixed:int[4] = fixed();
    stdlib.println(returnedFixed[3]);
    var returnedSlice:int[] = numbers();
    stdlib.println(returnedSlice[2]);
    var forwardedSlice:int[] = forwarded();
    stdlib.println(forwardedSlice[0]);

    var reassigned:int[] = [1, 2];
    reassigned = [5, 6, 7];
    stdlib.println(reassigned[2]);
}

package main;
import "stdlib";

var global_values: int[2][2] = [[6, 7],[8, 9]];

struct Grid {
    var values: int[2][3];
}

func sum(values: int[2][3]) -> int {
    return values[0][0] + values[1][1] + values[2][0];
}

func middle(values: int[2][3]) -> int[2] {
    return values[1];
}

func identity<T>(value: T) -> T {
    return value;
}

func singleton<T>(value: T) -> T[] {
    return [value];
}

func main() -> void {
    var values: int[2][3] = [[1, 2],[3, 4],[5, 6]];
    values[1][0] = 9;
    var row: int[2] = middle(values);
    var grid: Grid;
    grid.values = values;
    var copied: int[2][3] = identity(values);
    var view: int[2][] = values;
    var pointer: *(int[2]) = (&values[0]).(*(int[2]));
    var raw: int[2][] = slice(pointer, 3);
    var data: *(int[2]) = raw.data;
    var literal_view: int[2][] = [[10, 11],[12, 13]];
    var grouped:(int[2])[3] = values;
    var ragged: int[][] = [[14, 15],[16, 17, 18]];
    var fixed_views: int[][2] = [[19, 20],[21, 22, 23]];
    var singleton_rows: int[2][] = singleton(values[1]);
    var flat: int[5] = [1, 2, 3, 4, 5];
    var middle_view: int[] = flat[1: 4];
    var prefix_view: int[] = flat[: 2];
    var suffix_view: int[] = flat[3:];
    var full_view: int[] = flat[:];
    middle_view[0] = 20;
    var same_middle: int[] = [20, 3, 4];

    stdlib.println(global_values[1][0]);
    stdlib.println(values[1][0]);
    stdlib.println(row[1]);
    stdlib.println(sum(grid.values));
    stdlib.println(copied[0][1]);
    stdlib.println(view.length);
    stdlib.println(view[2][0]);
    stdlib.println(raw[2][1]);
    stdlib.println(data[1][0]);
    stdlib.println(literal_view[1][1]);
    stdlib.println(grouped[0][0]);
    stdlib.println(ragged[1][2]);
    stdlib.println(fixed_views[1][1]);
    stdlib.println(singleton_rows[0][0]);
    stdlib.println(sizeof(int[2][3]));
    stdlib.println(middle_view.length);
    stdlib.println(prefix_view[1]);
    stdlib.println(suffix_view[1]);
    stdlib.println(full_view[1]);
    stdlib.println(middle_view == same_middle);
    stdlib.println(middle_view != prefix_view);
}

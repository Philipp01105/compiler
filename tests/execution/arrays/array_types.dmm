import <stdlib>

func main() -> void {
    var chars:char[2];
    var bytes:byte[2];
    var bits:bit[2];
    var floats:float[2];
    var doubles:double[2];
    chars[1] = 'Z';
    bytes[1] = 255;
    bits[1] = true;
    floats[1] = 1.25;
    doubles[1] = 2.5;
    var c:char = chars[1];
    var b:byte = bytes[1];
    var flag:bit = bits[1];
    var f:float = floats[1];
    var d:double = doubles[1];
    println(c);
    println(b);
    println(flag);
    println(f);
    println(d);
}

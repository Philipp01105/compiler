package main;
import "stdlib/io";
import stdlib "stdlib/core";
// Nested loops test
func main() -> void {
    io.println("Multiplication table (1-3):");
    for (var i: int = 1; i <= 3; i++) {
        for (var j: int = 1; j <= 3; j++) {
            var product: int = i * j;
            {
                var _output0: string = "  " + i + " x " + j + " = " + product;
                io.println(_output0);
                free(_output0);
            }
        }
    }
}

// Category: execution/control_flow

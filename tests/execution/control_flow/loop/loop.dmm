package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);
// Loop test
func main() -> void {
    io.println("Counting from 1 to 5:");
    for (var i:int = 1; i <= 5; i++) {
        {
            var _output0:string = "  " + i;
            io.println(_output0);
            free(_output0);
        }
    }
    io.println("Done!");
}

// Category: execution/control_flow

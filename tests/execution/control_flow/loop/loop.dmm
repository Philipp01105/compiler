package main;
import "stdlib";
// Loop test
func main() -> void {
    stdlib.println("Counting from 1 to 5:");
    for (var i: int = 1; i <= 5; i++) {
        {
            var _output0: string = "  " + i;
            stdlib.println(_output0);
            free(_output0);
        }
    }
    stdlib.println("Done!");
}

// Category: execution/control_flow

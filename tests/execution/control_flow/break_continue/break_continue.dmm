package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func main() -> void {
    var total:int = 0;
    var i:int = 0;
    while (i < 10) {
        i++;
        if (i % 2 == 0) {
            continue;
        }
        if (i > 7) {
            break;
        }
        total += i;
    }
    io.println(total);
}

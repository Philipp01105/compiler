import <stdlib>

// Loop test
func main() -> void {
    println("Counting from 1 to 5:");
    for (var i:int = 1; i <= 5; i++) {
        {
            var _output0:string = "  " + i;
            println(_output0);
            free(_output0);
        }
    }
    println("Done!");
}
// Category: execution/control_flow

import <stdlib>

// else if chain test
func main() -> void {
    var score:int = 85;
    
    println("Score: " + score);
    
    if (score >= 90) {
        println("Grade: A");
    } else if (score >= 80) {
        println("Grade: B");
    } else if (score >= 70) {
        println("Grade: C");
    } else if (score >= 60) {
        println("Grade: D");
    } else {
        println("Grade: F");
    }
}
// Category: execution/control_flow

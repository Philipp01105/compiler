package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);
// Conditional test
func main() -> void {
    var x:int = 10;
    if (x > 5) {
        io.println("x is greater than 5");
    } else {
        io.println("x is not greater than 5");
    }
    if (x == 10) {
        io.println("x equals 10");
    }
}

// Category: execution/control_flow

package main;
// Test syscall-based I/O without stdlib import
func main() -> void {
    var msg:string = "Hello from syscalls!\n";
    
    // Calculate string length using built-in
    var len:int = io_strlen(msg);
    
    // Write to stdout using built-in syscall
    sys_write(1, msg, len);
}
// Category: execution/io

import <stdlib>
func main() -> void {
    println(System.in.fd);
    println(System.out.fd);
    var result:int = write_file("stdlib_io.tmp", "ok");
    println(result);
    var buffer:char[8];
    var count:int = read_file("stdlib_io.tmp", buffer, 7);
    println(count);
    sys_write(System.out.fd, buffer, count);
    println("");
}

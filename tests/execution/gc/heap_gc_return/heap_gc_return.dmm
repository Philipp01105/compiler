package main;
import "stdlib/io";
import stdlib "stdlib/core";
// Manual allocation with an explicit return statement.
func test() -> void {
    var t: *int = reserve(int);
    *t = 10;
    io.println("Inside test function");
    free(t);
    return;
}

func main() -> int {
    var x = 10;
    var y: int = 10;
    test();
    io.println("Back in main");
    return 0;
}

// Category: execution/gc

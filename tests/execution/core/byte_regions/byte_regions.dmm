package main;
import (
    "stdlib/core"
    ioraw "stdlib/io/raw"
    memraw "stdlib/memory/raw"
);

struct Buffer {
    var data:*u8;
    var length:usize;
}

func create_buffer(length:usize) -> Buffer {
    var buffer:Buffer;
    buffer.data = memraw.core_alloc(length);
    buffer.length = length;
    if (buffer.data == memraw.core_null()) {
        memraw.core_trap();
    }
    memraw.core_fill(buffer.data, 0, length);
    return buffer;
}

func main() -> int {
    var buffer:Buffer = create_buffer(8);
    memraw.core_copy(buffer.data, memraw.core_string_data("abcdef"), 6);
    // Overlap in both directions, then typed byte loads/stores.
    memraw.core_copy(memraw.core_offset(buffer.data, 1), buffer.data, 5);
    memraw.core_copy(buffer.data, memraw.core_offset(buffer.data, 1), 5);
    // Negative displacement, identity copy, and a disjoint copy use the same
    // ordinary DMM implementation as overlap handling.
    if (memraw.core_offset(memraw.core_offset(buffer.data, 5), -5) != buffer.data) {
        return 10;
    }
    memraw.core_copy(buffer.data, buffer.data, 5);
    memraw.core_copy(memraw.core_offset(buffer.data, 6), buffer.data, 2);
    if (memraw.core_load(buffer.data, 6) != 97 || memraw.core_load(buffer.data, 7) != 98) {
        return 11;
    }
    memraw.core_store(buffer.data, 5, 10);
    if (memraw.core_load(buffer.data, 0) != 97 || memraw.core_load(buffer.data, 4) != 101) {
        return 1;
    }
    if (ioraw.core_write(ioraw.CORE_STDOUT, buffer.data, 6) != 6) {
        return 2;
    }
    if (memraw.core_string_length("hello") != 5) {
        return 3;
    }
    var fd:int = ioraw.core_open(
        "core_bytes.dat",
        ioraw.CORE_WRITE_ONLY + ioraw.CORE_CREATE + ioraw.CORE_TRUNCATE,
        384
    );
    if (fd < 0 || ioraw.core_write(fd, buffer.data, 6) != 6 || ioraw.core_close(fd) != 0) {
        return 6;
    }
    fd = ioraw.core_open("core_bytes.dat", ioraw.CORE_READ_ONLY, 0);
    if (fd < 0) {
        return 7;
    }
    memraw.core_fill(buffer.data, 255, buffer.length);
    if (
        ioraw.core_read(fd, buffer.data, buffer.length) != 6
        || ioraw.core_read(fd, buffer.data, 1) != 0
    ) {
        return 8;
    }
    if (
        ioraw.core_close(fd) != 0
        || memraw.core_load(buffer.data, 5) != 10
        || memraw.core_load(buffer.data, 6) != 255
    ) {
        return 9;
    }
    if (ioraw.core_close(-1) >= 0) {
        return 4;
    }
    var empty:*u8 = memraw.core_null();
    memraw.core_copy(empty, empty, 0);
    memraw.core_fill(empty, 255, 0);
    memraw.core_release(empty);
    if (memraw.core_alloc((-1).(usize)) != empty) {
        return 5;
    }
    memraw.core_release(buffer.data);
    return 0;
}

package main;

struct Pair {
    var first:int;
    var second:int;
    destructor {}
}

func branchRoundTrip(condition:int) -> int {
    var pair:Pair;
    pair.first=3;
    pair.second=4;
    if (condition) {
        var moved=pair;
        pair=moved;
    } else {
        var moved=pair;
        pair=moved;
    }
    return pair.first+pair.second;
}

func loopRoundTrip() -> int {
    var pair:Pair;
    pair.first=5;
    pair.second=6;
    for (var index:int=0; index<2; index++) {
        var moved=pair;
        pair=moved;
    }
    return pair.first+pair.second;
}

func main() -> int {
    var pair:Pair;
    pair.first=1;
    pair.second=2;

    var left=&mut pair.first;
    var right=&mut pair.second;
    *left=10;
    *right=20;

    // Both borrows end at their last use.
    pair.first+=1;
    pair.second+=2;

    var moved=pair;
    pair=moved;
    return pair.first+pair.second+branchRoundTrip(0)+branchRoundTrip(1)+loopRoundTrip()-58;
}

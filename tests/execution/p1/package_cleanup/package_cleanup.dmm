package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

struct FirstResource {
    var value:int;
    destructor {
        io.println(1);
    }
}

struct SecondResource {
    var value:int;
    destructor {
        io.println(2);
    }
}

var first:FirstResource;
var second:SecondResource;

func main() -> int {
    return 0;
}

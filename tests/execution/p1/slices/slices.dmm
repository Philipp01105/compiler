package main;
func sum(values:int[]) -> int {
    var total:int = 0;
    for (var i:int = 0; i < values.length; i++) { total += values[i]; }
    return total;
}

func forward(a:int, b:int, c:int, d:int, e:int, values:int[], tail:int) -> int {
    values[1] = 9;
    return a+b+c+d+e+sum(values)+tail+values.length.(int);
}

func main() -> int {
    var values:int[3];
    values[0] = 2;
    values[1] = 3;
    values[2] = 4;
    var result:int = forward(1, 2, 3, 4, 5, values, 6);
    if (result != 39) { return 1; }
    if (values[1] != 9) { return 2; }
    return 0;
}

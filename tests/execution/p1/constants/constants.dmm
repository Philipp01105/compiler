package main;
const count: int = 2 + 3;
const greeting = "folded" + " constants";
const widened: double = 3;
const rounded: float = (1.25 + 2.5).(float);
const letter: char = (321).(char);
const float_match: bit = (16777216).(float) == 16777217;
const labeled = "count=" + count + ", char=" + 'A' + ", fraction=" + 2.5;
const same: bit = ("hello" + " world") == "hello world";
const different: bit = "left" != "right";
const safe: bit = true || (1 / 0 == 0);

func main() -> int {
    const local: int = count * 2;
    const truncated = (7.9).(int);
    var values: int[local];
    values[9] = truncated;
    if (values[9] != 7) {
        return 1;
    }
    if (widened != 3.0) {
        return 2;
    }
    if (greeting != "folded constants") {
        return 3;
    }
    if ((258).(byte).(int) != 2) {
        return 4;
    }
    if (labeled != "count=5, char=A, fraction=2.500000") {
        return 5;
    }
    if (!same || !different || !safe) {
        return 6;
    }
    if (rounded != 3.75 || letter != 'A') {
        return 7;
    }
    var runtime_float: float = (16777216).(float);
    if (!float_match || !(runtime_float == 16777217)) {
        return 8;
    }
    return 0;
}

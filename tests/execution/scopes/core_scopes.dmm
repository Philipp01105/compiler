func main() -> void {
    var x:int = 10;
    { var x:int = 20; println(x); }
    { var x:int = 30; println(x); }
    println(x);
    var total:int = 0;
    for (var i:int=0; i<4; i++) {
        if (i==1) { continue; }
        var j:int = 0;
        while (j<4) {
            j++;
            if (j==3) { break; }
            total += i;
        }
    }
    println(total);
    var zero:int;
    println(zero);
    var [3000] values:int;
    values[2999] = 42;
    var p:*int = &x;
    *p = 7;
    modify(p);
    println(x);
    println(values[2999]);
    println(values[0]);
    values[1] = 5;
    println(first(values));
    var empty:string;
    var [2] names:string;
    println(empty==names[1]);
    var cursor:int=0;
    values[index(&cursor)] += 3;
    println(cursor);
    println(values[0]);
}
func modify(p:*int) -> void { *p += 2; }
func first(a[]:int) -> int { return a[1]; }
func index(p:*int) -> int { var old:int=*p; *p += 1; return old; }
// Category: execution/scopes

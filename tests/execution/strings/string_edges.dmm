import <stdlib>

func echo(value:string) -> string { return value; }

func main() -> void {
    println("" == "");
    println(echo("hello"));
    println(('\n').(int));
    println(('\t').(int));
    println(('\r').(int));
    println(('\0').(int));
    println(('\\').(int));
    println(('\"').(int));
    println(('\'').(int));
}

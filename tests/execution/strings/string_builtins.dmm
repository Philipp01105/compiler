import <stdlib>

func main() -> void {
    var buffer:char[32];
    strcpy(buffer, "typed");
    strcat(buffer, " IR");
    {
        var _output0:string = "" + buffer;
        println(_output0);
        free(_output0);
    }
    println(strlen(buffer));
    println(strcmp(buffer, "typed IR"));
    var copy:string = strdup(buffer);
    println(copy == "typed IR");
    free(copy);

    var number:char[16];
    println(io_int_to_str(-123, number, 16));
    {
        var _output1:string = "" + number;
        println(_output1);
        free(_output1);
    }
    println(io_str_to_int(number));

    var joined:string = "native" + " backend";
    println(joined);
    free(joined);

    var allocation:*int = reserve(int);
    *allocation = 77;
    println(*allocation);
    free(allocation);
}

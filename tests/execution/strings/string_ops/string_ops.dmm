package main;
import "stdlib/io";
import stdlib "stdlib/core";
// String operations test
func main() -> void {
    var name: string = "Alice";
    if (name == "Alice") {
        io.println("Name is Alice");
    }
    if (name != "Bob") {
        io.println("Name is not Bob");
    }
    io.println("Test complete");
}

// Category: execution/strings

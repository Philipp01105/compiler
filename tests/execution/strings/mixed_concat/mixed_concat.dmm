package main;
import "stdlib";
func main() -> void {
    var empty:string;
    var count:int = -12;
    var ratio:double = 2.5;
    var letter:char = 'Q';
    var enabled:bit = true;
    var value:string = empty + "n=" + count + ",r=" + ratio + ",c=" + letter +
                       ",b=" + enabled;
    stdlib.println(value);
    free(value);
}

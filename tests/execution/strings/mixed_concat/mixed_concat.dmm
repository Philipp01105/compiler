package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func main() -> void {
    var empty:string;
    var count:int = -12;
    var ratio:double = 2.5;
    var letter:char = 'Q';
    var enabled:bit = true;
    var value:string = empty + "n=" + count + ",r=" + ratio + ",c=" + letter + ",b=" + enabled;
    io.println(value);
    free(value);
}

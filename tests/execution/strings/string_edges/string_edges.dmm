package main;
import "stdlib/io";
import stdlib "stdlib/core";

func echo(value: string) -> string {
    return value;
}

func main() -> void {
    io.println("" == "");
    io.println(echo("hello"));
    io.println(('\n').(int));
    io.println(('\t').(int));
    io.println(('\r').(int));
    io.println(('\0').(int));
    io.println(('\\').(int));
    io.println(('\"').(int));
    io.println(('\'').(int));
}

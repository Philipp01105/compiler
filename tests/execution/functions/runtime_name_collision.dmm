import <stdlib>

func printf(value:int) -> int { return value + 1; }
func strlen(value:int) -> int { return value * 2; }
func write(value:int) -> int { return value + 3; }
func open(value:int) -> int { return value + 4; }
func close(value:int) -> int { return value + 5; }
func __errno_location() -> int { return 123; }
func exit(value:int) -> int { return value + 6; }
func WriteFile(value:int) -> int { return value + 7; }
func VirtualAlloc(value:int) -> int { return value + 8; }

func main() -> void {
    println(printf(4));
    println(strlen(5));
    println(write(5));
    println(open(5));
    println(close(5));
    println(__errno_location());
    println(exit(5));
    println(WriteFile(5));
    println(VirtualAlloc(5));
    var fd:int = sys_open("runtime_collision.tmp", 577, 384);
    println(fd >= 0);
    println(sys_write(fd, "x", 1));
    println(sys_close(fd));
    println(sys_close(-1) < 0);
}

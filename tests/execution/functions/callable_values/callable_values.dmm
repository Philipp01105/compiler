package main;

func increment(value:int) -> int {
    return value + 1;
}

func plusTwo(value:int) -> int {
    return value + 2;
}

func half(value:double) -> double {
    return value / 2.0;
}

func apply(callable:func(int) -> int, value:int) -> int {
    return callable(value);
}

func select() -> func(int) -> int {
    return increment;
}

const constant_callable:func(int) -> int = increment;
var global_callable:func(int) -> int = increment;

struct Counter {
    var value:int;

    func add(amount:int) -> int {
        return value + amount;
    }

    static func twice(value:int) -> int {
        return value * 2;
    }
}

struct Holder {
    var callable:func(int) -> int;
}

enum Choice {
    None,
    Some(func(int) -> int)
}

interface Readable {
    func fetch(multiplier:int) -> int;
}

struct Reading {
    var value:int;

    func fetch(multiplier:int) -> int {
        return value * multiplier;
    }
}

func main() -> int {
    var callable:func(int) -> int = increment;
    var floating:func(double) -> double = half;
    if (callable != global_callable || callable == plusTwo) {
        return 1;
    }
    if (floating(8.0) != 4.0 || constant_callable(1) != 2) {
        return 2;
    }
    if (callable(41) + apply(increment, 1) + select()(2) != 47) {
        return 3;
    }

    var twice:func(int) -> int = Counter.twice;
    var add:func(*Counter,int) -> int = Counter.add;
    var counter:Counter;
    counter.value = 40;
    if (twice(2) + add((&counter).(*Counter), 1) != 45) {
        return 4;
    }

    var holder:Holder;
    holder.callable = increment;
    var functions:(func(int) -> int)[2];
    functions[0] = increment;
    functions[1] = plusTwo;
    var view:(func(int) -> int)[] = functions;
    var choice = Choice.Some(plusTwo);
    var payload = choice.Some();
    if (holder.callable(1) + view[0](2) + view[1](3) + payload(4) != 16) {
        return 5;
    }

    var readings:Readable[1];
    var reading:Reading;
    reading.value = 7;
    readings[0] = reading;
    var fetcher:func(*Readable,int) -> int = Readable.fetch;
    if (fetcher((&readings[0]).(*Readable), 6) != 42) {
        return 6;
    }
    return 0;
}

package main;
import "stdlib/io";
import stdlib "stdlib/core";

func printf(value: int) -> int {
    return value + 1;
}

func strlen(value: int) -> int {
    return value * 2;
}

func write(value: int) -> int {
    return value + 3;
}

func open(value: int) -> int {
    return value + 4;
}

func close(value: int) -> int {
    return value + 5;
}

func __errno_location() -> int {
    return 123;
}

func exit(value: int) -> int {
    return value + 6;
}

func WriteFile(value: int) -> int {
    return value + 7;
}

func VirtualAlloc(value: int) -> int {
    return value + 8;
}

func main() -> void {
    io.println(printf(4));
    io.println(strlen(5));
    io.println(write(5));
    io.println(open(5));
    io.println(close(5));
    io.println(__errno_location());
    io.println(exit(5));
    io.println(WriteFile(5));
    io.println(VirtualAlloc(5));
    var fd: int = sys_open("runtime_collision.tmp", 577, 384);
    io.println(fd >= 0);
    io.println(sys_write(fd, "x", 1));
    io.println(sys_close(fd));
    io.println(sys_close(-1) < 0);
}

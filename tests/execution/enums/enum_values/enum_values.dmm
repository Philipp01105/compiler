package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

enum State(code:int, text:string, weight:float, active:bit) {
    idle(-1, "idle", -1.5, false),
    ready(2, "ready", 2.25, true)
}

func echo(value:State) -> State {
    return value;
}

func main() -> void {
    var state:State = State.idle;
    io.println(state == State.idle);
    io.println(state.code);
    io.println(state.text);
    io.println(state.weight);
    io.println(state.active);
    state = echo(State.ready);
    io.println(state != State.idle);
    io.println(state.code);
    io.println(state.text);
    io.println(state.weight);
    io.println(state.active);
}

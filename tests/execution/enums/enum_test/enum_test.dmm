package main;
import "stdlib/io";
import stdlib "stdlib/core";

enum test(id: int, name: string) {
    In(1, "test"),
    Out(2, "test2")
}

func main() -> void {
    io.print("In id: ");
    io.print(test.In.id);
    io.println("");
    io.print("Out id: ");
    io.print(test.Out.id);
    io.println("");
    io.print("In name: ");
    io.print(test.In.name);
    io.println("");
    io.print("Out name: ");
    io.print(test.Out.name);
    io.println("");
}

// Category: execution/enums

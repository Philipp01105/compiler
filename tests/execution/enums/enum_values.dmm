enum State(code:int, text:string, weight:float, active:bit) {
    idle(-1, "idle", -1.5, false),
    ready(2, "ready", 2.25, true)
}

func echo(value:State) -> State {
    return value;
}

func main() -> void {
    var state:State = State.idle;
    println(state == State.idle);
    println(state.code);
    println(state.text);
    println(state.weight);
    println(state.active);
    state = echo(State.ready);
    println(state != State.idle);
    println(state.code);
    println(state.text);
    println(state.weight);
    println(state.active);
}

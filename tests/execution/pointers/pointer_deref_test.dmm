import <stdlib>

// Test pointer dereferencing, address-of, and writes through heap pointers.

// Test 1: Basic pointer and dereference
func test1_basic_deref() -> void {
    println("[TEST 1] Basic pointer dereference");
    
    var x:int = 42;
    var p:*int = &x;  // Get address of x
    var value:int = *p;  // Dereference p to get value
    
    print("Original value: ");
    println(x);
    print("Value through pointer: ");
    println(value);
    
    println("  [OK] Basic dereference works");
}

// Test 2: Multiple int pointers
func test2_multiple_pointers() -> void {
    println("[TEST 2] Multiple int pointers");
    
    var a:int = 100;
    var b:int = 200;
    
    var pa:*int = &a;
    var pb:*int = &b;
    
    print("First value: ");
    println(*pa);
    print("Second value: ");
    println(*pb);
    
    println("  [OK] Multiple pointers work");
}

// Test 3: Heap allocated pointer dereference
func test3_heap_deref() -> void {
    println("[TEST 3] Heap allocated pointer dereference");
    
    var p:*int = reserve(int);
    
    *p = 73;
    println("Heap value: " + *p);
    
    free(p);
    println("  [OK] Heap pointer freed");
}

func main() -> void {
    println("============================================");
    println("  POINTER DEREFERENCE TEST");
    println("============================================");
    println("");
    
    test1_basic_deref();
    test2_multiple_pointers();
    test3_heap_deref();
    
    println("");
    println("============================================");
    println("  ALL TESTS PASSED!");
    println("============================================");
}

import <stdlib>

func write(p:*int, value:int) -> void { *p = value; }

func main() -> void {
    var value:int = 10;
    var first:*int = &value;
    var second:*int = first;
    write(first, 41);
    *second += 1;
    println(value);
    println(*first == *second);

    var values:int[2];
    values[1] = 77;
    var element:*int = &values[1];
    println(*element);
}

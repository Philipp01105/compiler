package main;
import "stdlib/io";
import stdlib "stdlib/core";
// Test pointer parameters in functions
func modify_value(p: *int) -> void {
    *p = 42;
}

func swap_values(a: *int, b: *int) -> void {
    var temp: int = *a;
    *a = *b;
    *b = temp;
}

func main() -> void {
    io.println("=== Pointer Parameter Test ===");
    // Test 1: Modify value through pointer parameter
    io.println("");
    io.println("Test 1: Modify value through pointer");
    var x: *int = reserve(int);
    *x = 10;
    io.print("Before: ");
    io.println(*x);
    modify_value(x);
    io.print("After:  ");
    io.println(*x);
    free(x);
    // Test 2: Swap two values using pointer parameters
    io.println("");
    io.println("Test 2: Swap two values");
    var a: *int = reserve(int);
    var b: *int = reserve(int);
    *a = 100;
    *b = 200;
    io.print("Before swap: a=");
    io.print(*a);
    io.print(", b=");
    io.println(*b);
    swap_values(a, b);
    io.print("After swap:  a=");
    io.print(*a);
    io.print(", b=");
    io.println(*b);
    free(a);
    free(b);
    io.println("");
    io.println("=== All Tests Passed ===");
}

// Category: execution/pointers

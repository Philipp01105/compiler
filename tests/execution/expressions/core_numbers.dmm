func main() -> void {
    var a:int = -7;
    println("sub=" + (10-3-2));
    println("negative=" + (a/2) + "," + (a%2));
    println("equal=" + (-1 == (0-1)));
    var f:float = 1.5;
    var d:double = f+2;
    println("double=" + d);
    println("math=" + (-d*2.0/4.0));
    f = float(d/2.0);
    println("float=" + f);
    println("convert=" + int(-3.9));
    println("compare=" + (1.25<2.0) + (2.0>=2) + (1.0!=2.0));
    var b:byte = 255;
    var ch:char = 'A';
    var flag:bit = bit(4);
    println("small=" + b + "," + ch + "," + flag);
    println("short=" + (false && noisy()) + (true || noisy()));
    var nan:double = 0.0/0.0;
    println("nan=" + (nan==nan) + (nan!=nan) + (nan<0.0) + bit(nan));
}
func noisy() -> bit { println("SHOULD NOT RUN"); return true; }
// Category: execution/expressions

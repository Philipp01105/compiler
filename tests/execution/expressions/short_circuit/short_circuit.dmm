package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func rhs() -> bit {
    io.println("RIGHT OPERAND EXECUTED");
    return true;
}

func main() -> void {
    if (true || rhs()) {
        io.println("OR PASS");
    }
    if (false && rhs()) {
        io.println("unreachable");
    } else {
        io.println("AND PASS");
    }
    if (true && (false || rhs())) {
        io.println("NESTED AND PASS");
    }
    if (false || (true && rhs())) {
        io.println("NESTED OR PASS");
    }
    if (true || (false && rhs())) {
        io.println("NESTED SKIP PASS");
    }
}

package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func main() -> void {
    var x:int = -37;
    var add_identity:bit = x + 0 == x;
    var multiply_identity:bit = x * 1 == x;
    var reflexive:bit = x == x;
    var negated_inequality:bit = !(x != x);
    var round_trip:bit = (x + 5) - 5 == x;
    io.println(add_identity);
    io.println(multiply_identity);
    io.println(reflexive);
    io.println(negated_inequality);
    io.println(round_trip);
}

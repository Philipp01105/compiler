package main;
import "stdlib";

func main() -> void {
    var x: int = -37;
    var add_identity: bit = x + 0 == x;
    var multiply_identity: bit = x * 1 == x;
    var reflexive: bit = x == x;
    var negated_inequality: bit = !(x != x);
    var round_trip: bit = (x + 5) - 5 == x;
    stdlib.println(add_identity);
    stdlib.println(multiply_identity);
    stdlib.println(reflexive);
    stdlib.println(negated_inequality);
    stdlib.println(round_trip);
}

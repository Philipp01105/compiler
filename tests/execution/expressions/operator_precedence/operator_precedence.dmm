package main;
import "stdlib/io";
import stdlib "stdlib/core";

func main() -> void {
    var grouped: int = (1 + 2) * 3;
    io.println(1 + 2 * 3);
    io.println(grouped);
    io.println(1 + 2 * 3 == 7);
    io.println(1 + 2 < 4 && 5 > 3);
    io.println(true || false && false);
    io.println(!(1 == 2));
    io.println(20 / 5 * 2 + 3 % 2);
    io.println(-2 * 3 + 10);
}

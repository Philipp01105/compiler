import <stdlib>

func main() -> void {
    var x:int = -37;
    var add_identity:bit = x + 0 == x;
    var multiply_identity:bit = x * 1 == x;
    var reflexive:bit = x == x;
    var negated_inequality:bit = !(x != x);
    var round_trip:bit = (x + 5) - 5 == x;
    println(add_identity);
    println(multiply_identity);
    println(reflexive);
    println(negated_inequality);
    println(round_trip);
}

package main;
import "stdlib";
// Basic arithmetic operations test
func main() -> void {
    var a: int = 10;
    var b: int = 5;
    {
        var _output0: string = "Addition: " + (a + b);
        stdlib.println(_output0);
        free(_output0);
    }
    {
        var _output1: string = "Subtraction: " + (a - b);
        stdlib.println(_output1);
        free(_output1);
    }
    {
        var _output2: string = "Multiplication: " + (a * b);
        stdlib.println(_output2);
        free(_output2);
    }
    {
        var _output3: string = "Division: " + (a / b);
        stdlib.println(_output3);
        free(_output3);
    }
    {
        var _output4: string = "Modulo: " + (a % b);
        stdlib.println(_output4);
        free(_output4);
    }
}

// Category: execution/expressions

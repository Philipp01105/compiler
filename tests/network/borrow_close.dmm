package main;
import "stdlib/core/net";
func main()->void {
    var result=net.socket(net.AddressFamily.IPv4,net.Transport.UDP);
    match(result) {
        Ok(socket)=>{
            var buffer:u8[4]; var view:u8[]=buffer[:];
            var pending=net.recvFrom(&socket,&mut view,net.Deadline.noTimeout());
            var closed=net.close(socket);
            block_on(cancel(pending));
        }
        Err(error)=>{}
    }
}

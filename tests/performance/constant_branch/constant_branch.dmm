package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

func work(n:int) -> int {
    var i = 0;
    var total = 0;
    while (i < n) {
        if (true) {
            total += 1;
        } else {
            total -= 1;
        }
        i += 1;
    }
    return total;
}

func main() -> void {
    io.println(work(20000000));
}

package main;
import "stdlib/io";
import stdlib "stdlib/core";

func work(n: int) -> int {
    var values: int[4];
    values[0] = 1;
    values[1] = 2;
    var i = 0;
    var index = 0;
    var total = 0;
    while (i < n) {
        total += values[index] + values[index];
        index = 1 - index;
        i += 1;
    }
    return total;
}

func main() -> void {
    io.println(work(20000000));
}

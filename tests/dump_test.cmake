include("${CMAKE_CURRENT_LIST_DIR}/source_fixture.cmake")
cmake_minimum_required(VERSION 3.21)
if (NOT DEFINED COMPILER OR NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "COMPILER, SOURCE_DIR, and OUTPUT_DIR are required")
endif ()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

set(fixture "${SOURCE_DIR}/tests/unit/frontend_ast_fixture/frontend_ast_fixture.dmm")
set(ast "${OUTPUT_DIR}/fixture.ast")
set(tokens "${OUTPUT_DIR}/fixture.tokens")
set(symbols "${OUTPUT_DIR}/fixture.symbols")
set(preopt_ir "${OUTPUT_DIR}/fixture.preopt.ir")
set(ir "${OUTPUT_DIR}/fixture.ir")
set(cfg "${OUTPUT_DIR}/fixture.cfg")
set(tokens_second "${OUTPUT_DIR}/fixture-second.tokens")
set(symbols_second "${OUTPUT_DIR}/fixture-second.symbols")
set(preopt_ir_second "${OUTPUT_DIR}/fixture-second.preopt.ir")
set(cfg_second "${OUTPUT_DIR}/fixture-second.cfg")
set(intel_map "${OUTPUT_DIR}/fixture-intel.map")
set(att_map "${OUTPUT_DIR}/fixture-att.map")
execute_process(COMMAND "${COMPILER}" --emit=asm --deterministic --syntax=intel
        --dump-tokens "${tokens}" --dump-ast "${ast}" --dump-symbols "${symbols}"
        --dump-ir-before-opt "${preopt_ir}" --dump-ir "${ir}" --dump-cfg "${cfg}"
        --source-map "${intel_map}"
        -o "${OUTPUT_DIR}/fixture-intel.s" "${fixture}" RESULT_VARIABLE intel_result)
execute_process(COMMAND "${COMPILER}" --emit=asm --deterministic --syntax=att
        --dump-tokens "${tokens_second}" --dump-symbols "${symbols_second}"
        --dump-ir-before-opt "${preopt_ir_second}" --dump-cfg "${cfg_second}"
        --source-map "${att_map}" -o "${OUTPUT_DIR}/fixture-att.s" "${fixture}"
        RESULT_VARIABLE att_result)
if (NOT intel_result EQUAL 0 OR NOT att_result EQUAL 0)
    message(FATAL_ERROR "Could not produce dump-format fixtures")
endif ()
file(SHA256 "${intel_map}" intel_map_hash)
file(SHA256 "${att_map}" att_map_hash)
if (NOT intel_map_hash STREQUAL att_map_hash)
    message(FATAL_ERROR "Instruction source maps differ between assembly syntaxes")
endif ()
foreach (kind tokens symbols preopt_ir cfg)
    file(SHA256 "${${kind}}" first_hash)
    file(SHA256 "${${kind}_second}" second_hash)
    if (NOT first_hash STREQUAL second_hash)
        message(FATAL_ERROR "${kind} dump is not deterministic")
    endif ()
endforeach ()

file(READ "${ast}" ast_dump)
file(READ "${tokens}" token_dump)
file(READ "${symbols}" symbol_dump)
file(READ "${preopt_ir}" preopt_ir_dump)
file(READ "${ir}" ir_dump)
file(READ "${cfg}" cfg_dump)
foreach (fragment "dmm-tokens-v1" "type=KEYWORD_FUNC" "span=" "text=\"main\"")
    string(FIND "${token_dump}" "${fragment}" position)
    if (position LESS 0)
        message(FATAL_ERROR "Token dump is missing '${fragment}'")
    endif ()
endforeach ()
foreach (fragment "dmm-symbols-v1" "kind=function" "name=\"main\"" "index-capacity=")
    string(FIND "${symbol_dump}" "${fragment}" position)
    if (position LESS 0)
        message(FATAL_ERROR "Symbol dump is missing '${fragment}'")
    endif ()
endforeach ()
foreach (fragment "declaration struct" "declaration enum" "variant name=\"North\""
        "operator=\"+\"" "expression left name" "expression argument literal")
    string(FIND "${ast_dump}" "${fragment}" position)
    if (position LESS 0)
        message(FATAL_ERROR "AST dump is missing '${fragment}'")
    endif ()
endforeach ()
string(FIND "${preopt_ir_dump}" "dmm-ir-v6" preopt_header)
if (preopt_header LESS 0)
    message(FATAL_ERROR "Pre-optimization IR dump is incomplete")
endif ()
foreach (fragment "struct #0" "enum #0" "opcode=binary" "operator=\"+\""
        "opcode=call" "values=[")
    string(FIND "${ir_dump}" "${fragment}" position)
    if (position LESS 0)
        message(FATAL_ERROR "IR dump is missing '${fragment}'")
    endif ()
endforeach ()
foreach (fragment "dmm-cfg-v1" "block B0" "predecessors=[" "successors=[" "instruction #")
    string(FIND "${cfg_dump}" "${fragment}" position)
    if (position LESS 0)
        message(FATAL_ERROR "CFG dump is missing '${fragment}'")
    endif ()
endforeach ()

set(import_source "${SOURCE_DIR}/tests/unit/import_fixture/main.dmm")
set(import_ast "${OUTPUT_DIR}/import.ast")
set(import_map "${OUTPUT_DIR}/import.map")
execute_process(COMMAND "${COMPILER}" --emit=asm --deterministic --dump-ast "${import_ast}"
        --source-map "${import_map}" -o "${OUTPUT_DIR}/import.s" "${import_source}"
        RESULT_VARIABLE import_result)
if (NOT import_result EQUAL 0)
    message(FATAL_ERROR "Could not produce imported-unit dumps")
endif ()
file(READ "${import_ast}" import_ast_dump)
file(READ "${import_map}" import_source_map)
string(FIND "${import_ast_dump}" "role=import" imported_program)
string(FIND "${import_source_map}" "function=\"imported_square\"" imported_mapping)
string(FIND "${import_source_map}" "math/math.dmm" imported_path)
if (imported_program LESS 0 OR imported_mapping LESS 0 OR imported_path LESS 0)
    message(FATAL_ERROR "Imported source units are missing from dumps or source maps")
endif ()

set(failed_tokens "${OUTPUT_DIR}/failed.tokens")
set(parser_failure_source "${OUTPUT_DIR}/parser-case/parser-failure.dmm")
file(REMOVE "${failed_tokens}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/parser-case")
file(WRITE "${OUTPUT_DIR}/parser-case/dmm.manifest" "module dmm.test/parser-case\ndmm 2026-09-22-dev\n")
file(WRITE "${parser_failure_source}" "package main;\nfunc main() -> void { var value:int = 1;")
execute_process(COMMAND "${COMPILER}" --emit=asm --dump-tokens "${failed_tokens}"
        -o "${OUTPUT_DIR}/failed-parser.s" "${parser_failure_source}"
        RESULT_VARIABLE parser_result ERROR_QUIET)
if (parser_result EQUAL 0 OR NOT EXISTS "${failed_tokens}")
    message(FATAL_ERROR "Token dump was not retained for a parser failure")
endif ()
file(READ "${failed_tokens}" failed_token_dump)
if (NOT failed_token_dump MATCHES "dmm-tokens-v1")
    message(FATAL_ERROR "Parser-failure token dump is incomplete")
endif ()

set(failed_symbols "${OUTPUT_DIR}/failed.symbols")
set(semantic_failure_source "${OUTPUT_DIR}/semantic-case/semantic-failure.dmm")
file(REMOVE "${failed_symbols}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/semantic-case")
file(WRITE "${OUTPUT_DIR}/semantic-case/dmm.manifest" "module dmm.test/semantic-case\ndmm 2026-09-22-dev\n")
file(WRITE "${semantic_failure_source}" "package main;\nfunc main() -> void { missing(); }\n")
execute_process(COMMAND "${COMPILER}" --emit=asm --dump-symbols "${failed_symbols}"
        -o "${OUTPUT_DIR}/failed-semantic.s" "${semantic_failure_source}"
        RESULT_VARIABLE semantic_result ERROR_QUIET)
if (semantic_result EQUAL 0 OR NOT EXISTS "${failed_symbols}")
    message(FATAL_ERROR "Symbol dump was not retained for a semantic failure")
endif ()
file(READ "${failed_symbols}" failed_symbol_dump)
if (NOT failed_symbol_dump MATCHES "dmm-symbols-v1" OR NOT failed_symbol_dump MATCHES "errors=[1-9]")
    message(FATAL_ERROR "Semantic-failure symbol dump is incomplete")
endif ()

cmake_minimum_required(VERSION 3.21)
set(work "${OUTPUT_DIR}/allocation faults")
file(MAKE_DIRECTORY "${work}/bin" "${work}/case")
get_filename_component(compiler_name "${COMPILER}" NAME)
file(COPY_FILE "${COMPILER}" "${work}/bin/${compiler_name}")
file(COPY "${SOURCE_DIR}/stdlib" DESTINATION "${work}/share/dmm")
# Instrument ordinary allocator source only in this isolated installation.
set(allocator "${work}/share/dmm/stdlib/core/raw/memory.dmm")
file(READ "${allocator}" source)
set(allocation "return __dmm_intrinsic_alloc(bytes);")
string(FIND "${source}" "${allocation}" position)
if(position LESS 0)
    message(FATAL_ERROR "Allocator instrumentation anchor is missing")
endif()
string(REPLACE "${allocation}" "if(testAllocationFailure) { testAllocationFailure=false; return core_null(); }\n    var result:*u8=__dmm_intrinsic_alloc(bytes);\n    if(result!=core_null()) { testLiveAllocations+=1; }\n    return result;" source "${source}")
string(REPLACE "__dmm_intrinsic_release(data);" "if(data!=core_null()) { testLiveAllocations-=1; }\n    __dmm_intrinsic_release(data);" source "${source}")
file(WRITE "${allocator}" "${source}\nvar testAllocationFailure:bit=false;\nvar testLiveAllocations:usize=0;\npub func testFailNextAllocation()->void { testAllocationFailure=true; }\npub func testOutstandingAllocations()->usize { return testLiveAllocations; }\n")
file(COPY_FILE "${SOURCE_DIR}/tests/stdlib/collection_allocation_faults/dmm.manifest" "${work}/case/dmm.manifest")
file(COPY_FILE "${SOURCE_DIR}/tests/stdlib/collection_allocation_faults/collection_allocation_faults.dmm" "${work}/case/main.dmm")
foreach(level 0 1)
    set(program "${work}/case/program_${level}.exe")
    execute_process(COMMAND "${work}/bin/${compiler_name}" "-O${level}" --emit=exe
        "${work}/case/main.dmm" -o "${program}" RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Collection allocation faults O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Collection allocation faults O${level} destruction/content check: ${status}")
    endif()
endforeach()

const base:int = 2 + 3;

func select(value:int) -> int { return value + 1; }
func select(value:double) -> int { return int(value) + 2; }

func sum(values:int[]) -> int {
    var total:int = 0;
    for (var i:int = 0; i < values.length; i++) {
        total += values[i];
    }
    return total;
}

func forward(values:int[]) -> int { return sum(values); }

func main() -> int {
    var values:int[3];
    values[0] = base;
    values[1] = select(4);
    values[2] = select(double(1));
    return forward(values);
}

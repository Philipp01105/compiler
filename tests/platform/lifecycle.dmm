package main;
import (
    stdlib "stdlib/core"
    "stdlib/io"
);

struct Owner {
    var label:string;
    destructor {
        io.println(label);
    }
}

func initialize() -> Owner {
    io.println("init");
    var value:Owner;
    value.label = "package";
    return value;
}

var owner:Owner = initialize();
async func worker() -> int {
    io.println("worker");
    return 7;
}

async func join(handle:JoinHandle<int>) -> int {
    var result = handle.await();
    match (result) {
        Ok(value) => return value;
        Err(error) => return -1;
    }
}

func main() -> int {
    io.println("main");
    var local:Owner;
    local.label = "local";
    if (block_on(join(spawn(worker()))) != 7) {
        return 1;
    }
    return 37;
}

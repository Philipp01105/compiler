// Test file I/O using syscalls
func main() -> void {
    var filename:string = "test_output.txt";
    var content:string = "Hello, file I/O with syscalls!\n";
    
    // Open file for writing (O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420)
    var fd:int = sys_open(filename, 577, 420);
    
    // Write to file
    var len:int = io_strlen(content);
    sys_write(fd, content, len);
    
    // Close file
    sys_close(fd);
    
    // Confirm to stdout
    var msg:string = "File written successfully!\n";
    var msg_len:int = io_strlen(msg);
    sys_write(1, msg, msg_len);
}

// Test the new read() function with System.in
#import <stdlib/io.txt>

func main() -> void {
    println("Testing new read() function");
    println("");
    
    println("Enter an integer:");
    var num:int = read(System.in.fd, "%i");
    
    print("You entered: ");
    println(num);
    
    println("");
    println("Enter a character:");
    var c:char = read(System.in.fd, "%c");
    
    print("You entered: ");
    println(c);
}

cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/standalone_link.cmake")
set(work "${OUTPUT_DIR}/packages_v2")
file(MAKE_DIRECTORY "${work}")
function(source path text)
    get_filename_component(directory "${work}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${work}/${path}" "${text}")
endfunction()
function(module name)
    source("${name}/dmm.manifest" "module example.com/${name}\ndmm 2026-09-22-dev\n")
endfunction()
function(build name package expected)
    foreach (level 0 1)
        foreach (mode exe intel att)
            set(program "${work}/${name}/${package}/test_${level}_${mode}.exe")
            if (mode STREQUAL "exe")
                set(options --emit=exe)
                set(artifact "${program}")
            else ()
                set(options --emit=asm "--syntax=${mode}")
                set(artifact "${program}.s")
            endif ()
            execute_process(COMMAND "${COMPILER}" "-O${level}" ${options} "${work}/${name}/${package}/main.dmm" -o "${artifact}"
                    RESULT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 30)
            if (NOT result STREQUAL "0")
                message(FATAL_ERROR "${name}/${package}/${mode}/O${level}: ${errors}")
            endif ()
            if (NOT mode STREQUAL "exe")
                execute_process(COMMAND "${ASSEMBLER}" ${STANDALONE_FLAGS} "${artifact}" ${SYSTEM_LIBRARIES} -o "${program}"
                        RESULT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 30)
                if (NOT result STREQUAL "0")
                    message(FATAL_ERROR "Package assembly failed: ${errors}")
                endif ()
            endif ()
            execute_process(COMMAND "${program}" RESULT_VARIABLE result TIMEOUT 10)
            if (NOT result STREQUAL "${expected}")
                message(FATAL_ERROR "${name}/${mode}/O${level}: exit ${result}, expected ${expected}")
            endif ()
        endforeach ()
    endforeach ()
endfunction()
function(reject name code)
    foreach (format human json)
        set(options)
        if (format STREQUAL "json")
            set(options --formatError)
        endif ()
        execute_process(COMMAND "${COMPILER}" ${options} "${work}/${name}/main.dmm" -o "${work}/${name}/bad.exe"
                RESULT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 10)
        if (NOT result STREQUAL "1" OR NOT errors MATCHES "${code}")
            message(FATAL_ERROR "${name}/${format}: expected ${code}: ${errors}")
        endif ()
        if (format STREQUAL "json")
            string(JSON count LENGTH "${errors}" errors)
        endif ()
    endforeach ()
    set(last_errors "${errors}" PARENT_SCOPE)
endfunction()

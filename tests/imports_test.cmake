foreach (mode obj asm)
    execute_process(COMMAND "${COMPILER}" "--emit=${mode}" "${work}/discovery/lexer/a.dmm" -o "${work}/library.${mode}"
            RESULT_VARIABLE result ERROR_VARIABLE errors TIMEOUT 10)
    if (NOT result STREQUAL "0")
        message(FATAL_ERROR "Library package incorrectly needs main: ${errors}")
    endif ()
endforeach ()


var destroyed:i32 = 0;

struct Resource {
    var value:i32;
    destructor {
        destroyed += 1;
    }
}

interface Finisher {
    once func finish() -> i32;

    func peek() -> i32;
}

struct FinishOwner {
    var owner:Resource;

    func finish() -> i32 {
        return owner.value;
    }

    func peek() -> i32 {
        return owner.value;
    }
}

struct SharedFinishOwner {
    var owner:Resource;

    func finish() -> i32 {
        return owner.value;
    }

    func peek() -> i32 {
        return owner.value;
    }
}

func finishGeneric<F:Finisher>(value:F) -> i32 {
    return value.finish();
}

interface Counter {
    mut func advance() -> i32;
}

struct Count {
    var value:i32;

    func advance() -> i32 {
        value += 1;
        return value;
    }
}

func advanceGeneric<C:Counter>(value:&mut C) -> i32 {
    return (*value).advance();
}

func apply(f:func(i32) -> i32, x:i32) -> i32 {
    return f(x);
}

interface Adder {
    func __invoke(value:i32) -> i32;
}

interface Accumulator {
    mut func __invoke(value:i32) -> i32;
}

interface OwnerFactory {
    once func __invoke() -> Resource;
}

func makeAdder(offset:i32) -> Adder {
    return func[move offset](value:i32) -> i32{
        return offset + value;
    };
}

func makeAccumulator(initial:i32) -> Accumulator {
    return func[move initial](value:i32) -> i32{
        initial += value;
        return initial;
    };
}

func makeOwner(value:i32) -> OwnerFactory {
    var owner = Resource{value:value};
    return func[move owner]() -> Resource{
        return owner;
    };
}

func applyMutable(f:mut func(i32) -> i32, x:i32) -> i32 {
    return f(x);
}

func applyTwice(f:mut func(i32) -> i32, a:i32, b:i32) -> i32 {
    var first = f(a);
    return first + f(b);
}

func compareOnce(f:func(i32,i32) -> bit) -> bit {
    return f(1, 2);
}

func invokeOnce(f:once func(i32) -> i32, value:i32) -> i32 {
    return f(value);
}

func increment(value:i32) -> i32 {
    return value + 1;
}

interface OnceInvoker {
    func run(callback:once func(i32) -> i32) -> i32;
}

struct Invoker {
    func run(callback:once func(i32) -> i32) -> i32 {
        return callback(28);
    }
}

func runOnce<I:OnceInvoker>(invoker:I) -> i32 {
    return invoker.run(increment);
}

func returnOwner(f:once func() -> Resource) -> Resource {
    return f();
}

func chooseOwned<T>(value:T) -> T {
    var choose = func[move value]() -> T{
        return value;
    };
    return choose();
}

func nestedCallback(f:func(i32) -> i32, x:i32) -> i32 {
    var bonus:i32 = 1;
    var add:once func(i32) -> i32 = func[move bonus](value:i32) -> i32{
        return value + bonus;
    };
    return f(add(x));
}

func choose<T:core.Copy>(first:T, second:T) -> T {
    var selected:once func(T) -> T = func[move first](unused:T) -> T{
        return first;
    };
    return selected(second);
}


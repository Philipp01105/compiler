var dropped:int = 0;

struct Owner {
    var value:int;
    destructor {
        dropped += 1;
    }
}

func owned(index:usize) -> Owner {
    return Owner{value:index.(int)};
}

func positive(value:&int) -> bit {
    return *value > 0;
}

func doubled(value:int) -> int {
    return value * 2;
}

func add(left:int, right:int) -> int {
    return left + right;
}

func hashOwner(key:&Owner) -> u64 {
    return key.value.(u64) % 2;
}

func equalOwner(left:&Owner, right:&Owner) -> bit {
    return left.value == right.value;
}

async func listTask(value:collections.List<int>) -> int {
    return value.length().(int);
}

async func mapTask(value:collections.Map<int,int>) -> int {
    return value.length().(int);
}

async func stringTask(value:text.String) -> int {
    return value.length().(int);
}

async func joined(value:JoinHandle<int>) -> int {
    match (value.await()) {
        Ok(number) => return number;
        Err(error) => return -1;
    }
}


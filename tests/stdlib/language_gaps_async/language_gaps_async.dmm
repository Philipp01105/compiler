package main;
import ("stdlib/core" "stdlib/async" "stdlib/time");
var destroyed: i32 = 0;
var cancelPolls:i32=0;
var pollerDrops:i32=0;
struct Payload { var value: i32; destructor { destroyed += 1; } }
struct Immediate {
    var result: i32;
    pub func poll(context: &mut asynchronous.Context) -> core.Poll<i32> {
        return core.Poll<i32>.Ready(result);
    }
    pub func cancelPoll(context: &mut asynchronous.Context) -> core.Poll<asynchronous.CancelAck> {
        return core.Poll<asynchronous.CancelAck>.Ready(asynchronous.CancelAck.Confirmed);
    }
}
struct WakeOnce {
    var ready:bit;
    pub func poll(context:&mut asynchronous.Context)->core.Poll<i32> {
        if (ready) { return core.Poll<i32>.Ready(43); }
        ready=true;
        var wake=context.retainWaker();
        wake.wake();
        return core.Poll<i32>.Pending;
    }
    pub func cancelPoll(context:&mut asynchronous.Context)->core.Poll<asynchronous.CancelAck> {
        return core.Poll<asynchronous.CancelAck>.Ready(asynchronous.CancelAck.Confirmed);
    }
}
struct UntilCancelled {
    var remaining:i32;
    var address:*i32;
    pub func poll(context:&mut asynchronous.Context)->core.Poll<i32> {
        if(address==core.core_null().(*i32)) { address=(&remaining).(*i32); }
        if(address!=(&remaining).(*i32)) { core.core_trap(); }
        return core.Poll<i32>.Pending;
    }
    pub func cancelPoll(context:&mut asynchronous.Context)->core.Poll<asynchronous.CancelAck> {
        if(address!=(&remaining).(*i32)) { core.core_trap(); }
        cancelPolls+=1;
        if(remaining!=0) {
            remaining-=1;
            var wake=context.retainWaker(); wake.wake();
            return core.Poll<asynchronous.CancelAck>.Pending;
        }
        return core.Poll<asynchronous.CancelAck>.Ready(asynchronous.CancelAck.Confirmed);
    }
    destructor { pollerDrops+=1; }
}
struct WakeTwice {
    var remaining:i32;
    pub func poll(context:&mut asynchronous.Context)->core.Poll<i32> {
        if(remaining==0) { return core.Poll<i32>.Ready(101); }
        remaining-=1; var wake=context.retainWaker(); wake.wake();
        return core.Poll<i32>.Pending;
    }
    pub func cancelPoll(context:&mut asynchronous.Context)->core.Poll<asynchronous.CancelAck> {
        return core.Poll<asynchronous.CancelAck>.Ready(asynchronous.CancelAck.Confirmed);
    }
}
async func nothing()->void {}
var compositionDrops:i32=0;
struct CompositionOwner { var value:i32; destructor { compositionDrops+=1; } }
async func ownedNothing(owner:CompositionOwner)->void {}
enum Tasks { Task(Future<i32>), Empty }
@[must_consume] interface Resume { once func __invoke()->Future<i32>; }
func namedResume(child:Future<i32>)->Resume {
    return func [move child]()->Future<i32> { return child; };
}
enum TaskPair { Both(Future<i32>,Future<i32>), Empty }
enum TaskBundle { Packed(TaskPair), Empty }
func swapTasks(value:TaskPair)->TaskPair {
    match(value) {
        Both(left,right)=>return TaskPair.Both(right,left);
        Empty=>return TaskPair.Empty;
    }
}
func swapBundle(value:TaskBundle)->TaskBundle {
    match(value) {
        Packed(pair)=>return TaskBundle.Packed(swapTasks(pair));
        Empty=>return TaskBundle.Empty;
    }
}
async func work(value: &i32) -> i32 { return *value; }
struct BorrowedResult<'a> { var source:&'a i32; }
struct NestedResult<'a> { var reader:BorrowedResult<'a>; }
struct SplitResult<'a,'b> { var left:NestedResult<'a>; var right:NestedResult<'b>; }
async func splitResult<'a,'b>(left:&'a i32,right:&'b i32,extra:&i32)->SplitResult<'a,'b> {
    return SplitResult<'a,'b>{left:NestedResult<'a>{reader:BorrowedResult<'a>{source:left}},
        right:NestedResult<'b>{reader:BorrowedResult<'b>{source:right}}};
}
async func borrowedResult<'a>(source:&'a i32)->NestedResult<'a> {
    return NestedResult<'a>{reader:BorrowedResult<'a>{source:source}};
}
async func forwardBorrowedResult<'a>(source:&'a i32)->NestedResult<'a> {
    var task=borrowedResult(source);
    return task.await();
}
func acceptSend<T: core.Send>(value: T) -> void {}
func drive<P: asynchronous.Poller<i32>>(poller: &mut P, context: &mut asynchronous.Context) -> i32 {
    match (poller.poll(context)) {
        Ready(value) => return value;
        Pending => return -1;
    }
}

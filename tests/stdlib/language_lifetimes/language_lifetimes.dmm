 *pair.right=4;
 if(*reference+*pair.right!=7) { return 17; } }
 { var r=reader(&source); var copy=r; if(copy.read()!=42 || r.read()!=42) { return 1; } }
 { var w=writer(&mut source); var moved=w; moved.write(43); }
 if(source!=43) { return 2; }
 var other:i32=44;
 var selected=choose(&source,&other,false);
 if(*selected!=44) { return 3; }
 { var left:i32=3; var right:i32=2; var unrelated:i32=1;
 var selected=choose(&left,&right,false);
 var copied=selected; var child=&*copied;
 unrelated=4;
 if(*child+unrelated!=6) { return 28; } }
 var storage:u8[4];
 var bytes:u8[]=storage;

  Break(residual)=>{}
 }
 { var left:i32=3; var right:i32=2;
 var pair=readerChoice(&left,&right);
 var reference=choiceLeft(pair,&left);
 if(*reference!=3) { return 25; } }
 { var left:i32=3; var right:i32=2;
 var pair=NestedReaders{left:Reader{source:&left},right:Reader{source:&right}};
 var reference=nestedLeft(&pair);
 if(*reference!=3) { return 24; } }
 { var left:i32=3; var right:i32=2;
 var pair=SeparateReaders{left:&left,right:&right};
 var reference=leftReader(&pair);
 right=4;
 if(*reference+right!=7) { return 21; } }
 { var left:i32=3; var right:i32=2;
 var pair=SeparateReaders{left:&left,right:&right};
 var projected=projectReader(&pair);
 right=4;
 if(projected.read()+right!=7) { return 22; } }
 { var left:i32=3; var right:i32=2;
 var pair=SeparateReaders{left:&left,right:&right};
 var projected=copyReader(pair);
 right=4;
 if(projected.read()+right!=7) { return 23; } }
 { var left:i32=1; var right:i32=2;
 var pair=WriterPair{left:writer(&mut left),right:writer(&mut right)};
 pair.left.write(3); pair.right.write(4);
 if(*pair.left.source+*pair.right.source!=7) { return 20; } }
 { var pair=SharedPair{left:&source,right:&source};
 if(*pair.left+*pair.right!=84) { return 14; } }
 { var left:i32=1; var right:i32=2;
 var pair=MutablePair{left:&mut left,right:&mut right};
 *pair.left=3; *pair.right=4;
 if(*pair.left+*pair.right!=7) { return 15; } }
 { var left:i32=3; var right:i32=2;
 var pair=separate(&mut left,&mut right);

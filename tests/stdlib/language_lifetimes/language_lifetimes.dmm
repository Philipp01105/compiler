}
func treeRight<'a,'b>(tree:&ReaderTree<'a,'b>)->&'b i32 { return tree.readers.right; }
func sameLifetime<'a>(left:&'a i32,right:&'a i32)->SharedPair<'a> {
 return SharedPair<'a>{left:left,right:right};
}
func swapReaders<'a,'b>(value:SeparateReaders<'a,'b>)->SeparateReaders<'b,'a> {

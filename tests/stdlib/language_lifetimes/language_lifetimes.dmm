func branchRight<'a,'b>(tree:BranchTree<'a,'b>,fallback:&'b i32)->&'b i32 {
 match(tree.branch) { Pair(pair)=>return pair.right; Empty=>return fallback; }
}
func readerChoice<'a,'b>(left:&'a i32,right:&'b i32)->ReaderChoice<'a,'b> {
 return ReaderChoice<'a,'b>.Both(left,right);
}
func choiceLeft<'a,'b>(value:ReaderChoice<'a,'b>,fallback:&'a i32)->&'a i32 {
 match(value) { Both(left,right)=>return left; Empty=>return fallback; }
}
func forwardOption(value:stdlib.Option<&i32>)->stdlib.Option<&i32> {
 var reference=value?;
 return stdlib.Option<&i32>.Some(reference);
}
func forwardResult(value:stdlib.Result<&i32,i32>)->stdlib.Result<&i32,i32> {
 var reference=value?;
 return stdlib.Result<&i32,i32>.Ok(reference);
}
func forwardResidual(value:stdlib.Result<i32,&i32>)->stdlib.Result<i32,&i32> {
 var number=value?;
 return stdlib.Result<i32,&i32>.Ok(number);
}
func forwardMutable(value:stdlib.Option<&mut i32>)->stdlib.Option<&mut i32> {
 var output=value?;
 return stdlib.Option<&mut i32>.Some(output);
}
enum BorrowFlow<'a> {
 Valid(&'a i32), Invalid(i32),
 ;
 static func branch(value:Self)->stdlib.Propagation<&'a i32,i32> {
  match(value) {
   Valid(reference)=>return stdlib.Propagation<&'a i32,i32>.Continue(reference);
   Invalid(error)=>return stdlib.Propagation<&'a i32,i32>.Break(error);
  }
 }
 static func fromResidual(error:i32)->Self { return BorrowFlow<'a>.Invalid(error); }
}
func forwardFlow<'a>(value:BorrowFlow<'a>)->BorrowFlow<'a> {
 var reference=value?;
 return BorrowFlow<'a>.Valid(reference);
}
func forwardSlice(value:stdlib.Option<i32[]>)->stdlib.Option<i32[]> {

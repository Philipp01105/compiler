struct Reader<'a> {
 var source: &'a i32;
 func read()->i32 { return *source; }
 func getRef()->&'a i32 { return source; }
}
struct Writer<'a> { var source: &'a mut i32; func write(value:i32)->void { *source=value; } }
func readerHash(key:i32)->u64 { return key.(u64); }
func readerSame(left:i32,right:i32)->bit { return left==right; }
func borrowedReaderHash(key:&Reader)->u64 { return (*(*key).source).(u64); }
func borrowedReaderSame(left:&Reader,right:&Reader)->bit { return *(*left).source==*(*right).source; }
struct TaggedReader<'a> { var occupied:u8; var reader:Reader<'a>; }
struct BorrowTable<'a> {
 var memory:*TaggedReader<'a>; var limit:usize;
 func put(key:usize,value:Reader<'a>)->void {
  var cursor:usize=key%limit;
  while(memory[cursor].occupied==7) { cursor=(cursor+1)%limit; }
  core.initialize(&memory[cursor],TaggedReader{occupied:7,reader:value});
 }
 func update(key:usize,value:Reader<'a>)->void {
  var cursor:usize=key%limit;
  if(memory[cursor].occupied==7) {
   core.destroy(&memory[cursor].reader);
   core.initialize(&memory[cursor].reader,value);
  }
 }
 func clear()->void {
  for(var cursor:usize=0;cursor<limit;cursor+=1) {
   if(memory[cursor].occupied==7) { core.destroy(&memory[cursor]); }
   memory[cursor].occupied=0;
  }
 }
 destructor { core.core_release(memory.(*u8)); }
}
enum WrappedTable<'a> { Table(BorrowTable<'a>), Empty }
var borrowOwnerDrops:i32=0;
struct BorrowOwner<'a> {
 var source:&'a i32;
 var tag:i32;
 destructor { borrowOwnerDrops+=tag; }
}
enum BorrowOwners<'a,'b> { Pair(BorrowOwner<'a>,BorrowOwner<'b>), Empty }
func reorderOwners<'a,'b>(value:BorrowOwners<'a,'b>)->BorrowOwners<'b,'a> {
 match(value) {
  Pair(left,right)=>return BorrowOwners<'b,'a>.Pair(right,left);
  Empty=>return BorrowOwners<'b,'a>.Empty;
 }
}
struct BorrowStack<'a> {
 var storage:*Reader<'a>;
 var count:usize;
 func push(value:Reader<'a>)->void {
  core.initialize(&storage[count],value); count+=1;
 }
 func exchange(value:Reader<'a>)->Reader<'a> {
  count-=1;
  var prior=replace(storage[count],value);
  count+=1;
  return prior;
 }
 func removeLast()->Reader<'a> {
  var result=take(storage[count-1]); count-=1; return result;
 }
 func length()->usize { return count; }
 func erase(index:usize)->Reader<'a> {
  var result=take(storage[index]);
  for(var cursor:usize=index+1;cursor<count;cursor+=1) {
   core.initialize(&storage[cursor-1],take(storage[cursor]));
  }
  count-=1; return result;
 }
 destructor {
  while(count>0) { count-=1; core.destroy(&storage[count]); }
  core.core_release(storage.(*u8));
 }
}
struct BorrowRing<'a> {
 var storage:*Reader<'a>; var start:usize; var capacity:usize; var used:usize;
 func length()->usize { return used; }
 func slots()->usize { return capacity; }
 func push(value:Reader<'a>)->void {
  core.initialize(&storage[(start+used)%capacity],value); used+=1;
 }
 func tail()->Reader<'a> { used-=1; return take(storage[(start+used)%capacity]); }
 func front()->Reader<'a> {
  var value=take(storage[start]); start=(start+1)%capacity; used-=1; return value;
 }
 func empty()->void {
  while(used>0) { core.destroy(&storage[start]); start=(start+1)%capacity; used-=1; }
  start=0;
 }
 destructor {
  while(used>0) { core.destroy(&storage[start]); start=(start+1)%capacity; used-=1; }
  core.core_release(storage.(*u8));
 }
}
struct BorrowSlots<'a> {
 var storage:*Reader<'a>;
 var leftLive:bit;
 var rightLive:bit;
 func put(index:usize,value:Reader<'a>)->void {
  core.initialize(&storage[index],value);
  if(index==0) { leftLive=true; } else { rightLive=true; }
 }
 func remove(index:usize)->Reader<'a> {
  var result=take(storage[index]);
  if(index==0) { leftLive=false; } else { rightLive=false; }
  return result;
 }
 destructor {
  if(leftLive) { core.destroy(&storage[0]); }
  if(rightLive) { core.destroy(&storage[1]); }
  core.core_release(storage.(*u8));
 }
}
struct HeapReaders<'a,'b> { var left:Reader<'a>; var right:Reader<'b>; }
struct HeapFields<'a,'b> {
 var storage:*HeapReaders<'a,'b>;
 func put(left:Reader<'a>,right:Reader<'b>)->void { core.initialize(&storage[0],HeapReaders<'a,'b>{left:left,right:right}); }
 func detach()->Reader<'b> { return take(storage[0].right); }
 func releaseLeft()->void { core.destroy(&storage[0].left); }
 destructor { core.core_release(storage.(*u8)); }
}
enum WrappedRing<'a> { Held(BorrowRing<'a>), Empty }
func truncateReaders(values:&mut stdlib.List<Reader>,length:usize)->void {
 (*values).truncate(length);
}

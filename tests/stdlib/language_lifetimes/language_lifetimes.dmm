func branchRight<'a,'b>(tree:BranchTree<'a,'b>,fallback:&'b i32)->&'b i32 {
 match(tree.branch) { Pair(pair)=>return pair.right; Empty=>return fallback; }
}
func readerChoice<'a,'b>(left:&'a i32,right:&'b i32)->ReaderChoice<'a,'b> {
 return ReaderChoice<'a,'b>.Both(left,right);

struct Reader<'a> {
 var source: &'a i32;
 func read()->i32 { return *source; }
 func getRef()->&'a i32 { return source; }
}
struct Writer<'a> { var source: &'a mut i32; func write(value:i32)->void { *source=value; } }
struct SharedPair<'a> { var left:&'a i32; var right:&'a i32; }
struct MutablePair<'a> { var left:&'a mut i32; var right:&'a mut i32; }
struct WriterPair<'a> { var left:Writer<'a>; var right:Writer<'a>; }
struct SeparatePair<'a,'b> { var left:&'a mut i32; var right:&'b mut i32; }
struct SeparateReaders<'a,'b> { var left:&'a i32; var right:&'b i32; }
struct NestedReaders<'a,'b> { var left:Reader<'a>; var right:Reader<'b>; }
enum ReaderChoice<'a,'b> { Both(&'a i32,&'b i32), Empty }
func readerChoice<'a,'b>(left:&'a i32,right:&'b i32)->ReaderChoice<'a,'b> {
 return ReaderChoice<'a,'b>.Both(left,right);
}
func choiceLeft<'a,'b>(value:ReaderChoice<'a,'b>,fallback:&'a i32)->&'a i32 {
 match(value) { Both(left,right)=>return left; Empty=>return fallback; }
}
func nestedLeft<'a,'b>(value:&NestedReaders<'a,'b>)->&'a i32 { return value.left.source; }
func leftReader<'a,'b>(value:&SeparateReaders<'a,'b>)->&'a i32 { return value.left; }
func projectReader<'a,'b>(value:&SeparateReaders<'a,'b>)->Reader<'a> {
 return Reader<'a>{source:value.left};
}
func copyReader<'a,'b>(value:SeparateReaders<'a,'b>)->Reader<'a> {
 return Reader<'a>{source:value.left};
}
func separate<'a,'b>(left:&'a mut i32,right:&'b mut i32)->SeparatePair<'a,'b> {
 return SeparatePair<'a,'b>{left:left,right:right};
}
struct GenericPair<'a,'b,T> { var left:&'a mut T; var right:&'b mut T; }
func genericSeparate<'a,'b,T>(left:&'a mut T,right:&'b mut T)->GenericPair<'a,'b,T> {
 return GenericPair<'a,'b,T>{left:left,right:right};
}
func reader<'a>(source: &'a i32)->Reader<'a> { return Reader<'a>{ source:source }; }
func writer<'a>(source: &'a mut i32)->Writer<'a> { return Writer<'a>{ source:source }; }
func choose<'a>(left:&'a i32,right:&'a i32,first:bit)->&'a i32 {
 if(first) { return left; } return right;
}
var permanent:i32=61;
var permanentRef:&'static i32=&permanent;
var permanentReader:Reader<'static>=Reader<'static>{source:&permanent};
var permanentCopy:Reader<'static>=permanentReader;
var inferredReader=Reader<'static>{source:&permanent};
var absent:stdlib.Option<&'static i32>=stdlib.Option<&'static i32>.None;
var absentCopy:stdlib.Option<&'static i32>=absent;
func readPermanent()->i32 { return permanentCopy.read()+*permanentRef; }
var drops:i32=0;
struct Resource { var value:i32; destructor { drops+=1; } }
func main()->int {
 match(absent) { Some(value)=>return 18; None=>{} }
 match(absentCopy) { Some(value)=>return 19; None=>{} }
 if(readPermanent()!=122 || permanentReader.read()!=61 || inferredReader.read()!=61) { return 13; }

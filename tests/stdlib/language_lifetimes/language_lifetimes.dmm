}
enum ReaderChoice<'a,'b> { Both(&'a i32,&'b i32), Empty }
enum ReaderBranch<'a,'b> { Pair(SeparateReaders<'a,'b>), Empty }
struct BranchTree<'a,'b> { var branch:ReaderBranch<'a,'b>; }
func branchTree<'a,'b>(left:&'a i32,right:&'b i32)->BranchTree<'a,'b> {

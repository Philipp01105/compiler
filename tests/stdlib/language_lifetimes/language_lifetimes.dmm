enum BorrowFlow<'a> {
 Valid(&'a i32), Invalid(i32),
 ;
 static func branch(value:Self)->stdlib.Propagation<&'a i32,i32> {
  match(value) {
   Valid(reference)=>return stdlib.Propagation<&'a i32,i32>.Continue(reference);
   Invalid(error)=>return stdlib.Propagation<&'a i32,i32>.Break(error);
  }
 }
 static func fromResidual(error:i32)->Self { return BorrowFlow<'a>.Invalid(error); }
}
func forwardFlow<'a>(value:BorrowFlow<'a>)->BorrowFlow<'a> {
 var reference=value?;
 return BorrowFlow<'a>.Valid(reference);
}
func forwardSlice(value:stdlib.Option<i32[]>)->stdlib.Option<i32[]> {
 var view=value?;
 return stdlib.Option<i32[]>.Some(view);
}
func nestedLeft<'a,'b>(value:&NestedReaders<'a,'b>)->&'a i32 { return value.left.source; }
func leftReader<'a,'b>(value:&SeparateReaders<'a,'b>)->&'a i32 { return value.left; }
func projectReader<'a,'b>(value:&SeparateReaders<'a,'b>)->Reader<'a> {
 return Reader<'a>{source:value.left};

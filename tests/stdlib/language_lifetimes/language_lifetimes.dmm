struct Reader<'a> {
 var source: &'a i32;
 func read()->i32 { return *source; }
 func getRef()->&'a i32 { return source; }
}
struct Writer<'a> { var source: &'a mut i32; func write(value:i32)->void { *source=value; } }
var borrowOwnerDrops:i32=0;
struct BorrowOwner<'a> {
 var source:&'a i32;
 var tag:i32;
 destructor { borrowOwnerDrops+=tag; }
}
enum BorrowOwners<'a,'b> { Pair(BorrowOwner<'a>,BorrowOwner<'b>), Empty }
func reorderOwners<'a,'b>(value:BorrowOwners<'a,'b>)->BorrowOwners<'b,'a> {
 match(value) {
  Pair(left,right)=>return BorrowOwners<'b,'a>.Pair(right,left);
  Empty=>return BorrowOwners<'b,'a>.Empty;
 }
}
struct BorrowStack<'a> {
 var storage:*Reader<'a>;
 var count:usize;
 func push(value:Reader<'a>)->void {
  core.initialize(&storage[count],value); count+=1;
 }
 func exchange(value:Reader<'a>)->Reader<'a> {
  count-=1;
  var prior=replace(storage[count],value);
  count+=1;
  return prior;
 }
 destructor {
  while(count>0) { count-=1; core.destroy(&storage[count]); }
  core.core_release(storage.(*u8));
 }
}
struct SharedPair<'a> { var left:&'a i32; var right:&'a i32; }
struct MutablePair<'a> { var left:&'a mut i32; var right:&'a mut i32; }
struct WriterPair<'a> { var left:Writer<'a>; var right:Writer<'a>; }
struct SeparatePair<'a,'b> { var left:&'a mut i32; var right:&'b mut i32; }
struct SeparateReaders<'a,'b> { var left:&'a i32; var right:&'b i32; }
struct NestedReaders<'a,'b> { var left:Reader<'a>; var right:Reader<'b>; }
struct DeepReader<'a> { var reader:Reader<'a>; }
struct DeepReaders<'a,'b> { var left:DeepReader<'a>; var right:DeepReader<'b>; }
struct ReaderTree<'a,'b> { var readers:SeparateReaders<'a,'b>; }
func readerTree<'a,'b>(left:&'a i32,right:&'b i32)->ReaderTree<'a,'b> {
 return ReaderTree<'a,'b>{readers:SeparateReaders<'a,'b>{left:left,right:right}};
}
func treeRight<'a,'b>(tree:&ReaderTree<'a,'b>)->&'b i32 { return tree.readers.right; }
func sameLifetime<'a>(left:&'a i32,right:&'a i32)->SharedPair<'a> {
 return SharedPair<'a>{left:left,right:right};
}
func swapReaders<'a,'b>(value:SeparateReaders<'a,'b>)->SeparateReaders<'b,'a> {
 return SeparateReaders<'b,'a>{left:value.right,right:value.left};
}
struct NestedWriters<'a,'b> { var left:Writer<'a>; var right:Writer<'b>; }
func nestedWriters<'a,'b>(left:&'a mut i32,right:&'b mut i32)->NestedWriters<'a,'b> {
 return NestedWriters<'a,'b>{left:Writer<'a>{source:left},right:Writer<'b>{source:right}};
}
func nestedReaders<'a,'b>(left:&'a i32,right:&'b i32)->NestedReaders<'a,'b> {
 return NestedReaders<'a,'b>{left:Reader<'a>{source:left},right:Reader<'b>{source:right}};
}
func deepReaders<'a,'b>(left:&'a i32,right:&'b i32)->DeepReaders<'a,'b> {
 return DeepReaders<'a,'b>{left:DeepReader<'a>{reader:Reader<'a>{source:left}},right:DeepReader<'b>{reader:Reader<'b>{source:right}}};
}
func nestedProjection<'a,'b>(value:&NestedReaders<'a,'b>)->Reader<'a> {
 return Reader<'a>{source:value.left.source};

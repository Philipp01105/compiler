}
struct GenericPair<'a,'b,T> { var left:&'a mut T; var right:&'b mut T; }
func genericSeparate<'a,'b,T>(left:&'a mut T,right:&'b mut T)->GenericPair<'a,'b,T> {
 return GenericPair<'a,'b,T>{left:left,right:right};
}
func reader<'a>(source: &'a i32)->Reader<'a> { return Reader<'a>{ source:source }; }
func updateReader<'a>(target:&mut Reader<'a>,source:&'a i32)->void { (*target).source=source; }
func writer<'a>(source: &'a mut i32)->Writer<'a> { return Writer<'a>{ source:source }; }
func choose<'a>(left:&'a i32,right:&'a i32,first:bit)->&'a i32 {

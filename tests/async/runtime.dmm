package async_fixture;
enum Propagation<Output,Residual> { Continue(Output), Break(Residual), }
enum Result {
    Ok(int), Err(int), ;
    static func branch(value:Self) -> Propagation<int,int> {
        match(value) {
            Ok(output) => return Propagation<int,int>.Continue(output);
            Err(error) => return Propagation<int,int>.Break(error);
        }
    }
    static func fromResidual(error:int) -> Self { return Result.Err(error); }
}

var cleanupCount:int=0;
struct Guard {
    var value:int;
    destructor { cleanupCount+=1; }
}
pub func cleanups() -> int { return cleanupCount; }
pub async func immediate(x:int) -> int { return x+1; }
pub async func floats(x:double) -> double { return x+0.5; }
pub async func array() -> int[2] { return [7,8]; }
pub async func arrayUse() -> int { var a=array().await(); return a[0]+a[1]; }
pub async func nested(f:Future<int>,g:Future<int>) -> int {
    var guard:Guard;
    guard.value=9;
    defer func() { cleanupCount+=10; }
    var x=17;
    var r=&x;
    var a=f.await();
    var b=g.await();
    return a+b+*r+guard.value;
}
pub async func loop(f:Future<int>) -> int {
    var n=f.await();
    var sum=0;
    var i=0;
    while(i<n) { sum+=immediate(i).await(); i+=1; }
    return sum;
}
pub async func relay(f:Future<int>,g:Future<int>) -> int { return nested(f,g).await(); }
pub async func branch(f:Future<int>,b:bit) -> int {
    var guard:Guard;
    if(b) { return f.await(); }
    var x=f.await();
    return x+1;
}
pub async func arrayParam(a:int[2]) -> int { return a[0]+a[1]; }
pub async func fallible(f:Future<int>,fail:bit) -> Result {
    var guard:Guard;
    defer func() { cleanupCount+=100; }
    var x=f.await();
    var step:Result;
    if(fail) { step=Result.Err(23); }
    else { step=Result.Ok(x); }
    var y=step?;
    return Result.Ok(y+1);
}
pub async func errorUse(f:Future<int>,fail:bit) -> int {
    var result=fallible(f,fail).await();
    match(result) { Ok(value) => return value; Err(error) => return error; }
}
pub async func loopCleanup(f:Future<int>) -> int {
    var n=f.await();
    var i=0;
    while(i<n) {
        var guard:Guard;
        i+=1;
        if(i==1) { continue; }
        if(i==3) { break; }
    }
    return i;
}
pub async func structParam(g:Guard,f:Future<int>) -> int {
    var a=array().await();
    var x=f.await();
    return g.value+a[0]+x;
}
pub async func many(a:int,b:double,c:int,d:double,e:int,f:double,g:int,h:int) -> double {
    return a+b+c+d+e+f+g+h;
}
pub func forward(f:Future<int>) -> Future<int> { return f; }
pub async func indirect() -> int {
    var call=immediate;
    var x=call(20).await();
    return x+forward(immediate(30)).await();
}
pub async func futureResult() -> Future<int> { return immediate(4); }
pub async func futureChain() -> int { return futureResult().await().await(); }

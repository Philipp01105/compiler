// Test high-level I/O abstractions
#import <stdlib/io.txt>

func main() -> void {
    println("=== High-Level I/O Test ===");
    println("");
    
    // Test print and println
    print("1. Testing print: ");
    println("Success!");
    
    // Test integer printing
    print("2. Testing integers: ");
    print_int(42);
    print(" and ");
    print_int(-17);
    print_newline();
    
    // Test file write
    println("3. Testing file write...");
    var result:int = write_file("test_high_level.txt", "Hello from high-level I/O!\n");
    if (result == 0) {
        println("   File written successfully!");
    }
    
    // Test file read
    println("4. Testing file read...");
    var[256] buffer:char;
    var bytes:int = read_file("test_high_level.txt", &buffer, 255);
    if (bytes > 0) {
        print("   Content: ");
        print(&buffer);
    }
    
    println("");
    println("All tests completed!");
}

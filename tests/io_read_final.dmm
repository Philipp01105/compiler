// Final test of read() function
#import <stdlib/io.txt>

func main() -> void {
    println("Test 1: Read with fd 0");
    var x:int = read(0, "%i");
    println(x);
    
    println("Test 2: Read with System.in");  
    var y:int = read(System.in.fd, "%i");
    println(y);
    
    println("Done!");
}

// Clean I/O demonstration using stdlib abstractions
#import <stdlib/io.txt>

func main() -> void {
    println("=== DMM I/O System Demo ===");
    println("");
    
    // Test 1: Simple file write
    println("1. Writing to file...");
    var result:int = write_file("demo.txt", "Hello from DMM!\n");
    if (result == 0) {
        println("   Success!");
    }
    
    // Test 2: Read file back
    println("2. Reading file...");
    var[256] buffer:char;
    var bytes:int = read_file("demo.txt", &buffer, 255);
    if (bytes > 0) {
        println("   File exists!");
    }
    
    // Test 3: Append to file
    println("3. Appending to file...");
    append_file("demo.txt", "Second line!\n");
    
    // Test 4: Stream-based file I/O
    println("4. Stream-based I/O...");
    var fd:int = open_write("stream.txt");
    write_str_to(fd, "Line 1\n");
    write_str_to(fd, "Line 2\n");
    close_file(fd);
    
    println("");
    println("All tests completed!");
}

// Test integer to string conversion
func main() -> void {
    var[32] buffer:char;
    
    // Test with 42
    var len:int = io_int_to_str(42, &buffer, 32);
    sys_write(1, &buffer, len);
    
    var newline:string = "\n";
    sys_write(1, newline, 1);
    
    // Test with -17
    var len2:int = io_int_to_str(-17, &buffer, 32);
    sys_write(1, &buffer, len2);
    sys_write(1, newline, 1);
}

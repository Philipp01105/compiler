function(reexport_reject name facade body expected edition)
    set(work "${OUTPUT_DIR}/${name}")
    file(MAKE_DIRECTORY "${work}/leaf" "${work}/other" "${work}/facade")
    file(WRITE "${work}/dmm.manifest" "module gaps/${name}\ndmm ${edition}\n")
    file(WRITE "${work}/leaf/leaf.dmm" "package leaf; pub func answer()->i32 { return 1; } func hidden()->i32 { return 2; }\n")
    file(WRITE "${work}/other/other.dmm" "package other; pub func answer()->i32 { return 3; }\n")
    file(WRITE "${work}/facade/facade.dmm" "package facade; ${facade}\n")
    file(WRITE "${work}/case.dmm" "package main; import (\"gaps/${name}/facade\"); ${body}\n")
    execute_process(COMMAND "${COMPILER}" --emit=obj "${work}/case.dmm" -o "${work}/case.o"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 15)
    if(status EQUAL 0 OR NOT errors MATCHES "${expected}")
        message(FATAL_ERROR "Expected rejection ${name} (${expected}): ${status}: ${errors}")
    endif()
endfunction()

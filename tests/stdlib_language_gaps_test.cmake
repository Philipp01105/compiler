cmake_minimum_required(VERSION 3.21)
include("${SOURCE_DIR}/tests/collection_allocation_faults_test.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(level 0 1)
    set(closure_program "${OUTPUT_DIR}/language_closures_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_closures/language_closures.dmm" -o "${closure_program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Capturing closures O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${closure_program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Capturing closures O${level}: ${status}")
    endif()
    set(collection_program "${OUTPUT_DIR}/language_collections_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_collections/language_collections.dmm" -o "${collection_program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Owner collections O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${collection_program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Owner collections O${level}: ${status}")
    endif()
    set(file_program "${OUTPUT_DIR}/language_files_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_files/language_files.dmm" -o "${file_program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "File ownership O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${file_program}" WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "File ownership O${level}: ${status}")
    endif()
    set(lifetime_program "${OUTPUT_DIR}/language_lifetimes_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_lifetimes/language_lifetimes.dmm" -o "${lifetime_program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Stored lifetimes O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${lifetime_program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Stored lifetimes O${level}: ${status}")
    endif()
    set(async_program "${OUTPUT_DIR}/language_gaps_async_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_gaps_async/language_gaps_async.dmm" -o "${async_program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Language gaps async O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${async_program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Language gaps async O${level}: ${status}")
    endif()
    set(program "${OUTPUT_DIR}/language_gaps_${level}.exe")
    execute_process(COMMAND "${COMPILER}" "-O${level}" --emit=exe
        "${SOURCE_DIR}/tests/stdlib/language_gaps/language_gaps.dmm" -o "${program}"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Language gaps O${level}: ${errors}")
    endif()
    execute_process(COMMAND "${program}" RESULT_VARIABLE status TIMEOUT 15)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Language gaps O${level} destruction/ownership execution: ${status}")
    endif()
    foreach(target elf coff)
        foreach(mode obj intel att)
            set(options --emit=obj)
            if(NOT mode STREQUAL obj)
                set(options --emit=asm "--syntax=${mode}")
            endif()
            execute_process(COMMAND "${COMPILER}" "-O${level}" "--target=${target}" ${options}
                "${SOURCE_DIR}/tests/stdlib/language_gaps/language_gaps.dmm"
                -o "${OUTPUT_DIR}/language_gaps_${target}_${level}_${mode}.out"
                RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 30)
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "Language gaps ${target}/O${level}/${mode}: ${errors}")
            endif()
            foreach(fixture language_lifetimes language_collections language_files language_closures language_gaps_async)
                execute_process(COMMAND "${COMPILER}" "-O${level}" "--target=${target}" ${options}
                    "${SOURCE_DIR}/tests/stdlib/${fixture}/${fixture}.dmm"
                    -o "${OUTPUT_DIR}/${fixture}_${target}_${level}_${mode}.out"
                    RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 30)
                if(NOT status EQUAL 0)
                    message(FATAL_ERROR "${fixture} ${target}/O${level}/${mode}: ${errors}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endforeach()

function(reject name body expected)
    set(work "${OUTPUT_DIR}/${name}")
    file(MAKE_DIRECTORY "${work}")
    file(WRITE "${work}/dmm.manifest" "module gaps/${name}\ndmm 2026-10-04-dev\nfeatures = [\"async\"]\n")
    file(WRITE "${work}/case.dmm" "package main;\nimport (\"stdlib/core\" \"stdlib\" \"stdlib/binary\" \"stdlib/sync\" \"stdlib/collections\");\nstruct Resource { var value:i32; destructor {} }\nenum Owner { Item(Resource), Empty }\n${body}\n")
    execute_process(COMMAND "${COMPILER}" --emit=obj "${work}/case.dmm" -o "${work}/case.o"
        RESULT_VARIABLE status ERROR_VARIABLE errors TIMEOUT 15)
    if(status EQUAL 0 OR NOT errors MATCHES "${expected}")
        message(FATAL_ERROR "Expected rejection ${name} (${expected}): ${status}: ${errors}")
    endif()
endfunction()

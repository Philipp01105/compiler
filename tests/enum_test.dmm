enum test(id:int, name:string) {
    In(1, "test"),
    Out(2, "test2")
}

func main() -> void {
    print("In id: ");
    print(test.In.id);
    println("");
    
    print("Out id: ");
    print(test.Out.id);
    println("");
    
    print("In name: ");
    print(test.In.name);
    println("");
    
    print("Out name: ");
    print(test.Out.name);
    println("");
}

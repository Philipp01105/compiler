package main;
import "stdlib/io";
import stdlib "stdlib/core";
// Test pointer assignment bug fix
// This test ensures that pointer-to-pointer assignments work correctly
func main() -> void {
    var a: int = 8;
    var x: *int;
    var y: *int = (&a).(*int);
    x = y;
    io.println(*x);
}

// Regression: pointer-to-pointer assignment must preserve the address.

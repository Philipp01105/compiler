package main;
import (
    stdlib "stdlib/core"
    "stdlib/collections"
    "stdlib/unicode"
);

func main() -> int {
    var owner = collections.list<u8>();
    owner.append(65);
    var data=owner.view();
    var iterator = unicode.iterate(&data);
    owner.clear();
    var next = iterator.next();
    return 0;
}

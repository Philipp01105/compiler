package main;
import (
    "stdlib/collections"
    stdlib "stdlib/core"
);

func main() -> int {
    var owner = collections.list<u8>();
    owner.append(7);
    var wrapped = stdlib.Option<u8[]>.Some(owner.view());
    match (wrapped) {
        None => return 0;
        Some(value) => {
            owner.clear();
            return value[0].(int);
        }
    }
}

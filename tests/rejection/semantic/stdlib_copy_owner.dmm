package main;
import (
    "stdlib/algorithms"
);

struct Resource {
    var value: int;
    destructor {}
}

func main() -> int {
    var first: Resource[1];
    var second: Resource[1];
    var source: Resource[] = first;
    var destination: Resource[] = second;
    var result = algorithms.copy<Resource>(&source, &mut destination);
    return 0;
}

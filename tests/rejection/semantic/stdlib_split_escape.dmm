package main;
import (
    "stdlib"
    "stdlib/text"
);

func dangling() -> u8[] {
    var owner = stdlib.bytes(8);
    owner.push(65);
    var iterator = text.split(owner.view(), 44);
    var next = iterator.next();
    match (next) {
        Some(value) => return value;
        None => return text.bytes("");
    }
}

func main() -> int {
    var value = dangling();
    return value[0].(int);
}

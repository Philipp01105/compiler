package main;
import (
    stdlib "stdlib/core"
    "stdlib/collections"
    "stdlib/text"
    byteops "stdlib/bytes"
);

func dangling() -> u8[] {
    var owner = collections.list<u8>();
    owner.append(65);
    var data = owner.view();
    var iterator = byteops.split(&data, 44);
    var next = iterator.next();
    match (next) {
        Some(value) => return value;
        None => return text.bytes("");
    }
}

func main() -> int {
    var value = dangling();
    return value[0].(int);
}

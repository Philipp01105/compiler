package main;

struct Resource {
    var value: int;
    destructor {}
}

enum Holder {
    Empty,
    Value(Resource)
}

func main() -> void {
    var resource: Resource;
    var holder: Holder = Holder.Value(resource);
    match (holder) {
        Value(value) => {}
        Empty => {}
    }
    match (holder) {
        Value(value) => {}
        Empty => {}
    }
}

package main;
import (
    "stdlib"
    "stdlib/text"
    byteops "stdlib/bytes"
);

func main() -> int {
    var owner = stdlib.bytes(8);
    owner.push(65);
    var data = owner.view();
    var iterator = byteops.split(&data, 44);
    owner.clear();
    var next = iterator.next();
    match (next) {
        None => return 0;
        Some(value) => return value.length.(int);
    }
}

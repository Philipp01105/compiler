package main;
import (
    byteops "stdlib/bytes"
    "stdlib/collections"
    stdlib "stdlib/core"
    "stdlib/text"
);

func main() -> int {
    var owner = collections.list<u8>();
    owner.append(65);
    var data = owner.view();
    var iterator = byteops.split(&data, 44);
    owner.clear();
    var next = iterator.next();
    match (next) {
        None => return 0;
        Some(value) => return value.length.(int);
    }
}

package main;
import (
    "stdlib/collections"
);

func main() -> int {
    var created = collections.buffer<u8>(4,0);
    match (created) {
        Err(error) => return 1;
        Ok(owner) => {
            var view = owner.view();
            *owner.getMut(0)=1;
            return view[0].(int);
        }
    }
}

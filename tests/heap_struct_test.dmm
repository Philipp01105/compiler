// Test heap management with custom struct types

struct Point {
    var x:int;
    var y:int;
}

struct Rectangle {
    var width:int;
    var height:int;
    var area:int;
}

struct Person {
    var age:int;
    var initial:char;
}

// Test 1: Basic struct allocation
func test1_basic_struct() -> void {
    println("[TEST 1] Basic struct allocation");
    
    var p:*Point = reserve(Point);
    println("  [OK] Point struct allocated");
    
    free(p);
    println("  [OK] Point struct freed");
}

// Test 2: Multiple struct allocations
func test2_multiple_structs() -> void {
    println("[TEST 2] Multiple struct allocations");
    
    var p1:*Point = reserve(Point);
    var p2:*Point = reserve(Point);
    var r:*Rectangle = reserve(Rectangle);
    
    println("  [OK] Three structs allocated");
    
    free(p1);
    free(p2);
    free(r);
    
    println("  [OK] Three structs freed");
}

// Test 3: GC with structs
func test3_gc_structs() -> void {
    println("[TEST 3] GC with structs");
    
    @gc
    var p:*Point = reserve(Point);
    
    @gc
    var r:*Rectangle = reserve(Rectangle);
    
    println("  [OK] GC structs allocated (auto-freed)");
}

// Test 4: Mixed struct types
func test4_mixed_struct_types() -> void {
    println("[TEST 4] Mixed struct types");
    
    var point:*Point = reserve(Point);
    var rect:*Rectangle = reserve(Rectangle);
    var person:*Person = reserve(Person);
    
    println("  [OK] Three different struct types allocated");
    
    free(person);
    free(rect);
    free(point);
    
    println("  [OK] All struct types freed");
}

// Test 5: Manual and GC structs together
func test5_manual_and_gc_structs() -> void {
    println("[TEST 5] Manual and GC structs");
    
    var manual:*Point = reserve(Point);
    
    @gc
    var automatic:*Rectangle = reserve(Rectangle);
    
    println("  [OK] Manual and GC structs allocated");
    
    free(manual);
    
    println("  [OK] Manual struct freed (GC auto-freed)");
}

// Test 6: Sequential struct operations
func test6_sequential_structs() -> void {
    println("[TEST 6] Sequential struct operations");
    
    var p:*Point = reserve(Point);
    println("  [OK] Point allocated");
    free(p);
    println("  [OK] Point freed");
    
    var r:*Rectangle = reserve(Rectangle);
    println("  [OK] Rectangle allocated");
    free(r);
    println("  [OK] Rectangle freed");
}

// Test 7: Many struct pointers
func test7_many_struct_pointers() -> void {
    println("[TEST 7] Many struct pointers");
    
    var p1:*Point = reserve(Point);
    var p2:*Point = reserve(Point);
    var p3:*Point = reserve(Point);
    var p4:*Point = reserve(Point);
    var p5:*Point = reserve(Point);
    
    println("  [OK] Five Point structs allocated");
    
    free(p1);
    free(p2);
    free(p3);
    free(p4);
    free(p5);
    
    println("  [OK] Five Point structs freed");
}

// Test 8: Struct with different sizes
func test8_different_sizes() -> void {
    println("[TEST 8] Structs with different sizes");
    
    // Point has 2 ints (8 bytes)
    var small:*Point = reserve(Point);
    
    // Rectangle has 3 ints (12 bytes)
    var medium:*Rectangle = reserve(Rectangle);
    
    // Person has int + char (5+ bytes with padding)
    var compact:*Person = reserve(Person);
    
    println("  [OK] Different sized structs allocated");
    
    free(small);
    free(medium);
    free(compact);
    
    println("  [OK] All different sized structs freed");
}

func main() -> void {
    println("============================================");
    println("  STRUCT HEAP MANAGEMENT TEST");
    println("============================================");
    println("");
    
    test1_basic_struct();
    test2_multiple_structs();
    test3_gc_structs();
    test4_mixed_struct_types();
    test5_manual_and_gc_structs();
    test6_sequential_structs();
    test7_many_struct_pointers();
    test8_different_sizes();
    
    println("");
    println("============================================");
    println("  ALL STRUCT TESTS PASSED!");
    println("============================================");
}
